<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AssestBundleTools.Presentation.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="1"
                Margin="16,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Image
                    x:Name="WindowTitleIcon"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/AppLogo.png"
                    Stretch="Uniform" />
                <TextBlock
                    x:Name="WindowTitleText"
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <ContentControl
            x:Name="WindowContentHost"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
