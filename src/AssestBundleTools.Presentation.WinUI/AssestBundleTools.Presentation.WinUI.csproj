<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AssestBundleTools.Presentation.WinUI</RootNamespace>
    <AssemblyName>AssestBundleTools.Presentation.WinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>true</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Assets\Monaco\**\*.*" />
    <PRIResource Remove="Assets\Monaco\**\*.*" />
    <None Remove="Assets\Monaco\**\*.*" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1721" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.WinUI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssestBundleTools.Application\AssestBundleTools.Application.csproj" />
    <!--
      受控例外：Presentation 对 Infrastructure 的直接项目引用只服务于 Composition 目录中的组合根/适配器。
      其余 View、ViewModel、普通 Service 不得直接引用 Infrastructure 命名空间或具体类型。
    -->
    <ProjectReference Include="..\AssestBundleTools.Infrastructure\AssestBundleTools.Infrastructure.csproj" />

  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Monaco 通过显式白名单复制，避免重新生成资源后把未用语言带入应用输出。 -->
    <MonacoEditorAsset Include="Assets\Monaco\abt-editor-host.html" />
    <MonacoEditorAsset Include="Assets\Monaco\abt-editor-host.js" />
    <MonacoEditorAsset Include="Assets\Monaco\LICENSE.monaco-editor.txt" />
    <MonacoEditorAsset Include="Assets\Monaco\ThirdPartyNotices.monaco-editor.txt" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\loader.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\editor.api-CalNCsUg.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\workers-DcJshg-q.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\lspLanguageFeatures-kM9O9rjY.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\monaco.contribution-DO3azKX8.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\monaco.contribution-qLAYrEOP.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\monaco.contribution-EcChJV6a.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\monaco.contribution-D2OdxNBt.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\jsonMode-DULH5oaX.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\cpp-CkKPQIni.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\ini-CsNwO04R.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\nls.messages-loader.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\nls.messages.js.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\nls.messages.zh-cn.js.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\editor\editor.main.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\editor\editor.main.css" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\assets\editor.worker-Be8ye1pW.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\assets\json.worker-DKiEKt88.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\basic-languages\monaco.contribution.js" />
  </ItemGroup>

  <Target Name="CopyMonacoEditorAssets" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)Assets\Monaco" Condition="Exists('$(OutDir)Assets\Monaco')" />
    <Copy
      SourceFiles="@(MonacoEditorAsset)"
      DestinationFiles="@(MonacoEditorAsset->'$(OutDir)%(Identity)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBuiltInAudioResourceProcessors" AfterTargets="Build">
    <MSBuild
      Projects="..\AssestBundleTools.Audio.FmodProcessor\AssestBundleTools.Audio.FmodProcessor.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);Platform=$(Platform)" />
    <ItemGroup>
      <BuiltInAudioResourceProcessor Include="..\AssestBundleTools.Audio.FmodProcessor\bin\$(Configuration)\net8.0\AssestBundleTools.Audio.FmodProcessor.*" />
      <BuiltInAudioResourceProcessor Include="..\AssestBundleTools.Audio.FmodProcessor\bin\$(Platform)\$(Configuration)\net8.0\AssestBundleTools.Audio.FmodProcessor.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(BuiltInAudioResourceProcessor)"
      DestinationFiles="@(BuiltInAudioResourceProcessor->'$(OutDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBuiltInAssetBundleCodecs" AfterTargets="Build">
    <MSBuild
      Projects="..\AssestBundleTools.BundleCodec.Arknights\AssestBundleTools.BundleCodec.Arknights.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);Platform=$(Platform)" />
    <ItemGroup>
      <BuiltInAssetBundleCodec Include="..\AssestBundleTools.BundleCodec.Arknights\bin\$(Configuration)\net8.0\AssestBundleTools.BundleCodec.Arknights.*" />
      <BuiltInAssetBundleCodec Include="..\AssestBundleTools.BundleCodec.Arknights\bin\$(Platform)\$(Configuration)\net8.0\AssestBundleTools.BundleCodec.Arknights.*" />
      <BuiltInAssetBundleCodec Include="..\AssestBundleTools.BundleCodec.Arknights\bin\$(Configuration)\net8.0\K4os.Compression.LZ4.dll" />
      <BuiltInAssetBundleCodec Include="..\AssestBundleTools.BundleCodec.Arknights\bin\$(Platform)\$(Configuration)\net8.0\K4os.Compression.LZ4.dll" />
    </ItemGroup>
    <Copy
      SourceFiles="@(BuiltInAssetBundleCodec)"
      DestinationFiles="@(BuiltInAssetBundleCodec->'$(OutDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
