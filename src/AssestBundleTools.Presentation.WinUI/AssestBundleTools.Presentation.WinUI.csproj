<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AssestBundleTools.Presentation.WinUI</RootNamespace>
    <AssemblyName>AssestBundleTools.Presentation.WinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <!-- Windows App SDK 已使用 Hybrid CRT，不再依赖旧的 UniversalCRT.Debug Extension SDK。 -->
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Assets\Monaco\**\*.*" />
    <PRIResource Remove="Assets\Monaco\**\*.*" />
    <None Remove="Assets\Monaco\**\*.*" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-16_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-32_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-256_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\AppLogo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Microsoft Fluent System Icons, upstream commit 32374ae9ccf107e026db0d9aa9c0d631328b8003. -->
    <Content Include="Assets\Fonts\FluentSystemIcons-Resizable.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\FluentSystemIcons-Resizable.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\FluentSystemIcons-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1721" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.WinUI" Version="3.8.3" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssestBundleTools.Application\AssestBundleTools.Application.csproj" />
    <!--
      受控例外：Presentation 对 Infrastructure 的直接项目引用只服务于 Composition 目录中的组合根/适配器。
      其余 View、ViewModel、普通 Service 不得直接引用 Infrastructure 命名空间或具体类型。
    -->
    <ProjectReference Include="..\AssestBundleTools.Infrastructure\AssestBundleTools.Infrastructure.csproj" />

  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- 主应用仍依赖反射式 JSON 与 COM 激活；迁移到源生成上下文前不可启用裁剪。 -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Monaco 通过显式白名单复制，避免重新生成资源后把未用语言带入应用输出。 -->
    <MonacoEditorAsset Include="Assets\Monaco\abt-editor-host.html" />
    <MonacoEditorAsset Include="Assets\Monaco\abt-editor-host.js" />
    <MonacoEditorAsset Include="Assets\Monaco\LICENSE.monaco-editor.txt" />
    <MonacoEditorAsset Include="Assets\Monaco\ThirdPartyNotices.monaco-editor.txt" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\loader.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\editor.api-CalNCsUg.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\workers-DcJshg-q.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\lspLanguageFeatures-kM9O9rjY.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\monaco.contribution-DO3azKX8.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\monaco.contribution-qLAYrEOP.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\monaco.contribution-EcChJV6a.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\monaco.contribution-D2OdxNBt.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\jsonMode-DULH5oaX.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\cpp-CkKPQIni.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\ini-CsNwO04R.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\nls.messages-loader.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\nls.messages.js.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\nls.messages.zh-cn.js.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\editor\editor.main.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\editor\editor.main.css" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\assets\editor.worker-Be8ye1pW.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\assets\json.worker-DKiEKt88.js" />
    <MonacoEditorAsset Include="Assets\Monaco\vs\basic-languages\monaco.contribution.js" />
  </ItemGroup>

  <Target Name="CopyMonacoEditorAssets" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)Assets\Monaco" Condition="Exists('$(OutDir)Assets\Monaco')" />
    <Copy
      SourceFiles="@(MonacoEditorAsset)"
      DestinationFiles="@(MonacoEditorAsset->'$(OutDir)%(Identity)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBuiltInAudioResourceProcessors" AfterTargets="Build">
    <MSBuild
      Projects="..\AssestBundleTools.Audio.FmodProcessor\AssestBundleTools.Audio.FmodProcessor.csproj"
      Targets="Build"
      RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed;PublishReadyToRun"
      Properties="Configuration=$(Configuration);Platform=$(Platform)" />
    <ItemGroup>
      <BuiltInAudioResourceProcessor Include="..\AssestBundleTools.Audio.FmodProcessor\bin\$(Configuration)\net8.0\AssestBundleTools.Audio.FmodProcessor.*" />
      <BuiltInAudioResourceProcessor Include="..\AssestBundleTools.Audio.FmodProcessor\bin\$(Platform)\$(Configuration)\net8.0\AssestBundleTools.Audio.FmodProcessor.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(BuiltInAudioResourceProcessor)"
      DestinationFiles="@(BuiltInAudioResourceProcessor->'$(OutDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBuiltInAssetBundleCodecs" AfterTargets="Build">
    <PropertyGroup>
      <BuiltInAssetBundleCodecRuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</BuiltInAssetBundleCodecRuntimeIdentifier>
      <BuiltInAssetBundleCodecRuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</BuiltInAssetBundleCodecRuntimeIdentifier>
      <BuiltInAssetBundleCodecRuntimeIdentifier Condition="'$(BuiltInAssetBundleCodecRuntimeIdentifier)' == ''">win-x64</BuiltInAssetBundleCodecRuntimeIdentifier>
      <BuiltInAssetBundleCodecPublishDirectory>$([System.IO.Path]::GetFullPath('$(OutDir)codecs\arknights\'))</BuiltInAssetBundleCodecPublishDirectory>
      <BuiltInAssetBundleCodecBuildRoot>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)built-in-codecs\arknights\$(Configuration)\$(BuiltInAssetBundleCodecRuntimeIdentifier)\'))</BuiltInAssetBundleCodecBuildRoot>
      <BuiltInAssetBundleCodecIntermediatePath>$(BuiltInAssetBundleCodecBuildRoot)obj\</BuiltInAssetBundleCodecIntermediatePath>
      <BuiltInAssetBundleCodecOutputPath>$(BuiltInAssetBundleCodecBuildRoot)bin\</BuiltInAssetBundleCodecOutputPath>
      <BuiltInAssetBundleCodecBuildProperties>Configuration=$(Configuration);RuntimeIdentifier=$(BuiltInAssetBundleCodecRuntimeIdentifier);SelfContained=true;PublishSingleFile=true;BaseIntermediateOutputPath=$(BuiltInAssetBundleCodecIntermediatePath);MSBuildProjectExtensionsPath=$(BuiltInAssetBundleCodecIntermediatePath);BaseOutputPath=$(BuiltInAssetBundleCodecOutputPath)</BuiltInAssetBundleCodecBuildProperties>
      <BuiltInCrossCoreCodecPublishDirectory>$([System.IO.Path]::GetFullPath('$(OutDir)codecs\crosscore\'))</BuiltInCrossCoreCodecPublishDirectory>
      <BuiltInCrossCoreCodecBuildRoot>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)built-in-codecs\crosscore\$(Configuration)\$(BuiltInAssetBundleCodecRuntimeIdentifier)\'))</BuiltInCrossCoreCodecBuildRoot>
      <BuiltInCrossCoreCodecIntermediatePath>$(BuiltInCrossCoreCodecBuildRoot)obj\</BuiltInCrossCoreCodecIntermediatePath>
      <BuiltInCrossCoreCodecOutputPath>$(BuiltInCrossCoreCodecBuildRoot)bin\</BuiltInCrossCoreCodecOutputPath>
      <BuiltInCrossCoreCodecBuildProperties>Configuration=$(Configuration);RuntimeIdentifier=$(BuiltInAssetBundleCodecRuntimeIdentifier);SelfContained=true;PublishSingleFile=true;BaseIntermediateOutputPath=$(BuiltInCrossCoreCodecIntermediatePath);MSBuildProjectExtensionsPath=$(BuiltInCrossCoreCodecIntermediatePath);BaseOutputPath=$(BuiltInCrossCoreCodecOutputPath)</BuiltInCrossCoreCodecBuildProperties>
    </PropertyGroup>
    <ItemGroup>
      <LegacyBuiltInAssetBundleCodec Include="$(OutDir)AssestBundleTools.BundleCodec.Arknights.*" />
      <LegacyBuiltInAssetBundleCodec Include="$(OutDir)AssestBundleTools.BundleCodec.CrossCore.*" />
      <LegacyBuiltInAssetBundleCodec Include="$(OutDir)K4os.Compression.LZ4.dll" />
    </ItemGroup>
    <Delete Files="@(LegacyBuiltInAssetBundleCodec)" />
    <RemoveDir Directories="$(BuiltInAssetBundleCodecPublishDirectory)" />
    <RemoveDir Directories="$(BuiltInCrossCoreCodecPublishDirectory)" />
    <MSBuild
      Projects="..\AssestBundleTools.BundleCodec.Arknights\AssestBundleTools.BundleCodec.Arknights.csproj"
      Targets="Restore"
      Condition="!Exists('$(BuiltInAssetBundleCodecIntermediatePath)project.assets.json')"
      Properties="$(BuiltInAssetBundleCodecBuildProperties)" />
    <MSBuild
      Projects="..\AssestBundleTools.BundleCodec.Arknights\AssestBundleTools.BundleCodec.Arknights.csproj"
      Targets="Publish"
      Properties="$(BuiltInAssetBundleCodecBuildProperties);DebugType=None;PublishDir=$(BuiltInAssetBundleCodecPublishDirectory)" />
    <Error
      Condition="!Exists('$(BuiltInAssetBundleCodecPublishDirectory)AssestBundleTools.BundleCodec.Arknights.exe')"
      Text="Built-in Arknights bundle codec publish output is missing." />
    <MSBuild
      Projects="..\AssestBundleTools.BundleCodec.CrossCore\AssestBundleTools.BundleCodec.CrossCore.csproj"
      Targets="Restore"
      Condition="!Exists('$(BuiltInCrossCoreCodecIntermediatePath)project.assets.json')"
      Properties="$(BuiltInCrossCoreCodecBuildProperties)" />
    <MSBuild
      Projects="..\AssestBundleTools.BundleCodec.CrossCore\AssestBundleTools.BundleCodec.CrossCore.csproj"
      Targets="Publish"
      Properties="$(BuiltInCrossCoreCodecBuildProperties);DebugType=None;PublishDir=$(BuiltInCrossCoreCodecPublishDirectory)" />
    <Error
      Condition="!Exists('$(BuiltInCrossCoreCodecPublishDirectory)AssestBundleTools.BundleCodec.CrossCore.exe')"
      Text="Built-in CrossCore bundle codec publish output is missing." />
  </Target>

  <Target Name="CopyBuiltInExtensionsToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <BuiltInAudioResourceProcessorPublishFile Include="$(OutDir)AssestBundleTools.Audio.FmodProcessor.*" />
      <BuiltInAssetBundleCodecPublishFile Include="$(OutDir)codecs\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(BuiltInAudioResourceProcessorPublishFile)"
      DestinationFiles="@(BuiltInAudioResourceProcessorPublishFile->'$(PublishDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(BuiltInAssetBundleCodecPublishFile)"
      DestinationFiles="@(BuiltInAssetBundleCodecPublishFile->'$(PublishDir)codecs\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target
    Name="AddBuiltInExtensionsToAppxPackage"
    BeforeTargets="_ComputeAppxPackagePayload"
    DependsOnTargets="CopyBuiltInAudioResourceProcessors;CopyBuiltInAssetBundleCodecs">
    <ItemGroup>
      <BuiltInAudioResourceProcessorAppxFile Include="$(OutDir)AssestBundleTools.Audio.FmodProcessor.*" />
      <BuiltInAssetBundleCodecAppxFile Include="$(OutDir)codecs\**\*.*" />
    </ItemGroup>
    <ItemGroup>
      <BuiltInAudioResourceProcessorAppxFile Update="@(BuiltInAudioResourceProcessorAppxFile)">
        <TargetPath>%(Filename)%(Extension)</TargetPath>
      </BuiltInAudioResourceProcessorAppxFile>
      <BuiltInAssetBundleCodecAppxFile Update="@(BuiltInAssetBundleCodecAppxFile)">
        <TargetPath>codecs\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      </BuiltInAssetBundleCodecAppxFile>
      <AppxPackagePayload Include="@(BuiltInAudioResourceProcessorAppxFile);@(BuiltInAssetBundleCodecAppxFile)" />
    </ItemGroup>
  </Target>
</Project>
