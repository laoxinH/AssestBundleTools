<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AssestBundleTools.Presentation.WinUI.Views.PluginManagement.PluginManagementPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.PluginManagement"
    Background="Transparent"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Page.Resources>
        <ThemeShadow x:Key="PluginManagementCardShadow" />
        <Style
            x:Key="PluginManagementCardStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Shadow" Value="{StaticResource PluginManagementCardShadow}" />
        </Style>
        <Style
            x:Key="PluginManagementToolbarSurfaceStyle"
            TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style
            x:Key="PluginManagementSecondaryTextStyle"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style
            x:Key="PluginManagementCompactButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource WorkspaceInlineActionButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style
            x:Key="PluginManagementSummaryBadgeStyle"
            TargetType="Border">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style
            x:Key="PluginManagementInlineDividerStyle"
            TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="PluginManagementIconBadgeStyle"
            TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style
            x:Key="PluginManagementEmptyTitleTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style
            x:Key="PluginManagementEmptyBodyTextStyle"
            BasedOn="{StaticResource PluginManagementSecondaryTextStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="320" />
        </Style>
        <Style
            x:Key="PluginManagementDetailLabelTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style
            x:Key="PluginManagementDetailValueTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <DataTemplate
            x:Key="PluginManagementPluginItemTemplate"
            x:DataType="viewModels:PluginManagementPluginItemViewModel">
            <Border
                Margin="0,0,0,6"
                Padding="10"
                Background="Transparent"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="8">
                <Grid
                    MinHeight="72"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PluginManagementIconBadgeStyle}">
                        <SymbolIcon
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Symbol="Library" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        MinWidth="0"
                        Spacing="4">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{x:Bind DisplayName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12.5"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ResourceKindText}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind Id}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        MinWidth="72"
                        HorizontalAlignment="Right"
                        Spacing="5">
                        <Border
                            Padding="8,3"
                            Style="{StaticResource ExplorerTreeBadgeStyle}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind PrimaryBadgeText}" />
                        </Border>
                        <Border
                            Padding="8,3"
                            Style="{StaticResource ExplorerTreeBadgeStyle}"
                            Visibility="{x:Bind SecondaryBadgeVisibility}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind SecondaryBadgeText}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <Style
            x:Key="PluginManagementListViewItemStyle"
            TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Page.Resources>

    <Grid
        Padding="24,20,14,24"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock
                x:Name="PageEyebrowText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                x:Name="PageTitleText"
                Style="{StaticResource WorkspacePageTitleTextStyle}" />
            <TextBlock
                x:Name="PageSubtitleText"
                MaxWidth="980"
                HorizontalAlignment="Left"
                Style="{StaticResource PluginManagementSecondaryTextStyle}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Style="{StaticResource PluginManagementToolbarSurfaceStyle}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchTextBox"
                    MinWidth="260"
                    Height="38"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    Grid.Column="1"
                    Height="38"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.TypeFilters, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedTypeFilter, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName" />
                <ComboBox
                    Grid.Column="2"
                    Height="38"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.StatusFilters, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedStatusFilter, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName" />
                <Button
                    Grid.Column="3"
                    Height="38"
                    Style="{StaticResource PluginManagementCompactButtonStyle}"
                    Click="OnRefreshCatalogButtonClick">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE72C;" />
                        <TextBlock
                            x:Name="RefreshCatalogButtonText"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid
            x:Name="MainContentGrid"
            Grid.Row="2"
            MinHeight="0"
            ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" MinWidth="360" MaxWidth="560" />
                <ColumnDefinition Width="1.6*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border
                Style="{StaticResource PluginManagementCardStyle}"
                Translation="0,0,8">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="PluginDirectoryTitleText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="PluginDirectoryHintText"
                                Style="{StaticResource PluginManagementSecondaryTextStyle}" />
                            <Border Style="{StaticResource PluginManagementSummaryBadgeStyle}">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.VisiblePluginSummaryText, Mode=OneWay}" />
                            </Border>
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Style="{StaticResource PluginManagementCompactButtonStyle}"
                            Click="OnAddDecryptorButtonClick">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE710;" />
                                <TextBlock
                                    x:Name="AddDecryptorButtonText"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Style="{StaticResource PluginManagementCompactButtonStyle}"
                            Click="OnAddResourceProcessorButtonClick">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE710;" />
                                <TextBlock
                                    x:Name="AddResourceProcessorButtonText"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Padding="16,22"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                        <Border
                            HorizontalAlignment="Center"
                            Style="{StaticResource PluginManagementIconBadgeStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="19"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE721;" />
                        </Border>
                        <TextBlock
                            x:Name="PluginDirectoryEmptyTitleText"
                            Style="{StaticResource PluginManagementEmptyTitleTextStyle}" />
                        <TextBlock
                            x:Name="PluginDirectoryEmptyText"
                            Style="{StaticResource PluginManagementEmptyBodyTextStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <StackPanel
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.DecryptorGroupVisibility, Mode=OneWay}">
                                <TextBlock
                                    x:Name="DecryptorGroupTitleText"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView
                                    ItemsSource="{x:Bind ViewModel.VisibleDecryptorPlugins, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedPlugin, Mode=OneWay}"
                                    SelectionChanged="OnPluginListSelectionChanged"
                                    ItemContainerStyle="{StaticResource PluginManagementListViewItemStyle}"
                                    ItemTemplate="{StaticResource PluginManagementPluginItemTemplate}"
                                    SelectionMode="Single" />
                            </StackPanel>

                            <StackPanel
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.ResourceProcessorGroupVisibility, Mode=OneWay}">
                                <TextBlock
                                    x:Name="ResourceProcessorGroupTitleText"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView
                                    ItemsSource="{x:Bind ViewModel.VisibleResourceProcessorPlugins, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedPlugin, Mode=OneWay}"
                                    SelectionChanged="OnPluginListSelectionChanged"
                                    ItemContainerStyle="{StaticResource PluginManagementListViewItemStyle}"
                                    ItemTemplate="{StaticResource PluginManagementPluginItemTemplate}"
                                    SelectionMode="Single" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Style="{StaticResource PluginManagementCardStyle}"
                Translation="0,0,8">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.RowSpan="4"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.DetailsEmptyVisibility, Mode=OneWay}">
                        <Border
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Style="{StaticResource PluginManagementIconBadgeStyle}">
                            <SymbolIcon
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Symbol="Library" />
                        </Border>
                        <TextBlock
                            x:Name="PluginDetailsEmptyTitleText"
                            Style="{StaticResource PluginManagementEmptyTitleTextStyle}" />
                        <TextBlock
                            x:Name="PluginDetailsEmptyText"
                            Style="{StaticResource PluginManagementEmptyBodyTextStyle}" />
                    </StackPanel>

                    <Grid
                        ColumnSpacing="14"
                        Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="52"
                            Height="52"
                            Style="{StaticResource PluginManagementIconBadgeStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="23"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="{x:Bind ViewModel.SelectedPluginIconGlyph, Mode=OneWay}" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            MinWidth="0"
                            Spacing="6">
                            <TextBlock
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedPlugin.DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource PluginManagementSecondaryTextStyle}"
                                Text="{Binding SelectedPlugin.Description}"
                                Visibility="{Binding SelectedPlugin.DescriptionVisibility}" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SelectedPlugin.TypeText}" />
                                <Border Style="{StaticResource PluginManagementInlineDividerStyle}" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SelectedPlugin.ResourceKindText}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Spacing="6">
                            <Border
                                Padding="9,4"
                                Style="{StaticResource ExplorerTreeBadgeStyle}">
                                <TextBlock
                                    FontSize="12"
                                    Text="{Binding SelectedPlugin.PrimaryBadgeText}" />
                            </Border>
                            <Border
                                Padding="9,4"
                                Style="{StaticResource ExplorerTreeBadgeStyle}"
                                Visibility="{Binding SelectedPlugin.SecondaryBadgeVisibility}">
                                <TextBlock
                                    FontSize="12"
                                    Text="{Binding SelectedPlugin.SecondaryBadgeText}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}">
                        <Button
                            Style="{StaticResource PluginManagementCompactButtonStyle}"
                            Click="OnEditSelectedPluginButtonClick"
                            IsEnabled="{x:Bind ViewModel.CanEditSelectedPlugin, Mode=OneWay}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE70F;" />
                                <TextBlock
                                    x:Name="EditSelectedPluginButtonText"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Style="{StaticResource PluginManagementCompactButtonStyle}"
                            Click="OnValidateSelectedPluginButtonClick">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE73E;" />
                                <TextBlock
                                    x:Name="ValidateSelectedPluginButtonText"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Style="{StaticResource PluginManagementCompactButtonStyle}"
                            Click="OnCopyDiagnosticsButtonClick">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE8C8;" />
                                <TextBlock
                                    x:Name="CopyDiagnosticsButtonText"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Style="{StaticResource PluginManagementCompactButtonStyle}"
                            Click="OnOpenPluginLocationButtonClick"
                            IsEnabled="{x:Bind ViewModel.CanOpenSelectedPluginLocation, Mode=OneWay}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE8B7;" />
                                <TextBlock
                                    x:Name="OpenPluginLocationButtonText"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Style="{StaticResource PluginManagementCompactButtonStyle}"
                            Click="OnDeleteSelectedPluginButtonClick"
                            IsEnabled="{x:Bind ViewModel.CanDeleteSelectedPlugin, Mode=OneWay}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE74D;" />
                                <TextBlock
                                    x:Name="DeleteSelectedPluginButtonText"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}">
                        <ItemsControl ItemsSource="{Binding SelectedPlugin.DetailItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:PluginManagementDetailItemViewModel">
                                    <Border
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid
                                            Padding="0,9"
                                            ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Style="{StaticResource PluginManagementDetailLabelTextStyle}"
                                                Text="{x:Bind Label}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource PluginManagementDetailValueTextStyle}"
                                                Text="{x:Bind Value}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border
                        Grid.Row="3"
                        Padding="14"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="36"
                                Height="36"
                                Style="{StaticResource PluginManagementIconBadgeStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="17"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE946;" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="5">
                                <TextBlock
                                    x:Name="DiagnosticSectionTitleText"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.SelectedDiagnosticText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
