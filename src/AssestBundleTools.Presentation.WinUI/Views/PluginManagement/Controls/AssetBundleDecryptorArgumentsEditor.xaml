<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.PluginManagement.Controls.AssetBundleDecryptorArgumentsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="SecondaryTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="RowIconStyle"
            TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel>
            <Grid
                Padding="16"
                ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource RowIconStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="15"
                        Glyph="&#xE6E9;" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Spacing="2">
                    <TextBlock
                        x:Name="ProbeArgumentsLabelText"
                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                    <TextBlock
                        x:Name="ProbeArgumentsDescriptionText"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>

                <TextBox
                    x:Name="ProbeArgumentsTextBox"
                    Grid.Column="2"
                    AcceptsReturn="True"
                    MinHeight="88"
                    TextWrapping="Wrap" />
            </Grid>

            <Border
                Height="1"
                Margin="64,0,0,0"
                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <Grid
                Padding="16"
                ColumnSpacing="14"
                RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource RowIconStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="15"
                        Glyph="&#xE6E9;" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Spacing="2">
                    <TextBlock
                        x:Name="DecryptArgumentsLabelText"
                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                    <TextBlock
                        x:Name="DecryptArgumentsDescriptionText"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Spacing="6">
                    <TextBox
                        x:Name="DecryptArgumentsTextBox"
                        AcceptsReturn="True"
                        MinHeight="112"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="DecryptArgumentsValidationTextBlock"
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="WrapWholeWords"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <Border
                Height="1"
                Margin="64,0,0,0"
                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <Grid
                Padding="16"
                ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource RowIconStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="15"
                        Glyph="&#xEBAC;" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Spacing="2">
                    <TextBlock
                        x:Name="EncryptArgumentsLabelText"
                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                    <TextBlock
                        x:Name="EncryptArgumentsDescriptionText"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>

                <TextBox
                    x:Name="EncryptArgumentsTextBox"
                    Grid.Column="2"
                    AcceptsReturn="True"
                    MinHeight="88"
                    TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
