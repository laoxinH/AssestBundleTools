<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.PluginManagement.Controls.ResourceProcessorEditorDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    MaxWidth="560"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="ResourceProcessorEditorValidationTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style
            x:Key="PluginEditorSecondaryTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="PluginEditorCardStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style
            x:Key="PluginEditorRowIconStyle"
            TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style
            x:Key="PluginEditorSingleLineTextBoxStyle"
            TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style
            x:Key="PluginEditorStepIndicatorStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="BasicStepIndicatorBorder"
                Style="{StaticResource PluginEditorStepIndicatorStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        x:Name="BasicStepNumberText"
                        FontWeight="SemiBold"
                        Text="1" />
                    <TextBlock
                        x:Name="BasicStepTitleText"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border
                x:Name="ExecutionStepIndicatorBorder"
                Grid.Column="1"
                Style="{StaticResource PluginEditorStepIndicatorStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        x:Name="ExecutionStepNumberText"
                        FontWeight="SemiBold"
                        Text="2" />
                    <TextBlock
                        x:Name="ExecutionStepTitleText"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border
                x:Name="ArgumentsStepIndicatorBorder"
                Grid.Column="2"
                Style="{StaticResource PluginEditorStepIndicatorStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        x:Name="ArgumentsStepNumberText"
                        FontWeight="SemiBold"
                        Text="3" />
                    <TextBlock
                        x:Name="ArgumentsStepTitleText"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer
            x:Name="FormScrollViewer"
            MaxHeight="520"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel
                    x:Name="BasicStepPanel"
                    Spacing="12">
            <Border Style="{StaticResource PluginEditorCardStyle}">
                <StackPanel>
                    <Grid
                        Padding="16"
                        ColumnSpacing="14"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Glyph="&#xE8AC;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="ProcessorIdLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="ProcessorIdDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Spacing="6">
                            <TextBox
                                x:Name="ProcessorIdTextBox"
                                Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                            <TextBlock
                                x:Name="ProcessorIdValidationTextBlock"
                                Style="{StaticResource ResourceProcessorEditorValidationTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Glyph="&#xE946;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="ProcessorDisplayNameLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="ProcessorDisplayNameDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Spacing="6">
                            <TextBox
                                x:Name="ProcessorDisplayNameTextBox"
                                Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                            <TextBlock
                                x:Name="ProcessorDisplayNameValidationTextBlock"
                                Style="{StaticResource ResourceProcessorEditorValidationTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Glyph="&#xE787;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="ProcessorVersionLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="ProcessorVersionDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <TextBox
                            x:Name="ProcessorVersionTextBox"
                            Grid.Column="2"
                            Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Glyph="&#xE916;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="ProcessorTimeoutLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="ProcessorTimeoutDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Spacing="6">
                            <TextBox
                                x:Name="ProcessorTimeoutTextBox"
                                InputScope="Number"
                                Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                            <TextBlock
                                x:Name="ProcessorTimeoutValidationTextBlock"
                                Style="{StaticResource ResourceProcessorEditorValidationTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Glyph="&#xE70B;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="ProcessorDescriptionLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="ProcessorDescriptionHintText"
                                MaxLines="2"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <TextBox
                            x:Name="ProcessorDescriptionTextBox"
                            Grid.Column="2"
                            AcceptsReturn="True"
                            MinHeight="72"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
                </StackPanel>

                <StackPanel
                    x:Name="ExecutionStepPanel"
                    Spacing="12"
                    Visibility="Collapsed">
            <Border Style="{StaticResource PluginEditorCardStyle}">
                <StackPanel>
                    <Grid
                        Padding="16"
                        ColumnSpacing="14"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Glyph="&#xE8A5;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="ProcessorResourceKindsLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="ProcessorResourceKindsDescriptionText"
                                MaxLines="2"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Spacing="6">
                            <Grid ColumnSpacing="10" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <CheckBox x:Name="Texture2DCheckBox" />
                                <CheckBox
                                    x:Name="AudioCheckBox"
                                    Grid.Column="1" />
                                <CheckBox
                                    x:Name="AtlasCheckBox"
                                    Grid.Row="1" />
                                <CheckBox
                                    x:Name="SkelCheckBox"
                                    Grid.Row="1"
                                    Grid.Column="1" />
                            </Grid>
                            <TextBlock
                                x:Name="ProcessorResourceKindsValidationTextBlock"
                                Style="{StaticResource ResourceProcessorEditorValidationTextStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
                </StackPanel>

                <StackPanel
                    x:Name="ArgumentsStepPanel"
                    Spacing="12"
                    Visibility="Collapsed">
            <Border Style="{StaticResource PluginEditorCardStyle}">
                <StackPanel>
                    <Grid
                        Padding="16"
                        ColumnSpacing="14"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Glyph="&#xE756;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="ProcessorExecutablePathLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="ProcessorExecutablePathDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Spacing="6">
                            <TextBox
                                x:Name="ProcessorExecutablePathTextBox"
                                Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                            <TextBlock
                                x:Name="ProcessorExecutablePathValidationTextBlock"
                                Style="{StaticResource ResourceProcessorEditorValidationTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Glyph="&#xE838;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="ProcessorWorkingDirectoryPathLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="ProcessorWorkingDirectoryPathDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <TextBox
                            x:Name="ProcessorWorkingDirectoryPathTextBox"
                            Grid.Column="2"
                            Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PluginEditorCardStyle}">
                <StackPanel>
                    <Grid
                        Padding="16"
                        ColumnSpacing="14"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Glyph="&#xE7C3;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="ProcessorArgumentsLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="ProcessorArgumentsDescriptionText"
                                MaxLines="2"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Spacing="6">
                            <TextBox
                                x:Name="ProcessorArgumentsTextBox"
                                AcceptsReturn="True"
                                MinHeight="140"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ProcessorArgumentsValidationTextBlock"
                                Style="{StaticResource ResourceProcessorEditorValidationTextStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</UserControl>
