<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.PluginManagement.Controls.AssetBundleDecryptorEditorDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AssestBundleTools.Presentation.WinUI.Views.PluginManagement.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    MaxWidth="560"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="DecryptorEditorValidationTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style
            x:Key="PluginEditorSecondaryTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="PluginEditorCardStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style
            x:Key="PluginEditorRowIconStyle"
            TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style
            x:Key="PluginEditorSingleLineTextBoxStyle"
            TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style
            x:Key="PluginEditorStepIndicatorStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="BasicStepIndicatorBorder"
                Style="{StaticResource PluginEditorStepIndicatorStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        x:Name="BasicStepNumberText"
                        FontWeight="SemiBold"
                        Text="1" />
                    <TextBlock
                        x:Name="BasicStepTitleText"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border
                x:Name="ExecutionStepIndicatorBorder"
                Grid.Column="1"
                Style="{StaticResource PluginEditorStepIndicatorStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        x:Name="ExecutionStepNumberText"
                        FontWeight="SemiBold"
                        Text="2" />
                    <TextBlock
                        x:Name="ExecutionStepTitleText"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border
                x:Name="ArgumentsStepIndicatorBorder"
                Grid.Column="2"
                Style="{StaticResource PluginEditorStepIndicatorStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        x:Name="ArgumentsStepNumberText"
                        FontWeight="SemiBold"
                        Text="3" />
                    <TextBlock
                        x:Name="ArgumentsStepTitleText"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer
            x:Name="FormScrollViewer"
            MaxHeight="520"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel
                    x:Name="BasicStepPanel"
                    Spacing="12">
            <Border Style="{StaticResource PluginEditorCardStyle}">
                <StackPanel>
                    <Grid
                        Padding="16"
                        ColumnSpacing="14"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppIconFontFamily}"
                                FontSize="15"
                                Glyph="&#xEF5D;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="DecryptorIdLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="DecryptorIdDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Spacing="6">
                            <TextBox
                                x:Name="DecryptorIdTextBox"
                                Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                            <TextBlock
                                x:Name="DecryptorIdValidationTextBlock"
                                Style="{StaticResource DecryptorEditorValidationTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppIconFontFamily}"
                                FontSize="15"
                                Glyph="&#xEA88;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="DecryptorDisplayNameLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="DecryptorDisplayNameDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Spacing="6">
                            <TextBox
                                x:Name="DecryptorDisplayNameTextBox"
                                Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                            <TextBlock
                                x:Name="DecryptorDisplayNameValidationTextBlock"
                                Style="{StaticResource DecryptorEditorValidationTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppIconFontFamily}"
                                FontSize="15"
                                Glyph="&#xE32E;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="DecryptorVersionLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="DecryptorVersionDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <TextBox
                            x:Name="DecryptorVersionTextBox"
                            Grid.Column="2"
                            Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppIconFontFamily}"
                                FontSize="15"
                                Glyph="&#xF47F;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="DecryptorTimeoutLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="DecryptorTimeoutDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Spacing="6">
                            <TextBox
                                x:Name="DecryptorTimeoutTextBox"
                                InputScope="Number"
                                Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                            <TextBlock
                                x:Name="DecryptorTimeoutValidationTextBlock"
                                Style="{StaticResource DecryptorEditorValidationTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppIconFontFamily}"
                                FontSize="15"
                                Glyph="&#xECB0;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="DecryptorDescriptionLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="DecryptorDescriptionHintText"
                                MaxLines="2"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <TextBox
                            x:Name="DecryptorDescriptionTextBox"
                            Grid.Column="2"
                            AcceptsReturn="True"
                            MinHeight="72"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
                </StackPanel>

                <StackPanel
                    x:Name="ExecutionStepPanel"
                    Spacing="12"
                    Visibility="Collapsed">
            <Border Style="{StaticResource PluginEditorCardStyle}">
                <StackPanel>
                    <Grid
                        Padding="16"
                        ColumnSpacing="14"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppIconFontFamily}"
                                FontSize="15"
                                Glyph="&#xF5CD;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="DecryptorExecutablePathLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="DecryptorExecutablePathDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Spacing="6">
                            <TextBox
                                x:Name="DecryptorExecutablePathTextBox"
                                Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                            <TextBlock
                                x:Name="DecryptorExecutablePathValidationTextBlock"
                                Style="{StaticResource DecryptorEditorValidationTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppIconFontFamily}"
                                FontSize="15"
                                Glyph="&#xE90B;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="DecryptorWorkingDirectoryPathLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="DecryptorWorkingDirectoryPathDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <TextBox
                            x:Name="DecryptorWorkingDirectoryPathTextBox"
                            Grid.Column="2"
                            Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppIconFontFamily}"
                                FontSize="15"
                                Glyph="&#xEFB1;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="SupportsAutoDetectionLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="SupportsAutoDetectionDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <CheckBox
                            x:Name="SupportsAutoDetectionCheckBox"
                            Grid.Column="2"
                            VerticalAlignment="Center" />
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PluginEditorRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppIconFontFamily}"
                                FontSize="15"
                                Glyph="&#xEAA7;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="IsFallbackLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="IsFallbackDescriptionText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                        </StackPanel>

                        <CheckBox
                            x:Name="IsFallbackCheckBox"
                            Grid.Column="2"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
                </StackPanel>

                <StackPanel
                    x:Name="ArgumentsStepPanel"
                    Spacing="12"
                    Visibility="Collapsed">
                    <local:AssetBundleDecryptorArgumentsEditor x:Name="ArgumentsEditor" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</UserControl>
