<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.PluginManagement.Controls.PostExportPluginEditorDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    MaxWidth="560"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="PostExportPluginEditorValidationTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style
            x:Key="PluginEditorSecondaryTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="PluginEditorCardStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style
            x:Key="PluginEditorRowIconStyle"
            TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style
            x:Key="PluginEditorSingleLineTextBoxStyle"
            TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style
            x:Key="PluginEditorStepIndicatorStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="BasicStepIndicatorBorder"
                Style="{StaticResource PluginEditorStepIndicatorStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        x:Name="BasicStepNumberText"
                        FontWeight="SemiBold"
                        Text="1" />
                    <TextBlock
                        x:Name="BasicStepTitleText"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border
                x:Name="ExecutionStepIndicatorBorder"
                Grid.Column="1"
                Style="{StaticResource PluginEditorStepIndicatorStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        x:Name="ExecutionStepNumberText"
                        FontWeight="SemiBold"
                        Text="2" />
                    <TextBlock
                        x:Name="ExecutionStepTitleText"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border
                x:Name="ArgumentsStepIndicatorBorder"
                Grid.Column="2"
                Style="{StaticResource PluginEditorStepIndicatorStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        x:Name="ArgumentsStepNumberText"
                        FontWeight="SemiBold"
                        Text="3" />
                    <TextBlock
                        x:Name="ArgumentsStepTitleText"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer
            x:Name="FormScrollViewer"
            MaxHeight="520"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel
                    x:Name="BasicStepPanel"
                    Spacing="12">
                    <Border Style="{StaticResource PluginEditorCardStyle}">
                        <StackPanel>
                            <Grid
                                Padding="16"
                                ColumnSpacing="14"
                                RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PluginEditorRowIconStyle}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource AppIconFontFamily}"
                                        FontSize="15"
                                        Glyph="&#xEF5D;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="2">
                                    <TextBlock
                                        x:Name="IdLabelText"
                                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="IdDescriptionText"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Spacing="6">
                                    <TextBox
                                        x:Name="IdTextBox"
                                        Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                                    <TextBlock
                                        x:Name="IdValidationTextBlock"
                                        Style="{StaticResource PostExportPluginEditorValidationTextStyle}" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Height="1"
                                Margin="64,0,0,0"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid
                                Padding="16"
                                ColumnSpacing="14"
                                RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PluginEditorRowIconStyle}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource AppIconFontFamily}"
                                        FontSize="15"
                                        Glyph="&#xEA88;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="2">
                                    <TextBlock
                                        x:Name="DisplayNameLabelText"
                                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="DisplayNameDescriptionText"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Spacing="6">
                                    <TextBox
                                        x:Name="DisplayNameTextBox"
                                        Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                                    <TextBlock
                                        x:Name="DisplayNameValidationTextBlock"
                                        Style="{StaticResource PostExportPluginEditorValidationTextStyle}" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Height="1"
                                Margin="64,0,0,0"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid
                                Padding="16"
                                ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PluginEditorRowIconStyle}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource AppIconFontFamily}"
                                        FontSize="15"
                                        Glyph="&#xE32E;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="2">
                                    <TextBlock
                                        x:Name="VersionLabelText"
                                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="VersionDescriptionText"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                                </StackPanel>
                                <TextBox
                                    x:Name="VersionTextBox"
                                    Grid.Column="2"
                                    Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                            </Grid>

                            <Border
                                Height="1"
                                Margin="64,0,0,0"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid
                                Padding="16"
                                ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PluginEditorRowIconStyle}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource AppIconFontFamily}"
                                        FontSize="15"
                                        Glyph="&#xECB0;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="2">
                                    <TextBlock
                                        x:Name="DescriptionLabelText"
                                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="DescriptionHintText"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                                </StackPanel>
                                <TextBox
                                    x:Name="DescriptionTextBox"
                                    Grid.Column="2"
                                    AcceptsReturn="True"
                                    MinHeight="72"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    x:Name="ExecutionStepPanel"
                    Spacing="12"
                    Visibility="Collapsed">
                    <Border Style="{StaticResource PluginEditorCardStyle}">
                        <StackPanel>
                            <Grid
                                Padding="16"
                                ColumnSpacing="14"
                                RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PluginEditorRowIconStyle}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource AppIconFontFamily}"
                                        FontSize="15"
                                        Glyph="&#xF5CD;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="2">
                                    <TextBlock
                                        x:Name="ExecutablePathLabelText"
                                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="ExecutablePathDescriptionText"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Spacing="6">
                                    <TextBox
                                        x:Name="ExecutablePathTextBox"
                                        Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                                    <TextBlock
                                        x:Name="ExecutablePathValidationTextBlock"
                                        Style="{StaticResource PostExportPluginEditorValidationTextStyle}" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Height="1"
                                Margin="64,0,0,0"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid
                                Padding="16"
                                ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PluginEditorRowIconStyle}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource AppIconFontFamily}"
                                        FontSize="15"
                                        Glyph="&#xE90B;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="2">
                                    <TextBlock
                                        x:Name="WorkingDirectoryLabelText"
                                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="WorkingDirectoryDescriptionText"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                                </StackPanel>
                                <TextBox
                                    x:Name="WorkingDirectoryTextBox"
                                    Grid.Column="2"
                                    Style="{StaticResource PluginEditorSingleLineTextBoxStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    x:Name="ArgumentsStepPanel"
                    Spacing="12"
                    Visibility="Collapsed">
                    <Border Style="{StaticResource PluginEditorCardStyle}">
                        <Grid
                            Padding="16"
                            ColumnSpacing="14"
                            RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PluginEditorRowIconStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource AppIconFontFamily}"
                                    FontSize="15"
                                    Glyph="&#xE6E9;" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Name="ArgumentsLabelText"
                                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="ArgumentsDescriptionText"
                                        Style="{StaticResource PluginEditorSecondaryTextStyle}" />
                                </StackPanel>
                                <TextBox
                                    x:Name="ArgumentsTextBox"
                                    AcceptsReturn="True"
                                    MinHeight="170"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    x:Name="ArgumentsValidationTextBlock"
                                    Style="{StaticResource PostExportPluginEditorValidationTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</UserControl>
