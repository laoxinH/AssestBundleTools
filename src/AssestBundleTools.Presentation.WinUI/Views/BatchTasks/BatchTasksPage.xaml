<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BatchTasks.BatchTasksPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BatchTasks"
    Background="Transparent"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid
        Padding="24,20,14,24"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="PageEyebrowText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="PageTitleText"
                    Style="{StaticResource WorkspacePageTitleTextStyle}" />
            </StackPanel>

            <TextBlock
                x:Name="PageSubtitleText"
                Grid.Row="1"
                MaxWidth="980"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="WrapWholeWords" />
        </Grid>

        <Border
            Grid.Row="1"
            Style="{StaticResource SettingsSectionCardStyle}"
            Padding="16"
            Visibility="{x:Bind ViewModel.WorkspaceContentVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="WorkspaceOverviewTitleText"
                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                    <TextBlock
                        x:Name="WorkspaceOverviewHintText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Text="{x:Bind ViewModel.WorkspaceOverviewText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ChangeSummaryText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Top">
                    <Button
                        Style="{StaticResource WorkspaceInlineActionButtonStyle}"
                        Command="{x:Bind ViewModel.ImportBundleFilesCommand, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE8A5;" />
                            <TextBlock
                                x:Name="ImportBundleFilesButtonText"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Style="{StaticResource WorkspaceInlineActionButtonStyle}"
                        Command="{x:Bind ViewModel.ImportBundleDirectoryCommand, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE838;" />
                            <TextBlock
                                x:Name="ImportBundleDirectoryButtonText"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="RefreshButton"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Style="{StaticResource SettingsSectionCardStyle}"
            Padding="16"
            Visibility="{x:Bind ViewModel.WorkspaceEmptyStateVisibility, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="EmptyStateTitleText"
                    Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                <TextBlock
                    x:Name="EmptyStateBodyText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <Grid
            Grid.Row="2"
            MinHeight="0"
            ColumnSpacing="16"
            Visibility="{x:Bind ViewModel.WorkspaceContentVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.95*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                VerticalScrollMode="Enabled"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                    Padding="0,0,4,0"
                    Spacing="16">
                    <Border
                        Style="{StaticResource SettingsSectionCardStyle}"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    x:Name="SummaryTitleText"
                                    Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                <TextBlock
                                    x:Name="SummaryHintText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.SummaryCards, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:BatchTaskSummaryCardViewModel">
                                        <Border
                                            Margin="0,0,0,10"
                                            Padding="12"
                                            Style="{StaticResource SettingsInsetCardStyle}">
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    Text="{x:Bind Title}"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <TextBlock
                                                    Text="{x:Bind ValueText}"
                                                    FontSize="28"
                                                    FontWeight="SemiBold" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Description}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource SettingsSectionCardStyle}"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    x:Name="BatchExtractTitleText"
                                    Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                <TextBlock
                                    x:Name="BatchExtractHintText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="BatchExtractScopeLabelText"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.BatchExtractScopeText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="BatchExtractAssetTypeLabelText"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                                <ComboBox
                                    Grid.Column="1"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind ViewModel.BatchExtractAssetTypeOptions, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedBatchExtractAssetTypeOption, Mode=TwoWay}" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="BatchExtractOutputDirectoryLabelText"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.BatchExtractOutputDirectoryText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="BatchExtractFileNamePolicyLabelText"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.BatchExtractFileNamePolicyText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="BatchExtractConflictPolicyLabelText"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.BatchExtractConflictPolicyText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </Grid>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.BatchExtractSummaryText, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />

                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.BatchExtractionBundles, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.BatchExtractListVisibility, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:BatchTaskExtractionBundleItemViewModel">
                                        <Border
                                            Margin="0,0,0,10"
                                            Padding="12"
                                            Style="{StaticResource SettingsInsetCardStyle}">
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    Text="{x:Bind BundleDisplayName}"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    TextWrapping="WrapWholeWords" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind SummaryText}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border
                                Padding="12"
                                Style="{StaticResource SettingsInsetCardStyle}"
                                Visibility="{x:Bind ViewModel.BatchExtractEmptyStateVisibility, Mode=OneWay}">
                                <TextBlock
                                    x:Name="BatchExtractEmptyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </Border>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="BatchExtractLastRunLabelText"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.BatchExtractLastRunText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <Button
                                    x:Name="BatchExtractExecuteButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.RunBatchExtractCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource SettingsSectionCardStyle}"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    x:Name="BatchReplaceTitleText"
                                    Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                <TextBlock
                                    x:Name="BatchReplaceHintText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="BatchReplaceScopeLabelText"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.BatchReplaceScopeText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="BatchReplaceSourceFilterLabelText"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                                <ComboBox
                                    Grid.Column="1"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind ViewModel.BatchReplaceSourceOptions, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedBatchReplaceSourceOption, Mode=TwoWay}" />
                            </Grid>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.BatchReplaceSummaryText, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />

                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.BatchReplacementBundles, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.BatchReplaceListVisibility, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:BatchTaskReplacementBundleItemViewModel">
                                        <Border
                                            Margin="0,0,0,10"
                                            Padding="12"
                                            Style="{StaticResource SettingsInsetCardStyle}">
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    Text="{x:Bind BundleDisplayName}"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    TextWrapping="WrapWholeWords" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind SummaryText}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border
                                Padding="12"
                                Style="{StaticResource SettingsInsetCardStyle}"
                                Visibility="{x:Bind ViewModel.BatchReplaceEmptyStateVisibility, Mode=OneWay}">
                                <TextBlock
                                    x:Name="BatchReplaceEmptyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </Border>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="BatchReplaceLastRunLabelText"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.BatchReplaceLastRunText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <Button
                                    x:Name="BatchReplaceExecuteButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.RunBatchReplaceCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource SettingsSectionCardStyle}"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    x:Name="SavePreviewTitleText"
                                    Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                <TextBlock
                                    x:Name="SavePreviewHintText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="SavePreviewOutputDirectoryLabelText"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.SaveOutputDirectoryText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="SavePreviewFileNamePolicyLabelText"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.SaveFileNamePolicyText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </Grid>

                            <TextBlock
                                Text="{x:Bind ViewModel.SavePreviewSummaryText, Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />

                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.SavePreviewBundles, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.SavePreviewListVisibility, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:BatchTaskSaveBundleItemViewModel">
                                        <Border
                                            Margin="0,0,0,10"
                                            Padding="12"
                                            Style="{StaticResource SettingsInsetCardStyle}">
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    Text="{x:Bind BundleDisplayName}"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    TextWrapping="WrapWholeWords" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind OutputPath}"
                                                    TextWrapping="WrapWholeWords" />
                                                <TextBlock
                                                    Text="{x:Bind SummaryText}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border
                                Padding="12"
                                Style="{StaticResource SettingsInsetCardStyle}"
                                Visibility="{x:Bind ViewModel.SavePreviewEmptyStateVisibility, Mode=OneWay}">
                                <TextBlock
                                    x:Name="SavePreviewEmptyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </Border>

                            <StackPanel Spacing="6">
                                <TextBlock
                                    x:Name="SavePreviewRiskTitleText"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SaveRiskNotes, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:BatchTaskTextItemViewModel">
                                            <Grid Margin="0,0,0,4" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="•" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind Text}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="SaveLastRunLabelText"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.SaveLastRunText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <Button
                                    x:Name="SaveExecuteButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.RunSaveCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource SettingsSectionCardStyle}"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="StageNoteTitleText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="StageNoteBodyText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid
                Grid.Column="1"
                MinHeight="0"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Style="{StaticResource SettingsSectionCardStyle}"
                    Padding="0">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Padding="16,16,16,0"
                            Spacing="6">
                            <TextBlock
                                x:Name="TaskResultsTitleText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="TaskResultsHintText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Grid
                            Grid.Row="1"
                            Padding="16,0,16,16">
                            <ScrollViewer
                                MaxHeight="280"
                                VerticalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Disabled"
                                HorizontalScrollBarVisibility="Disabled"
                                Visibility="{x:Bind ViewModel.TaskResultListVisibility, Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.RecentTaskResults, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:BatchTaskExecutionResultItemViewModel">
                                            <Border
                                                Margin="0,0,0,10"
                                                Padding="12"
                                                Style="{StaticResource SettingsInsetCardStyle}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock
                                                            Text="{x:Bind Title}"
                                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                            TextWrapping="WrapWholeWords" />
                                                        <TextBlock
                                                            Text="{x:Bind SummaryText}"
                                                            TextWrapping="WrapWholeWords" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind DetailText}"
                                                            TextWrapping="WrapWholeWords" />
                                                    </StackPanel>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        Spacing="8">
                                                        <Border
                                                            Padding="10,4"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            CornerRadius="999">
                                                            <TextBlock
                                                                Text="{x:Bind StatusText}"
                                                                Style="{ThemeResource CaptionTextBlockStyle}" />
                                                        </Border>
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind TimeText}"
                                                            TextWrapping="WrapWholeWords" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border
                                Padding="16"
                                Style="{StaticResource SettingsInsetCardStyle}"
                                Visibility="{x:Bind ViewModel.TaskResultEmptyStateVisibility, Mode=OneWay}">
                                <TextBlock
                                    x:Name="TaskResultsEmptyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    MinHeight="0"
                    Style="{StaticResource SettingsSectionCardStyle}"
                    Padding="0">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Padding="16,16,16,0"
                            Spacing="6">
                            <TextBlock
                                x:Name="RecentChangesTitleText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="RecentChangesHintText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Grid
                            Grid.Row="1"
                            MinHeight="0"
                            Padding="16,0,16,16">
                            <ListView
                                ItemsSource="{x:Bind ViewModel.RecentChanges, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ChangeListVisibility, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:BatchTaskChangeItemViewModel">
                                        <Border
                                            Margin="0,0,0,10"
                                            Padding="12"
                                            Style="{StaticResource SettingsInsetCardStyle}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Spacing="4">
                                                    <TextBlock
                                                        Text="{x:Bind AssetName}"
                                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind BundleDisplayName}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind AssetTypeText}" />
                                                    <TextBlock
                                                        Text="{x:Bind DetailText}"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Spacing="8">
                                                    <Border
                                                        Padding="10,4"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="999">
                                                        <TextBlock
                                                            Text="{x:Bind StateText}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind TimeText}"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border
                                Padding="16"
                                Style="{StaticResource SettingsInsetCardStyle}"
                                Visibility="{x:Bind ViewModel.ChangeEmptyStateVisibility, Mode=OneWay}">
                                <TextBlock
                                    x:Name="NoChangesText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
