<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AssestBundleTools.Presentation.WinUI.Views.SettingsDiagnosticsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:AssestBundleTools.Presentation.WinUI.Views.Shared"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.SettingsDiagnostics"
    Background="Transparent"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid
        Padding="24,20,14,24"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="PageEyebrowText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="PageTitleText"
                    Style="{StaticResource WorkspacePageTitleTextStyle}" />
            </StackPanel>

            <TextBlock
                x:Name="PageSubtitleText"
                Grid.Row="1"
                MaxWidth="980"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="WrapWholeWords" />
        </Grid>

        <Border
            Grid.Row="1"
            MinHeight="0"
            Style="{StaticResource SettingsSectionCardStyle}"
            Padding="0">
            <Grid
                MinHeight="0"
                ColumnSpacing="16"
                Padding="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.95*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer
                    MinHeight="0"
                    VerticalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <Border
                            Style="{StaticResource SettingsInsetCardStyle}"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        x:Name="WorkspaceStatusTitleText"
                                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="WorkspaceStatusHintText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <StackPanel
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.ActiveWorkspaceVisibility, Mode=OneWay}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Text="{x:Bind ViewModel.ActiveWorkspaceDisplayName, Mode=OneWay}"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />

                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Spacing="6">
                                            <Border
                                                Style="{StaticResource ExplorerTreeBadgeStyle}"
                                                Padding="8,3"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.ActiveWorkspacePrimaryBadgeText, Mode=OneWay}" />
                                            </Border>

                                            <Border
                                                Style="{StaticResource ExplorerTreeBadgeStyle}"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind ViewModel.ActiveWorkspaceSecondaryBadgeVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.ActiveWorkspaceSecondaryBadgeText, Mode=OneWay}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.ActiveWorkspaceSourceSummary, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.ActiveWorkspaceDataRootSummary, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ActiveWorkspaceSessionSummary, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind ViewModel.ActiveWorkspaceAvailabilitySummary, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="{x:Bind ViewModel.ActiveWorkspaceAvailabilityVisibility, Mode=OneWay}" />

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Style="{StaticResource WorkspaceInlineActionButtonStyle}"
                                            Command="{x:Bind ViewModel.ImportBundleFilesCommand, Mode=OneWay}">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <FontIcon
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="14"
                                                    Glyph="&#xE8A5;" />
                                                <TextBlock
                                                    x:Name="ActiveWorkspaceImportBundleFilesButtonText"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Style="{StaticResource WorkspaceInlineActionButtonStyle}"
                                            Command="{x:Bind ViewModel.ImportBundleDirectoryCommand, Mode=OneWay}">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <FontIcon
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="14"
                                                    Glyph="&#xE838;" />
                                                <TextBlock
                                                    x:Name="ActiveWorkspaceImportBundleDirectoryButtonText"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock
                                    x:Name="ActiveWorkspaceEmptyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="{x:Bind ViewModel.ActiveWorkspaceEmptyVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Style="{StaticResource SettingsInsetCardStyle}"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        x:Name="WorkspaceCatalogTitleText"
                                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="WorkspaceCatalogHintText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.WorkspaceCatalogSummaryText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />

                                <ItemsControl
                                    ItemsSource="{x:Bind ViewModel.WorkspaceEntries, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.WorkspaceEntryListVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:SettingsWorkspaceEntryItemViewModel">
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="12"
                                                Style="{StaticResource SettingsSectionCardStyle}">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind DisplayName}"
                                                            TextTrimming="CharacterEllipsis" />

                                                        <StackPanel
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            Spacing="6">
                                                            <Border
                                                                Style="{StaticResource ExplorerTreeBadgeStyle}"
                                                                Padding="8,3"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind PrimaryBadgeText}" />
                                                            </Border>
                                                            <Border
                                                                Style="{StaticResource ExplorerTreeBadgeStyle}"
                                                                Padding="8,3"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind SecondaryBadgeVisibility}">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind SecondaryBadgeText}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind SourceSummary}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind LastActivatedSummary}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind AvailabilitySummary}"
                                                        TextWrapping="WrapWholeWords"
                                                        Visibility="{x:Bind AvailabilitySummaryVisibility}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock
                                    x:Name="WorkspaceCatalogEmptyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="{x:Bind ViewModel.WorkspaceEntryEmptyVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Style="{StaticResource SettingsInsetCardStyle}"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        x:Name="DecryptorCatalogTitleText"
                                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="DecryptorCatalogHintText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="AddDecryptorButton"
                                        Style="{StaticResource WorkspaceInlineActionButtonStyle}"
                                        Click="OnAddDecryptorButtonClick">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="14"
                                                Glyph="&#xE710;" />
                                            <TextBlock
                                                x:Name="AddDecryptorButtonText"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="RefreshDecryptorCatalogButton"
                                        Style="{StaticResource WorkspaceInlineActionButtonStyle}"
                                        Click="OnRefreshDecryptorCatalogButtonClick">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="14"
                                                Glyph="&#xE72C;" />
                                            <TextBlock
                                                x:Name="RefreshDecryptorCatalogButtonText"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <ItemsControl
                                    ItemsSource="{x:Bind ViewModel.DecryptorEntries, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.DecryptorEntryListVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:SettingsDecryptorCatalogEntryItemViewModel">
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="12"
                                                Style="{StaticResource SettingsSectionCardStyle}">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Spacing="4">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Text="{x:Bind DisplayName}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                Text="{x:Bind Id}"
                                                                TextWrapping="WrapWholeWords" />
                                                        </StackPanel>

                                                        <StackPanel
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            Spacing="6">
                                                            <Border
                                                                Style="{StaticResource ExplorerTreeBadgeStyle}"
                                                                Padding="8,3"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind PrimaryBadgeText}" />
                                                            </Border>
                                                            <Border
                                                                Style="{StaticResource ExplorerTreeBadgeStyle}"
                                                                Padding="8,3"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind SecondaryBadgeVisibility}">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind SecondaryBadgeText}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock
                                                        Text="{x:Bind VersionSummary}"
                                                        TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Description}"
                                                        TextWrapping="WrapWholeWords"
                                                        Visibility="{x:Bind DescriptionVisibility}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind ExecutablePathSummary}"
                                                        TextWrapping="WrapWholeWords"
                                                        Visibility="{x:Bind ExecutablePathVisibility}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind ManifestPathSummary}"
                                                        TextWrapping="WrapWholeWords"
                                                        Visibility="{x:Bind ManifestPathVisibility}" />

                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="8">
                                                        <Button
                                                            Style="{StaticResource WorkspaceInlineActionButtonStyle}"
                                                            Click="OnEditDecryptorButtonClick"
                                                            IsEnabled="{x:Bind CanEdit}"
                                                            Tag="{x:Bind Id}">
                                                            <StackPanel
                                                                Orientation="Horizontal"
                                                                Spacing="8">
                                                                <FontIcon
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    FontSize="14"
                                                                    Glyph="&#xE70F;" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding EditDecryptorButtonLabelText, ElementName=PageRoot}" />
                                                            </StackPanel>
                                                        </Button>

                                                        <Button
                                                            Style="{StaticResource WorkspaceInlineActionButtonStyle}"
                                                            Click="OnDeleteDecryptorButtonClick"
                                                            IsEnabled="{x:Bind CanDelete}"
                                                            Tag="{x:Bind Id}">
                                                            <StackPanel
                                                                Orientation="Horizontal"
                                                                Spacing="8">
                                                                <FontIcon
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    FontSize="14"
                                                                    Glyph="&#xE74D;" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding DeleteDecryptorButtonLabelText, ElementName=PageRoot}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock
                                    x:Name="DecryptorCatalogEmptyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="{x:Bind ViewModel.DecryptorEntryEmptyVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Style="{StaticResource SettingsInsetCardStyle}"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        x:Name="StartupBehaviorTitleText"
                                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="StartupBehaviorHintText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <ToggleSwitch
                                    x:Name="RestoreLastWorkspaceOnStartupToggleSwitch"
                                    IsOn="{x:Bind ViewModel.RestoreLastWorkspaceOnStartup, Mode=TwoWay}" />

                                <TextBlock
                                    x:Name="RestoreLastWorkspaceOnStartupDescriptionText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />

                                <TextBlock
                                    x:Name="RecentWorkspaceOpenBehaviorLabelText"
                                    FontWeight="SemiBold" />

                                <RadioButtons
                                    x:Name="RecentWorkspaceOpenBehaviorRadioButtons"
                                    MaxColumns="3"
                                    SelectedIndex="{x:Bind ViewModel.RecentWorkspaceOpenBehaviorSelectedIndex, Mode=TwoWay}" />

                                <TextBlock
                                    x:Name="RecentWorkspaceOpenBehaviorDescriptionText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <Border
                            Style="{StaticResource SettingsInsetCardStyle}"
                            Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Name="ResponsibilityTitleText"
                                    Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                <TextBlock
                                    x:Name="ResponsibilityBodyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <Border
                            Style="{StaticResource SettingsInsetCardStyle}"
                            Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Name="DiagnosticsTitleText"
                                    Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                <TextBlock
                                    x:Name="DiagnosticsBodyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border
                    Grid.Column="1"
                    MinHeight="0"
                    Style="{StaticResource SettingsInsetCardStyle}"
                    Padding="0">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Padding="16,16,16,0"
                            Spacing="6">
                            <TextBlock
                                x:Name="LogCenterTitleText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="LogCenterHintText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Grid
                            Grid.Row="1"
                            MinHeight="0"
                            Padding="16,0,16,16">
                            <shared:LogPanel
                                ViewModel="{x:Bind ViewModel.LogPanel, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
