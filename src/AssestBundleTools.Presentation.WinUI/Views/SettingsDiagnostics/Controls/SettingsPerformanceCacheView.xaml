<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.SettingsDiagnostics.Controls.SettingsPerformanceCacheView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Views/SettingsDiagnostics/SettingsDiagnosticsResources.xaml" />
    </UserControl.Resources>

    <ScrollViewer
        x:Name="PerformanceCacheSettingsScrollViewer"
        MinHeight="0"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <Border
            Width="{Binding ViewportWidth, ElementName=PerformanceCacheSettingsScrollViewer}"
            Style="{StaticResource SettingsDiagnosticsContentColumnStyle}">
            <StackPanel Spacing="26">
                <StackPanel Spacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="WorkspaceImportPerformanceTitleText"
                            Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                        <TextBlock
                            x:Name="WorkspaceImportPerformanceHintText"
                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Glyph="&#xE9D9;"
                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                            <StackPanel
                                Grid.Column="1"
                                MinWidth="0"
                                Spacing="3">
                                <TextBlock
                                    x:Name="WorkspaceImportWorkerCountLabelText"
                                    Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                <TextBlock
                                    x:Name="WorkspaceImportWorkerCountDescriptionText"
                                    Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                            </StackPanel>

                            <Grid
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Style="{StaticResource SettingsDiagnosticsSettingValueTextStyle}"
                                    Text="{x:Bind ViewModel.WorkspaceImportWorkerCountSelectedText, Mode=OneWay}" />
                                <Slider
                                    Grid.Row="1"
                                    IsThumbToolTipEnabled="False"
                                    Maximum="4"
                                    Minimum="0"
                                    StepFrequency="1"
                                    SnapsTo="StepValues"
                                    TickFrequency="1"
                                    Value="{x:Bind ViewModel.WorkspaceImportWorkerCountSliderValue, Mode=TwoWay}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Glyph="&#xE7B3;"
                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                            <StackPanel
                                Grid.Column="1"
                                MinWidth="0"
                                Spacing="3">
                                <TextBlock
                                    x:Name="PreviewWorkerCountLabelText"
                                    Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                <TextBlock
                                    x:Name="PreviewWorkerCountDescriptionText"
                                    Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                            </StackPanel>

                            <Grid
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Style="{StaticResource SettingsDiagnosticsSettingValueTextStyle}"
                                    Text="{x:Bind ViewModel.PreviewWorkerCountSelectedText, Mode=OneWay}" />
                                <Slider
                                    Grid.Row="1"
                                    IsThumbToolTipEnabled="False"
                                    Maximum="4"
                                    Minimum="0"
                                    StepFrequency="1"
                                    SnapsTo="StepValues"
                                    TickFrequency="1"
                                    Value="{x:Bind ViewModel.PreviewWorkerCountSliderValue, Mode=TwoWay}" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="BundleArtifactCacheTitleText"
                            Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                        <TextBlock
                            x:Name="BundleArtifactCacheHintText"
                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Glyph="&#xE8B7;"
                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                            <StackPanel
                                Grid.Column="1"
                                MinWidth="0"
                                Spacing="4">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.BundleArtifactCache.TargetText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                    Text="{x:Bind ViewModel.BundleArtifactCache.SummaryText, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource SettingsDiagnosticsMutedTextStyle}"
                                    Text="{x:Bind ViewModel.BundleArtifactCache.LastResultText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.BundleArtifactCache.LastResultVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Command="{x:Bind ViewModel.BundleArtifactCache.RefreshCommand, Mode=OneWay}"
                                    Style="{StaticResource SettingsDiagnosticsCompactActionButtonStyle}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="7">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="13"
                                            Glyph="&#xE72C;" />
                                        <TextBlock
                                            x:Name="RefreshBundleArtifactCacheButtonText"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Command="{x:Bind ViewModel.BundleArtifactCache.ClearCommand, Mode=OneWay}"
                                    Style="{StaticResource SettingsDiagnosticsCompactActionButtonStyle}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="7">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="13"
                                            Glyph="&#xE74D;" />
                                        <TextBlock
                                            x:Name="ClearBundleArtifactCacheButtonText"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Glyph="&#xE74D;"
                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                            <StackPanel
                                Grid.Column="1"
                                MinWidth="0"
                                Spacing="3">
                                <TextBlock
                                    x:Name="BundleArtifactCacheAutoPruneLabelText"
                                    Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                <TextBlock
                                    x:Name="BundleArtifactCacheAutoPruneDescriptionText"
                                    Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Name="BundleArtifactCacheAutoPruneToggleSwitch"
                                Grid.Column="2"
                                IsOn="{x:Bind ViewModel.BundleArtifactCache.AutoPruneEnabled, Mode=TwoWay}"
                                Style="{StaticResource SettingsDiagnosticsTrailingToggleSwitchStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Glyph="&#xE8D4;"
                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                            <StackPanel
                                Grid.Column="1"
                                MinWidth="0"
                                Spacing="3">
                                <TextBlock
                                    x:Name="BundleArtifactCacheMaximumSizeLabelText"
                                    Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                <TextBlock
                                    x:Name="BundleArtifactCacheMaximumSizeDescriptionText"
                                    Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                            </StackPanel>

                            <Grid
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Style="{StaticResource SettingsDiagnosticsSettingValueTextStyle}"
                                    Text="{x:Bind ViewModel.BundleArtifactCache.MaximumSizeSelectedText, Mode=OneWay}" />
                                <Slider
                                    Grid.Row="1"
                                    IsThumbToolTipEnabled="False"
                                    Maximum="4"
                                    Minimum="0"
                                    StepFrequency="1"
                                    SnapsTo="StepValues"
                                    TickFrequency="1"
                                    Value="{x:Bind ViewModel.BundleArtifactCache.MaximumSizeSliderValue, Mode=TwoWay}" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
