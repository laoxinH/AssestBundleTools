<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.SettingsDiagnostics.Controls.SettingsAboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Views/SettingsDiagnostics/SettingsDiagnosticsResources.xaml" />
    </UserControl.Resources>

    <ScrollViewer
        x:Name="AboutSettingsScrollViewer"
        MinHeight="0"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <Border
            x:Name="AboutSettingsContentColumn"
            Width="{Binding ViewportWidth, ElementName=AboutSettingsScrollViewer}"
            Style="{StaticResource SettingsDiagnosticsContentColumnStyle}">
            <StackPanel Spacing="22">
                <Border Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="76"
                            Height="76"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Source="ms-appx:///Assets/AppLogo.png"
                            Stretch="Uniform" />

                        <StackPanel
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Spacing="7">
                            <TextBlock
                                x:Name="ProductNameText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                x:Name="ProductDescriptionText"
                                MaxWidth="680"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                            <Border
                                Padding="9,4"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        FontFamily="{StaticResource AppIconFontFamily}"
                                        FontSize="13"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xF283;" />
                                    <TextBlock
                                        x:Name="VersionText"
                                        FontSize="12"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="UpdateTitleText"
                            Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                        <TextBlock
                            x:Name="UpdateHintText"
                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                    </StackPanel>

                    <Border Padding="0" Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                        <Grid Padding="18,14" ColumnSpacing="14" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE895;" Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />
                            <StackPanel Grid.Column="1" MinWidth="0" Spacing="3">
                                <TextBlock
                                    x:Name="UpdateStatusText"
                                    Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="UpdateVersionText"
                                    Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="UpdateActionButton"
                                Grid.Column="2"
                                Click="OnUpdateActionButtonClick" />
                            <Button
                                x:Name="UpdateCancelButton"
                                Grid.Column="3"
                                Click="OnUpdateCancelButtonClick"
                                Visibility="Collapsed" />

                            <ProgressBar
                                x:Name="UpdateProgressBar"
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                MinWidth="180"
                                Maximum="100"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="LinksTitleText"
                            Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                        <TextBlock
                            x:Name="LinksHintText"
                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                    </StackPanel>

                    <Border Padding="0" Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                        <StackPanel>
                            <Grid Padding="18,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE54E;" Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />
                                <StackPanel Grid.Column="1" MinWidth="0" Spacing="3">
                                    <TextBlock x:Name="GitHubTitleText" Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                    <TextBlock x:Name="GitHubAddressText" Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                                </StackPanel>
                                <HyperlinkButton
                                    x:Name="GitHubLinkButton"
                                    Grid.Column="2"
                                    NavigateUri="https://github.com/laoxinH/AssestBundleTools">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="GitHubLinkButtonText" />
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="13"
                                            Glyph="&#xE15F;" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </Grid>

                            <Border Height="1" Margin="64,0,18,0" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid Padding="18,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE99B;" Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />
                                <StackPanel Grid.Column="1" MinWidth="0" Spacing="3">
                                    <TextBlock x:Name="WebsiteTitleText" Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                    <TextBlock x:Name="WebsiteAddressText" Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                                </StackPanel>
                                <HyperlinkButton
                                    x:Name="WebsiteLinkButton"
                                    Grid.Column="2"
                                    NavigateUri="https://www.modwu.com/">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="WebsiteLinkButtonText" />
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="13"
                                            Glyph="&#xE15F;" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="CreditsTitleText"
                            Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                        <TextBlock
                            x:Name="CreditsHintText"
                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                    </StackPanel>

                    <Border Padding="0" Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                        <StackPanel>
                            <Grid Padding="18,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEDB3;" Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />
                                <TextBlock x:Name="MaintainerLabelText" Grid.Column="1" Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                <TextBlock x:Name="MaintainerValueText" Grid.Column="2" Style="{StaticResource SettingsDiagnosticsSettingValueTextStyle}" />
                            </Grid>

                            <Border Height="1" Margin="64,0,18,0" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid Padding="18,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xED12;" Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />
                                <TextBlock x:Name="IconArtistLabelText" Grid.Column="1" Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                <TextBlock x:Name="IconArtistValueText" Grid.Column="2" Style="{StaticResource SettingsDiagnosticsSettingValueTextStyle}" />
                            </Grid>

                            <Border Height="1" Margin="64,0,18,0" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid Padding="18,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE685;" Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />
                                <TextBlock x:Name="PlatformLabelText" Grid.Column="1" Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                <TextBlock x:Name="PlatformValueText" Grid.Column="2" Style="{StaticResource SettingsDiagnosticsSettingValueTextStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
