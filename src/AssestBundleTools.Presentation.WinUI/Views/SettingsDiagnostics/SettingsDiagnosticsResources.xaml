<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style
        x:Key="SettingsDiagnosticsSurfaceStyle"
        TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsGroupCardStyle"
        TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsContentColumnStyle"
        TargetType="Border">
        <Setter Property="MaxWidth" Value="980" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="0,0,14,0" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsSettingRowStyle"
        TargetType="Border">
        <Setter Property="MinHeight" Value="78" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsSettingTitleTextStyle"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsSettingDescriptionTextStyle"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsSettingValueTextStyle"
        TargetType="TextBlock">
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsTrailingToggleSwitchStyle"
        BasedOn="{StaticResource DefaultToggleSwitchStyle}"
        TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsSettingIconStyle"
        TargetType="FontIcon">
        <Setter Property="Width" Value="28" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsCompactActionButtonStyle"
        TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsWorkspaceIconBadgeStyle"
        TargetType="Border">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsWorkspaceSummaryTileStyle"
        TargetType="Border">
        <Setter Property="MinHeight" Value="62" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsWorkspaceSummaryIconStyle"
        BasedOn="{StaticResource SettingsDiagnosticsSettingIconStyle}"
        TargetType="FontIcon">
        <Setter Property="Width" Value="22" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsSecondaryTextStyle"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style
        x:Key="SettingsDiagnosticsMutedTextStyle"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>
</ResourceDictionary>
