<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AssestBundleTools.Presentation.WinUI.Views.SettingsDiagnostics.SettingsDiagnosticsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:AssestBundleTools.Presentation.WinUI.Views.Shared"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.SettingsDiagnostics"
    Background="Transparent"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="SettingsDiagnosticsSurfaceStyle"
            TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style
            x:Key="SettingsDiagnosticsGroupCardStyle"
            TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style
            x:Key="SettingsDiagnosticsContentColumnStyle"
            TargetType="Border">
            <Setter Property="MaxWidth" Value="980" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="0,0,14,0" />
        </Style>

        <Style
            x:Key="SettingsDiagnosticsSettingRowStyle"
            TargetType="Border">
            <Setter Property="MinHeight" Value="78" />
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style
            x:Key="SettingsDiagnosticsSettingTitleTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="SettingsDiagnosticsSettingDescriptionTextStyle"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="SettingsDiagnosticsSettingValueTextStyle"
            TargetType="TextBlock">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style
            x:Key="SettingsDiagnosticsSettingIconStyle"
            TargetType="FontIcon">
            <Setter Property="Width" Value="28" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="SettingsDiagnosticsSecondaryTextStyle"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="SettingsDiagnosticsMutedTextStyle"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
    </Page.Resources>

    <Grid
        Padding="24,20,14,24"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="PageEyebrowText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="PageTitleText"
                    Style="{StaticResource WorkspacePageTitleTextStyle}" />
            </StackPanel>

            <TextBlock
                x:Name="PageSubtitleText"
                Grid.Row="1"
                MaxWidth="980"
                Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
        </Grid>

        <Border
            Grid.Row="1"
            MinHeight="0"
            Style="{StaticResource SettingsDiagnosticsSurfaceStyle}">
            <NavigationView
                x:Name="SettingsSubPageNavigationView"
                AlwaysShowHeader="False"
                Background="Transparent"
                CompactPaneLength="48"
                IsBackButtonVisible="Collapsed"
                IsPaneOpen="True"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                OpenPaneLength="232"
                PaneDisplayMode="Left"
                SelectionChanged="OnSettingsSubPageNavigationSelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        x:Name="SettingsWorkspaceNavItem"
                        Tag="workspace">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Folder" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="SettingsPreferencesNavItem"
                        Tag="preferences">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Setting" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="SettingsPerformanceCacheNavItem"
                        Tag="performance-cache">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE9D9;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="SettingsDiagnosticsNavItem"
                        Tag="diagnostics">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE946;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="SettingsLogsNavItem"
                        Tag="logs">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE9D5;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Grid
                    MinHeight="0"
                    Padding="16">
                    <ScrollViewer
                        x:Name="WorkspaceSettingsPanel"
                        MinHeight="0"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <Border
                            Width="{Binding ViewportWidth, ElementName=WorkspaceSettingsPanel}"
                            Style="{StaticResource SettingsDiagnosticsContentColumnStyle}">
                            <StackPanel Spacing="14">
                                <Border Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="WorkspaceStatusTitleText"
                                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                            <TextBlock
                                                x:Name="WorkspaceStatusHintText"
                                                Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                                        </StackPanel>

                                        <StackPanel
                                            Spacing="8"
                                            Visibility="{x:Bind ViewModel.ActiveWorkspaceVisibility, Mode=OneWay}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind ViewModel.ActiveWorkspaceDisplayName, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <StackPanel
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Spacing="6">
                                                    <Border
                                                        Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource ExplorerTreeBadgeStyle}">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind ViewModel.ActiveWorkspacePrimaryBadgeText, Mode=OneWay}" />
                                                    </Border>

                                                    <Border
                                                        Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource ExplorerTreeBadgeStyle}"
                                                        Visibility="{x:Bind ViewModel.ActiveWorkspaceSecondaryBadgeVisibility, Mode=OneWay}">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind ViewModel.ActiveWorkspaceSecondaryBadgeText, Mode=OneWay}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock
                                                Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                                Text="{x:Bind ViewModel.ActiveWorkspaceSourceSummary, Mode=OneWay}" />
                                            <TextBlock
                                                Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                                Text="{x:Bind ViewModel.ActiveWorkspaceDataRootSummary, Mode=OneWay}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.ActiveWorkspaceSessionSummary, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Style="{StaticResource SettingsDiagnosticsMutedTextStyle}"
                                                Text="{x:Bind ViewModel.ActiveWorkspaceAvailabilitySummary, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.ActiveWorkspaceAvailabilityVisibility, Mode=OneWay}" />

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button
                                                    Command="{x:Bind ViewModel.ImportBundleFilesCommand, Mode=OneWay}"
                                                    Style="{StaticResource WorkspaceInlineActionButtonStyle}">
                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="8">
                                                        <FontIcon
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="14"
                                                            Glyph="&#xE8A5;" />
                                                        <TextBlock
                                                            x:Name="ActiveWorkspaceImportBundleFilesButtonText"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <Button
                                                    Command="{x:Bind ViewModel.ImportBundleDirectoryCommand, Mode=OneWay}"
                                                    Style="{StaticResource WorkspaceInlineActionButtonStyle}">
                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="8">
                                                        <FontIcon
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="14"
                                                            Glyph="&#xE838;" />
                                                        <TextBlock
                                                            x:Name="ActiveWorkspaceImportBundleDirectoryButtonText"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock
                                            x:Name="ActiveWorkspaceEmptyText"
                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                            Visibility="{x:Bind ViewModel.ActiveWorkspaceEmptyVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="WorkspaceCatalogTitleText"
                                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                            <TextBlock
                                                x:Name="WorkspaceCatalogHintText"
                                                Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                                        </StackPanel>

                                    <TextBlock
                                        Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                        Text="{x:Bind ViewModel.WorkspaceCatalogSummaryText, Mode=OneWay}" />

                                    <ItemsControl
                                        ItemsSource="{x:Bind ViewModel.WorkspaceEntries, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.WorkspaceEntryListVisibility, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:SettingsWorkspaceEntryItemViewModel">
                                                <Border
                                                    Margin="0,0,0,8"
                                                    Padding="12"
                                                    Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Text="{x:Bind DisplayName}"
                                                                TextTrimming="CharacterEllipsis" />

                                                            <StackPanel
                                                                Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                Spacing="6">
                                                                <Border
                                                                    Padding="8,3"
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource ExplorerTreeBadgeStyle}">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind PrimaryBadgeText}" />
                                                                </Border>
                                                                <Border
                                                                    Padding="8,3"
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource ExplorerTreeBadgeStyle}"
                                                                    Visibility="{x:Bind SecondaryBadgeVisibility}">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind SecondaryBadgeText}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock
                                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                                            Text="{x:Bind SourceSummary}" />
                                                        <TextBlock
                                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                                            Text="{x:Bind LastActivatedSummary}" />
                                                        <TextBlock
                                                            Style="{StaticResource SettingsDiagnosticsMutedTextStyle}"
                                                            Text="{x:Bind AvailabilitySummary}"
                                                            Visibility="{x:Bind AvailabilitySummaryVisibility}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock
                                        x:Name="WorkspaceCatalogEmptyText"
                                        Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                        Visibility="{x:Bind ViewModel.WorkspaceEntryEmptyVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="PreferenceSettingsPanel"
                        MinHeight="0"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled"
                        Visibility="Collapsed">
                        <Border
                            Width="{Binding ViewportWidth, ElementName=PreferenceSettingsPanel}"
                            Style="{StaticResource SettingsDiagnosticsContentColumnStyle}">
                            <StackPanel Spacing="26">
                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            x:Name="StartupBehaviorTitleText"
                                            Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                        <TextBlock
                                            x:Name="StartupBehaviorHintText"
                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                                    </StackPanel>

                                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                                        <Grid ColumnSpacing="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Glyph="&#xE777;"
                                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                                            <StackPanel
                                                Grid.Column="1"
                                                MinWidth="0"
                                                Spacing="3">
                                                <TextBlock
                                                    x:Name="RestoreLastWorkspaceOnStartupLabelText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                                <TextBlock
                                                    x:Name="RestoreLastWorkspaceOnStartupDescriptionText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="10">
                                                <ToggleSwitch
                                                    x:Name="RestoreLastWorkspaceOnStartupToggleSwitch"
                                                    VerticalAlignment="Center"
                                                    IsOn="{x:Bind ViewModel.RestoreLastWorkspaceOnStartup, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                                        <Grid ColumnSpacing="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Glyph="&#xE8A7;"
                                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                                            <StackPanel
                                                Grid.Column="1"
                                                MinWidth="0"
                                                Spacing="3">
                                                <TextBlock
                                                    x:Name="RecentWorkspaceOpenBehaviorLabelText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                                <TextBlock
                                                    x:Name="RecentWorkspaceOpenBehaviorDescriptionText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                                            </StackPanel>

                                            <ComboBox
                                                x:Name="RecentWorkspaceOpenBehaviorComboBox"
                                                Grid.Column="2"
                                                Width="246"
                                                VerticalAlignment="Center"
                                                SelectedIndex="{x:Bind ViewModel.RecentWorkspaceOpenBehaviorSelectedIndex, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                                        <Grid ColumnSpacing="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Glyph="&#xE70F;"
                                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                                            <StackPanel
                                                Grid.Column="1"
                                                MinWidth="0"
                                                Spacing="3">
                                                <TextBlock
                                                    x:Name="AssetEditorCloseBehaviorLabelText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                                <TextBlock
                                                    x:Name="AssetEditorCloseBehaviorDescriptionText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                                            </StackPanel>

                                            <ComboBox
                                                x:Name="AssetEditorCloseBehaviorComboBox"
                                                Grid.Column="2"
                                                Width="246"
                                                VerticalAlignment="Center"
                                                SelectedIndex="{x:Bind ViewModel.AssetEditorCloseBehaviorSelectedIndex, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            x:Name="OperationRecordsTitleText"
                                            Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                        <TextBlock
                                            x:Name="OperationRecordsHintText"
                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                                    </StackPanel>

                                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                                        <Grid ColumnSpacing="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="360" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Glyph="&#xE81C;"
                                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                                            <StackPanel
                                                Grid.Column="1"
                                                MinWidth="0"
                                                Spacing="3">
                                                <TextBlock
                                                    x:Name="OperationRecordLimitLabelText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                                <TextBlock
                                                    x:Name="OperationRecordLimitDescriptionText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                                            </StackPanel>

                                            <Grid
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Style="{StaticResource SettingsDiagnosticsSettingValueTextStyle}"
                                                    Text="{x:Bind ViewModel.OperationRecordLimitSelectedText, Mode=OneWay}" />
                                                <Slider
                                                    Grid.Row="1"
                                                    IsThumbToolTipEnabled="False"
                                                    Maximum="3"
                                                    Minimum="0"
                                                    StepFrequency="1"
                                                    SnapsTo="StepValues"
                                                    TickFrequency="1"
                                                    Value="{x:Bind ViewModel.OperationRecordLimitSliderValue, Mode=TwoWay}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="PerformanceCacheSettingsPanel"
                        MinHeight="0"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled"
                        Visibility="Collapsed">
                        <Border
                            Width="{Binding ViewportWidth, ElementName=PerformanceCacheSettingsPanel}"
                            Style="{StaticResource SettingsDiagnosticsContentColumnStyle}">
                            <StackPanel Spacing="26">
                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            x:Name="WorkspaceImportPerformanceTitleText"
                                            Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                        <TextBlock
                                            x:Name="WorkspaceImportPerformanceHintText"
                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                                    </StackPanel>

                                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                                        <Grid ColumnSpacing="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="360" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Glyph="&#xE9D9;"
                                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                                            <StackPanel
                                                Grid.Column="1"
                                                MinWidth="0"
                                                Spacing="3">
                                                <TextBlock
                                                    x:Name="WorkspaceImportWorkerCountLabelText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                                <TextBlock
                                                    x:Name="WorkspaceImportWorkerCountDescriptionText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                                            </StackPanel>

                                            <Grid
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Style="{StaticResource SettingsDiagnosticsSettingValueTextStyle}"
                                                    Text="{x:Bind ViewModel.WorkspaceImportWorkerCountSelectedText, Mode=OneWay}" />
                                                <Slider
                                                    Grid.Row="1"
                                                    IsThumbToolTipEnabled="False"
                                                    Maximum="4"
                                                    Minimum="0"
                                                    StepFrequency="1"
                                                    SnapsTo="StepValues"
                                                    TickFrequency="1"
                                                    Value="{x:Bind ViewModel.WorkspaceImportWorkerCountSliderValue, Mode=TwoWay}" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                                        <Grid ColumnSpacing="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="360" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Glyph="&#xE7B3;"
                                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                                            <StackPanel
                                                Grid.Column="1"
                                                MinWidth="0"
                                                Spacing="3">
                                                <TextBlock
                                                    x:Name="PreviewWorkerCountLabelText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                                <TextBlock
                                                    x:Name="PreviewWorkerCountDescriptionText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                                            </StackPanel>

                                            <Grid
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Style="{StaticResource SettingsDiagnosticsSettingValueTextStyle}"
                                                    Text="{x:Bind ViewModel.PreviewWorkerCountSelectedText, Mode=OneWay}" />
                                                <Slider
                                                    Grid.Row="1"
                                                    IsThumbToolTipEnabled="False"
                                                    Maximum="4"
                                                    Minimum="0"
                                                    StepFrequency="1"
                                                    SnapsTo="StepValues"
                                                    TickFrequency="1"
                                                    Value="{x:Bind ViewModel.PreviewWorkerCountSliderValue, Mode=TwoWay}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            x:Name="BundleArtifactCacheTitleText"
                                            Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                        <TextBlock
                                            x:Name="BundleArtifactCacheHintText"
                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                                    </StackPanel>

                                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                                        <Grid ColumnSpacing="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Glyph="&#xE8B7;"
                                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                                            <StackPanel
                                                Grid.Column="1"
                                                MinWidth="0"
                                                Spacing="4">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind ViewModel.BundleArtifactCache.TargetText, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords" />
                                                <TextBlock
                                                    Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                                    Text="{x:Bind ViewModel.BundleArtifactCache.SummaryText, Mode=OneWay}" />
                                                <TextBlock
                                                    Style="{StaticResource SettingsDiagnosticsMutedTextStyle}"
                                                    Text="{x:Bind ViewModel.BundleArtifactCache.LastResultText, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.BundleArtifactCache.LastResultVisibility, Mode=OneWay}" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button
                                                    Command="{x:Bind ViewModel.BundleArtifactCache.RefreshCommand, Mode=OneWay}"
                                                    Style="{StaticResource WorkspaceInlineActionButtonStyle}">
                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="8">
                                                        <FontIcon
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="14"
                                                            Glyph="&#xE72C;" />
                                                        <TextBlock
                                                            x:Name="RefreshBundleArtifactCacheButtonText"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <Button
                                                    Command="{x:Bind ViewModel.BundleArtifactCache.ClearCommand, Mode=OneWay}"
                                                    Style="{StaticResource WorkspaceInlineActionButtonStyle}">
                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="8">
                                                        <FontIcon
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="14"
                                                            Glyph="&#xE74D;" />
                                                        <TextBlock
                                                            x:Name="ClearBundleArtifactCacheButtonText"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                                        <Grid ColumnSpacing="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Glyph="&#xE74D;"
                                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                                            <StackPanel
                                                Grid.Column="1"
                                                MinWidth="0"
                                                Spacing="3">
                                                <TextBlock
                                                    x:Name="BundleArtifactCacheAutoPruneLabelText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                                <TextBlock
                                                    x:Name="BundleArtifactCacheAutoPruneDescriptionText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                                            </StackPanel>

                                            <ToggleSwitch
                                                x:Name="BundleArtifactCacheAutoPruneToggleSwitch"
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                IsOn="{x:Bind ViewModel.BundleArtifactCache.AutoPruneEnabled, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsDiagnosticsSettingRowStyle}">
                                        <Grid ColumnSpacing="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="360" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Glyph="&#xE8D4;"
                                                Style="{StaticResource SettingsDiagnosticsSettingIconStyle}" />

                                            <StackPanel
                                                Grid.Column="1"
                                                MinWidth="0"
                                                Spacing="3">
                                                <TextBlock
                                                    x:Name="BundleArtifactCacheMaximumSizeLabelText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingTitleTextStyle}" />
                                                <TextBlock
                                                    x:Name="BundleArtifactCacheMaximumSizeDescriptionText"
                                                    Style="{StaticResource SettingsDiagnosticsSettingDescriptionTextStyle}" />
                                            </StackPanel>

                                            <Grid
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Style="{StaticResource SettingsDiagnosticsSettingValueTextStyle}"
                                                    Text="{x:Bind ViewModel.BundleArtifactCache.MaximumSizeSelectedText, Mode=OneWay}" />
                                                <Slider
                                                    Grid.Row="1"
                                                    IsThumbToolTipEnabled="False"
                                                    Maximum="4"
                                                    Minimum="0"
                                                    StepFrequency="1"
                                                    SnapsTo="StepValues"
                                                    TickFrequency="1"
                                                    Value="{x:Bind ViewModel.BundleArtifactCache.MaximumSizeSliderValue, Mode=TwoWay}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="DiagnosticsSettingsPanel"
                        MinHeight="0"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled"
                        Visibility="Collapsed">
                        <Border
                            Width="{Binding ViewportWidth, ElementName=DiagnosticsSettingsPanel}"
                            Style="{StaticResource SettingsDiagnosticsContentColumnStyle}">
                            <StackPanel Spacing="14">
                                <Border Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        x:Name="ResponsibilityTitleText"
                                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="ResponsibilityBodyText"
                                        Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                                </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        x:Name="DiagnosticsTitleText"
                                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                    <TextBlock
                                        x:Name="DiagnosticsBodyText"
                                        Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                                </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <Grid
                        x:Name="LogCenterPanel"
                        MinHeight="0"
                        Visibility="Collapsed">
                        <Border
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource SettingsDiagnosticsContentColumnStyle}">
                            <Border
                                Padding="18"
                                Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            x:Name="LogCenterTitleText"
                                            Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                        <TextBlock
                                            x:Name="LogCenterHintText"
                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                                    </StackPanel>

                                    <shared:LogPanel
                                        Grid.Row="1"
                                        MinHeight="0"
                                        ViewModel="{x:Bind ViewModel.LogPanel, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </NavigationView>
        </Border>
    </Grid>
</Page>
