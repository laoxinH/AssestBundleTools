<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AssestBundleTools.Presentation.WinUI.Views.SettingsDiagnostics.SettingsDiagnosticsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:AssestBundleTools.Presentation.WinUI.Views.Shared"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.SettingsDiagnostics"
    Background="Transparent"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary Source="ms-appx:///Views/SettingsDiagnostics/SettingsDiagnosticsResources.xaml" />
    </Page.Resources>

    <Grid
        Padding="24,20,14,24"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="PageTitleText"
            Style="{StaticResource WorkspacePageTitleTextStyle}" />

        <Border
            Grid.Row="1"
            MinHeight="0"
            Style="{StaticResource SettingsDiagnosticsSurfaceStyle}">
            <Grid
                MinHeight="0"
                Padding="0">
                    <ScrollViewer
                        x:Name="WorkspaceSettingsPanel"
                        MinHeight="0"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <Border
                            Width="{Binding ViewportWidth, ElementName=WorkspaceSettingsPanel}"
                            Style="{StaticResource SettingsDiagnosticsContentColumnStyle}">
                            <StackPanel Spacing="14">
                                <Border Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="WorkspaceStatusTitleText"
                                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                            <TextBlock
                                                x:Name="WorkspaceStatusHintText"
                                                Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                                        </StackPanel>

                                        <Grid
                                            ColumnSpacing="14"
                                            RowSpacing="14"
                                            Visibility="{x:Bind ViewModel.ActiveWorkspaceVisibility, Mode=OneWay}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Style="{StaticResource SettingsDiagnosticsWorkspaceIconBadgeStyle}">
                                                <FontIcon
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="20"
                                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Glyph="&#xE838;"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel
                                                Grid.Column="1"
                                                MinWidth="0"
                                                VerticalAlignment="Center"
                                                Spacing="6">
                                                <TextBlock
                                                    FontSize="18"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind ViewModel.ActiveWorkspaceDisplayName, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <Border
                                                        Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource ExplorerTreeBadgeStyle}">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind ViewModel.ActiveWorkspacePrimaryBadgeText, Mode=OneWay}" />
                                                    </Border>

                                                    <Border
                                                        Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource ExplorerTreeBadgeStyle}"
                                                        Visibility="{x:Bind ViewModel.ActiveWorkspaceSecondaryBadgeVisibility, Mode=OneWay}">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind ViewModel.ActiveWorkspaceSecondaryBadgeText, Mode=OneWay}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="2"
                                                MaxWidth="220"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SettingsDiagnosticsMutedTextStyle}"
                                                Text="{x:Bind ViewModel.ActiveWorkspaceAvailabilitySummary, Mode=OneWay}"
                                                TextAlignment="Right"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind ViewModel.ActiveWorkspaceAvailabilityVisibility, Mode=OneWay}" />

                                            <Grid
                                                Grid.Row="1"
                                                Grid.ColumnSpan="3"
                                                ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Style="{StaticResource SettingsDiagnosticsWorkspaceSummaryTileStyle}">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <FontIcon
                                                            Style="{StaticResource SettingsDiagnosticsWorkspaceSummaryIconStyle}"
                                                            Glyph="&#xE8A5;" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            MinWidth="0"
                                                            MaxLines="2"
                                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                                            Text="{x:Bind ViewModel.ActiveWorkspaceSourceSummary, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>

                                                <Border
                                                    Grid.Column="1"
                                                    Style="{StaticResource SettingsDiagnosticsWorkspaceSummaryTileStyle}">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <FontIcon
                                                            Style="{StaticResource SettingsDiagnosticsWorkspaceSummaryIconStyle}"
                                                            Glyph="&#xE8B7;" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            MinWidth="0"
                                                            MaxLines="2"
                                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                                            Text="{x:Bind ViewModel.ActiveWorkspaceDataRootSummary, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>

                                                <Border
                                                    Grid.Column="2"
                                                    Style="{StaticResource SettingsDiagnosticsWorkspaceSummaryTileStyle}">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <FontIcon
                                                            Style="{StaticResource SettingsDiagnosticsWorkspaceSummaryIconStyle}"
                                                            Glyph="&#xE823;" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            MinWidth="0"
                                                            MaxLines="2"
                                                            Text="{x:Bind ViewModel.ActiveWorkspaceSessionSummary, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="WrapWholeWords" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <TextBlock
                                            x:Name="ActiveWorkspaceEmptyText"
                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                            Visibility="{x:Bind ViewModel.ActiveWorkspaceEmptyVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="WorkspaceCatalogTitleText"
                                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                            <TextBlock
                                                x:Name="WorkspaceCatalogHintText"
                                                Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                                        </StackPanel>

                                    <TextBlock
                                        Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                        Text="{x:Bind ViewModel.WorkspaceCatalogSummaryText, Mode=OneWay}" />

                                    <ItemsControl
                                        ItemsSource="{x:Bind ViewModel.WorkspaceEntries, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.WorkspaceEntryListVisibility, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:SettingsWorkspaceEntryItemViewModel">
                                                <Border
                                                    Margin="0,0,0,8"
                                                    Padding="12"
                                                    Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Text="{x:Bind DisplayName}"
                                                                TextTrimming="CharacterEllipsis" />

                                                            <StackPanel
                                                                Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                Spacing="6">
                                                                <Border
                                                                    Padding="8,3"
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource ExplorerTreeBadgeStyle}">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind PrimaryBadgeText}" />
                                                                </Border>
                                                                <Border
                                                                    Padding="8,3"
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource ExplorerTreeBadgeStyle}"
                                                                    Visibility="{x:Bind SecondaryBadgeVisibility}">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind SecondaryBadgeText}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock
                                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                                            Text="{x:Bind SourceSummary}" />
                                                        <TextBlock
                                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                                            Text="{x:Bind LastActivatedSummary}" />
                                                        <TextBlock
                                                            Style="{StaticResource SettingsDiagnosticsMutedTextStyle}"
                                                            Text="{x:Bind AvailabilitySummary}"
                                                            Visibility="{x:Bind AvailabilitySummaryVisibility}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock
                                        x:Name="WorkspaceCatalogEmptyText"
                                        Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}"
                                        Visibility="{x:Bind ViewModel.WorkspaceEntryEmptyVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <ContentControl
                        x:Name="PreferenceSettingsPanel"
                        MinHeight="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Visibility="Collapsed" />

                    <ContentControl
                        x:Name="PerformanceCacheSettingsPanel"
                        MinHeight="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Visibility="Collapsed" />

                    <Grid
                        x:Name="LogCenterPanel"
                        MinHeight="0"
                        Visibility="Collapsed">
                        <Border
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource SettingsDiagnosticsContentColumnStyle}">
                            <Border
                                Padding="18"
                                Style="{StaticResource SettingsDiagnosticsGroupCardStyle}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            x:Name="LogCenterTitleText"
                                            Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                                        <TextBlock
                                            x:Name="LogCenterHintText"
                                            Style="{StaticResource SettingsDiagnosticsSecondaryTextStyle}" />
                                    </StackPanel>

                                    <shared:LogPanel
                                        Grid.Row="1"
                                        MinHeight="0"
                                        ViewModel="{x:Bind ViewModel.LogPanel, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
        </Border>
    </Grid>
</Page>
