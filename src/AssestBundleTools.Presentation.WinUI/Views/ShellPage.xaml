<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AssestBundleTools.Presentation.WinUI.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:AssestBundleTools.Presentation.WinUI.Views.Shared"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid RowDefinitions="*,Auto">
        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="0"
            AlwaysShowHeader="False"
            Background="Transparent"
            CompactPaneLength="48"
            HorizontalContentAlignment="Stretch"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="280"
            PaneDisplayMode="Left"
            PaneClosing="OnNavigationPaneClosing"
            PaneOpened="OnNavigationPaneOpened"
            VerticalContentAlignment="Stretch"
            ItemInvoked="OnNavigationItemInvoked"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.Resources>
                <!-- 去掉 NavigationView 模板自带的内容大卡片背景与圆角，
                     让页面内容直接落在窗口材质上，避免出现多余的一层容器。 -->
                <SolidColorBrush
                    x:Key="NavigationViewContentBackground"
                    Color="Transparent" />
                <SolidColorBrush
                    x:Key="NavigationViewContentGridBorderBrush"
                    Color="Transparent" />
                <Thickness
                    x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius
                    x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="WorkbenchNavItem"
                    x:Uid="Shell.WorkbenchNavItem"
                    Tag="workbench">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="OpenFile" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="PluginManagementNavItem"
                    Tag="plugin-management">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="SettingsDiagnosticsNavItem"
                    x:Uid="Shell.SettingsDiagnosticsNavItem"
                    IsExpanded="True"
                    SelectsOnInvoked="False"
                    Tag="settings-diagnostics">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem
                            x:Name="SettingsWorkspaceNavItem"
                            Tag="settings-diagnostics-workspace">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="Folder" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            x:Name="SettingsPreferencesNavItem"
                            Tag="settings-diagnostics-preferences">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="Setting" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            x:Name="SettingsPerformanceCacheNavItem"
                            Tag="settings-diagnostics-performance-cache">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{StaticResource AppIconFontFamily}"
                                    Glyph="&#xF5FD;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            x:Name="SettingsLogsNavItem"
                            Tag="settings-diagnostics-logs">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{StaticResource AppIconFontFamily}"
                                    Glyph="&#xE4FE;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            x:Name="SettingsAboutNavItem"
                            Tag="settings-diagnostics-about">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{StaticResource AppIconFontFamily}"
                                    Glyph="&#xEA88;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="8,4,0,10">
                <Frame
                    x:Name="ContentFrame"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Grid>
        </NavigationView>

        <shared:AppNotificationPresenter
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            NotificationService="{x:Bind NotificationService, Mode=OneWay}" />

        <Border
            x:Name="AppStatusBar"
            Grid.Row="1"
            Height="28"
            Background="{ThemeResource LayerFillColorAltBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid
                ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                ColumnSpacing="10"
                Padding="12,0">
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="7">
                    <FontIcon
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{Binding StatusGlyph, Mode=OneWay}" />
                    <TextBlock
                        MaxWidth="480"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding StatusText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    x:Name="BackgroundTaskSummaryRegion"
                    Grid.Column="2"
                    MinWidth="82"
                    Height="22"
                    MinHeight="22"
                    Padding="6,0"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="{Binding TaskSummaryToolTipText}"
                    AutomationProperties.Name="{Binding TaskSummaryAutomationName}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="OnBackgroundTaskSummaryClick"
                    CornerRadius="4"
                    DataContext="{x:Bind BackgroundTasks, Mode=OneWay}"
                    PointerEntered="OnBackgroundTaskSummaryPointerEntered"
                    PointerExited="OnBackgroundTaskSummaryPointerExited"
                    Visibility="{Binding TaskSummaryVisibility}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="5">
                        <FontIcon
                            FontFamily="{StaticResource AppIconFontFamily}"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE508;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding TaskCountText}" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="3"
                    Width="20"
                    Height="20"
                    MinWidth="20"
                    MinHeight="20"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind CancelBackgroundTaskToolTipText, Mode=OneTime}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Click="OnCancelBackgroundTaskButtonClick"
                    IsEnabled="{Binding CanCancelCurrentTask, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind CancelBackgroundTaskToolTipText, Mode=OneTime}"
                    Visibility="{Binding CancelVisibility, Mode=OneWay}">
                    <FontIcon
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="10"
                        Glyph="&#xE6D3;" />
                </Button>

                <ProgressBar
                    Grid.Column="4"
                    Width="150"
                    Height="3"
                    VerticalAlignment="Center"
                    IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding ProgressValue, Mode=OneWay}"
                    Visibility="{Binding ProgressVisibility, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="5"
                    MinWidth="44"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding ProgressText, Mode=OneWay}"
                    TextAlignment="Right" />
            </Grid>
        </Border>

        <Border
            x:Name="BackgroundTasksPanelHost"
            Grid.RowSpan="2"
            Width="390"
            Margin="0,0,58,34"
            Padding="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="20"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            DataContext="{x:Bind BackgroundTasks, Mode=OneWay}"
            PointerEntered="OnBackgroundTasksPanelPointerEntered"
            PointerExited="OnBackgroundTasksPanelPointerExited"
            Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding PanelTitle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding EmptyText}"
                    Visibility="{Binding EmptyVisibility}" />
                <ScrollViewer
                    MaxHeight="330"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="10,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto,Auto"
                                        ColumnSpacing="8"
                                        RowDefinitions="Auto,Auto,Auto">
                                        <FontIcon
                                            Grid.RowSpan="2"
                                            Width="18"
                                            Margin="0,2,0,0"
                                            HorizontalAlignment="Center"
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{Binding StatusGlyph}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Grid.Column="2"
                                            Padding="6,1"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="3">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding StatusText}" />
                                        </Border>
                                        <Button
                                            Grid.Column="3"
                                            Grid.RowSpan="3"
                                            Width="20"
                                            Height="20"
                                            MinWidth="20"
                                            MinHeight="20"
                                            Padding="0"
                                            AutomationProperties.Name="{Binding CancelToolTipText}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding CancelCommand}"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="{Binding CancelToolTipText}"
                                            Visibility="{Binding CancelVisibility}">
                                            <FontIcon
                                                FontFamily="{StaticResource AppIconFontFamily}"
                                                FontSize="10"
                                                Glyph="&#xE6D3;" />
                                        </Button>
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding DetailText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <ProgressBar
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Height="3"
                                            Margin="0,8,0,0"
                                            VerticalAlignment="Center"
                                            IsIndeterminate="{Binding IsProgressIndeterminate}"
                                            Maximum="100"
                                            Minimum="0"
                                            Value="{Binding ProgressValue}"
                                            Visibility="{Binding ProgressVisibility}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Grid.ColumnSpan="2"
                                            Margin="0,4,0,0"
                                            MinWidth="42"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ProgressText}"
                                            TextAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
