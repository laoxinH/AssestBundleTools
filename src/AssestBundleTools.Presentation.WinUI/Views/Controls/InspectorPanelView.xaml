<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.Controls.InspectorPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer"
    mc:Ignorable="d">

    <Grid>
        <Border
            Padding="14"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="10"
            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="EmptyStateTitleText"
                    Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <Grid
            MinHeight="0"
            Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabView
                    Grid.Row="0"
                    MinHeight="0"
                    IsAddTabButtonVisible="False">
                    <TabView.TabItems>
                        <TabViewItem x:Name="OverviewTab">
                            <ScrollViewer>
                                <StackPanel Padding="8" Spacing="8">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AssetNameLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AssetName, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AssetTypeLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AssetTypeText, Mode=OneWay}" />
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="BundleLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BundleDisplayName, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AssetPathLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AssetPath, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                            </Grid>

                                            <Grid
                                                ColumnSpacing="8"
                                                Visibility="{x:Bind ViewModel.ContainerPathVisibility, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ContainerPathLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ContainerPath, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AssetSizeLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SizeText, Mode=OneWay}" />
                                            </Grid>

                                            <Grid
                                                ColumnSpacing="8"
                                                Visibility="{x:Bind ViewModel.PathIdVisibility, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="PathIdLabelText" FontWeight="SemiBold" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontFamily="Cascadia Mono"
                                                    Text="{x:Bind ViewModel.PathIdText, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>

                        <TabViewItem x:Name="PreviewTab">
                            <ScrollViewer>
                                <StackPanel Padding="8" Spacing="8">
                                    <Border
                                        Height="320"
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="12">
                                        <Grid>
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="10"
                                                Visibility="{x:Bind ViewModel.PreviewLoadingVisibility, Mode=OneWay}">
                                                <ProgressRing
                                                    Width="30"
                                                    Height="30"
                                                    IsActive="True" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.PreviewStatusText, Mode=OneWay}"
                                                    TextAlignment="Center"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>

                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="10"
                                                Visibility="{x:Bind ViewModel.PreviewMessageVisibility, Mode=OneWay}">
                                                <FontIcon
                                                    FontFamily="Segoe Fluent Icons"
                                                    Glyph="&#xE7BA;"
                                                    FontSize="26" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.PreviewStatusText, Mode=OneWay}"
                                                    TextAlignment="Center"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>

                                            <Grid
                                                Margin="8"
                                                Visibility="{x:Bind ViewModel.PreviewImageVisibility, Mode=OneWay}">
                                                <Image
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Stretch="Uniform"
                                                    Source="{x:Bind ViewModel.PreviewImageSource, Mode=OneWay}" />
                                            </Grid>

                                            <ScrollViewer
                                                HorizontalScrollBarVisibility="Auto"
                                                HorizontalScrollMode="Enabled"
                                                VerticalScrollBarVisibility="Auto"
                                                VerticalScrollMode="Enabled"
                                                ZoomMode="Disabled"
                                                Visibility="{x:Bind ViewModel.PreviewTextVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    FontFamily="Cascadia Mono"
                                                    FontSize="13"
                                                    Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </ScrollViewer>

                                            <ScrollViewer
                                                HorizontalScrollBarVisibility="Disabled"
                                                HorizontalScrollMode="Disabled"
                                                VerticalScrollBarVisibility="Auto"
                                                VerticalScrollMode="Enabled"
                                                ZoomMode="Disabled"
                                                Visibility="{x:Bind ViewModel.PreviewSummaryVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords" />
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.PreviewInfoVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="PreviewInfoSectionTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.PreviewInfoText, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.PreviewDiagnosticVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="PreviewDiagnosticTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                            <Grid
                                                ColumnSpacing="8"
                                                Visibility="{x:Bind ViewModel.PreviewCacheStatusVisibility, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="PreviewCacheStatusLabelText" FontWeight="SemiBold" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind ViewModel.PreviewCacheStatusText, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Grid>

                                            <Grid
                                                ColumnSpacing="8"
                                                Visibility="{x:Bind ViewModel.PreviewFallbackReasonVisibility, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="PreviewFallbackReasonLabelText" FontWeight="SemiBold" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind ViewModel.PreviewFallbackReasonText, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Grid>

                                            <Grid
                                                ColumnSpacing="8"
                                                Visibility="{x:Bind ViewModel.PreviewDiagnosticDetailVisibility, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="PreviewDiagnosticDetailLabelText" FontWeight="SemiBold" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind ViewModel.PreviewDiagnosticDetailText, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>

                        <TabViewItem x:Name="DependenciesTab">
                            <ScrollViewer>
                                <StackPanel Padding="8" Spacing="8">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.AssetDependenciesVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="AssetDependenciesTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.AssetDependencies, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AssetDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind Name, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind BundleName, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind MetadataText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind SupplementaryText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords"
                                                                    Visibility="{x:Bind SupplementaryVisibility, Mode=OneTime}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.ReferencedByDependenciesVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="ReferencedByTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.ReferencedByDependencies, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AssetDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind Name, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind BundleName, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind MetadataText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind SupplementaryText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords"
                                                                    Visibility="{x:Bind SupplementaryVisibility, Mode=OneTime}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.DependencyClosureVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="DependencyClosureTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.DependencyClosureItems, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AssetDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind Name, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind BundleName, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind MetadataText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind SupplementaryText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords"
                                                                    Visibility="{x:Bind SupplementaryVisibility, Mode=OneTime}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.BundleExternalDependenciesVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="BundleExternalDependenciesTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.BundleExternalDependencies, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:BundleExternalDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind DisplayName, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind KindText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    FontFamily="Cascadia Mono"
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind ReferencePath, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.DependenciesEmptyStateVisibility, Mode=OneWay}">
                                        <TextBlock
                                            x:Name="DependenciesEmptyStateText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="WrapWholeWords" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>

                        <TabViewItem x:Name="ReplacementTab">
                            <ScrollViewer>
                                <StackPanel Padding="8" Spacing="8">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="ReplacementTargetTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.AssetName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.BundleDisplayName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.AssetTypeText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="ReplacementSourceTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.ReplacementSourceText, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <Button
                                                x:Name="SelectFileReplacementButton"
                                                HorizontalAlignment="Left"
                                                Click="OnSelectFileReplacementButtonClick"
                                                IsEnabled="{x:Bind ViewModel.CanSelectFileReplacementSource, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="ReplacementCompatibilityTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ExtractCapabilityLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ExtractCapabilityText, Mode=OneWay}" />
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="FileReplacementCapabilityLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FileReplacementCapabilityText, Mode=OneWay}" />
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="WorkspaceReplacementCapabilityLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WorkspaceReplacementCapabilityText, Mode=OneWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.ReplacementStatusText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>

                        <TabViewItem x:Name="ChangesTab">
                            <ScrollViewer>
                                <StackPanel Padding="8" Spacing="8">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="ChangeSummaryTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.AssetName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.BundleDisplayName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.ChangeSummaryText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>
                    </TabView.TabItems>
                </TabView>

                <Border
                    Grid.Row="1"
                    Margin="8,0,8,8"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ExtractButton"
                                Click="OnExtractButtonClick"
                                IsEnabled="{x:Bind ViewModel.CanExtract, Mode=OneWay}" />
                            <Button
                                x:Name="SelectReplacementButton"
                                Click="OnSelectReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.CanSelectReplacementSource, Mode=OneWay}" />
                            <Button
                                x:Name="ApplyReplacementButton"
                                Click="OnApplyReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.CanApplyReplacement, Mode=OneWay}" />
                            <Button
                                x:Name="UndoReplacementButton"
                                Click="OnUndoReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.CanUndoReplacement, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
