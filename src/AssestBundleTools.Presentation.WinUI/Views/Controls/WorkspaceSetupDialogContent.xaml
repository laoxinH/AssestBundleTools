<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.Controls.WorkspaceSetupDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    MaxWidth="600"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="WorkspaceFieldValidationTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style
            x:Key="WorkspaceSetupSecondaryTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="WorkspaceSetupCardStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style
            x:Key="WorkspaceSetupRowIconStyle"
            TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style
            x:Key="WorkspaceSetupBrowseButtonStyle"
            TargetType="Button">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style
            x:Key="WorkspaceSetupOptionCardStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="FormScrollViewer"
        MaxHeight="560"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <TextBlock
                x:Name="DescriptionText"
                MaxLines="2"
                Style="{StaticResource WorkspaceSetupSecondaryTextStyle}" />

            <Border Style="{StaticResource WorkspaceSetupCardStyle}">
                <StackPanel>
                    <Grid
                        Padding="16"
                        ColumnSpacing="14"
                        RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource WorkspaceSetupRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="16"
                                Glyph="&#xE8B7;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="DataRootPathFieldLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="DataRootSectionHintText"
                                MaxLines="2"
                                Style="{StaticResource WorkspaceSetupSecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="6">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="DataRootPathTextBox"
                                    MinHeight="36"
                                    TextChanged="OnDataRootPathTextChanged" />

                                <Button
                                    x:Name="BrowseDataRootButton"
                                    Grid.Column="1"
                                    Click="OnBrowseDataRootButtonClick"
                                    Style="{StaticResource WorkspaceSetupBrowseButtonStyle}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Glyph="&#xE838;" />
                                        <TextBlock
                                            x:Name="BrowseDataRootButtonText"
                                            FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock
                                x:Name="DataRootValidationTextBlock"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource WorkspaceFieldValidationTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource WorkspaceSetupRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xE8AC;" />
                        </Border>

                        <TextBlock
                            x:Name="WorkspaceNameFieldLabelText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource WorkspaceSectionTitleTextStyle}" />

                        <TextBox
                            x:Name="WorkspaceDisplayNameTextBox"
                            Grid.Column="2"
                            MinHeight="36"
                            TextChanged="OnWorkspaceDisplayNameTextChanged" />

                        <TextBlock
                            x:Name="WorkspaceNameValidationTextBlock"
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource WorkspaceFieldValidationTextStyle}" />
                    </Grid>

                    <Border
                        Height="1"
                        Margin="64,0,0,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid
                        Padding="16"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource WorkspaceSetupRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xE72E;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="DecryptorFieldLabelText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="DecryptorDescriptionTextBlock"
                                MaxLines="2"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource WorkspaceSetupSecondaryTextStyle}" />
                        </StackPanel>

                        <ComboBox
                            x:Name="DecryptorComboBox"
                            Grid.Column="2"
                            MinHeight="36"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="OnDecryptorSelectionChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Style="{StaticResource WorkspaceSetupCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource WorkspaceSetupRowIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xE7F4;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                x:Name="OpenTargetSectionTitleText"
                                Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="OpenTargetSectionHintText"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource WorkspaceSetupSecondaryTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="CurrentWindowOptionBorder"
                            Style="{StaticResource WorkspaceSetupOptionCardStyle}">
                            <RadioButton
                                x:Name="CurrentWindowRadioButton"
                                GroupName="WorkspaceOpenTarget"
                                Checked="OnOpenTargetChecked">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Name="CurrentWindowOptionTitleText"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        x:Name="CurrentWindowOptionDescriptionText"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource WorkspaceSetupSecondaryTextStyle}" />
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <Border
                            x:Name="NewWindowOptionBorder"
                            Grid.Column="1"
                            Style="{StaticResource WorkspaceSetupOptionCardStyle}">
                            <RadioButton
                                x:Name="NewWindowRadioButton"
                                GroupName="WorkspaceOpenTarget"
                                Checked="OnOpenTargetChecked">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Name="NewWindowOptionTitleText"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        x:Name="NewWindowOptionDescriptionText"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource WorkspaceSetupSecondaryTextStyle}" />
                                </StackPanel>
                            </RadioButton>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
