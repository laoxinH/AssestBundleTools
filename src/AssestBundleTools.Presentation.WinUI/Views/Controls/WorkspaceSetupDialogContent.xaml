<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.Controls.WorkspaceSetupDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="WorkspaceFieldValidationTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="12" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
            <Setter
                Property="Visibility"
                Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="FormScrollViewer"
        MaxHeight="640"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <TextBlock
                x:Name="DescriptionText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="WrapWholeWords" />

            <Border
                Style="{StaticResource SettingsInsetCardStyle}"
                Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="DataRootSectionTitleText"
                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                    <TextBlock
                        x:Name="DataRootSectionHintText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />

                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="DataRootPathFieldLabelText"
                            Style="{StaticResource WorkspaceFieldLabelTextStyle}" />
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="DataRootPathTextBox"
                                    TextChanged="OnDataRootPathTextChanged" />

                                <Button
                                    x:Name="BrowseDataRootButton"
                                    Grid.Column="1"
                                    Style="{StaticResource WorkspaceCommandButtonStyle}"
                                    Click="OnBrowseDataRootButtonClick">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <FontIcon
                                            Glyph="&#xE838;"
                                            FontSize="14" />
                                        <TextBlock
                                            x:Name="BrowseDataRootButtonText"
                                            FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock
                                x:Name="DataRootValidationTextBlock"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource WorkspaceFieldValidationTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="WorkspaceNameFieldLabelText"
                            Style="{StaticResource WorkspaceFieldLabelTextStyle}" />
                        <StackPanel Spacing="6">
                            <TextBox
                                x:Name="WorkspaceDisplayNameTextBox"
                                TextChanged="OnWorkspaceDisplayNameTextChanged" />
                            <TextBlock
                                x:Name="WorkspaceNameValidationTextBlock"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource WorkspaceFieldValidationTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="DecryptorFieldLabelText"
                            Style="{StaticResource WorkspaceFieldLabelTextStyle}" />
                        <StackPanel Spacing="6">
                            <ComboBox
                                x:Name="DecryptorComboBox"
                                SelectionChanged="OnDecryptorSelectionChanged" />
                            <TextBlock
                                x:Name="DecryptorDescriptionTextBlock"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Style="{StaticResource SettingsInsetCardStyle}"
                Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="OpenTargetSectionTitleText"
                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                    <TextBlock
                        x:Name="OpenTargetSectionHintText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="CurrentWindowOptionBorder"
                            CornerRadius="14"
                            Padding="14"
                            BorderThickness="1">
                            <RadioButton
                                x:Name="CurrentWindowRadioButton"
                                GroupName="WorkspaceOpenTarget"
                                Checked="OnOpenTargetChecked">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="CurrentWindowOptionTitleText"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        x:Name="CurrentWindowOptionDescriptionText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <Border
                            x:Name="NewWindowOptionBorder"
                            Grid.Column="1"
                            CornerRadius="14"
                            Padding="14"
                            BorderThickness="1">
                            <RadioButton
                                x:Name="NewWindowRadioButton"
                                GroupName="WorkspaceOpenTarget"
                                Checked="OnOpenTargetChecked">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="NewWindowOptionTitleText"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        x:Name="NewWindowOptionDescriptionText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </RadioButton>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Style="{StaticResource SettingsInsetCardStyle}"
                Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="SummarySectionTitleText"
                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="SummaryWorkspaceNameLabelText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="SummaryWorkspaceNameValueText"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            x:Name="SummaryDecryptorLabelText"
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="SummaryDecryptorValueText"
                            Grid.Row="1"
                            Grid.Column="1"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            x:Name="SummaryDataRootPathLabelText"
                            Grid.Row="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="SummaryDataRootPathValueText"
                            Grid.Row="2"
                            Grid.Column="1"
                            TextWrapping="WrapWholeWords" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
