<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.Controls.AssetPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer"
    mc:Ignorable="d">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock
                    x:Name="CurrentBundleLabelText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.CurrentBundleDisplayName, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </StackPanel>

        <Grid
            Grid.Row="1"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchTextBox"
                Text="{x:Bind ViewModel.SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="OnSearchTextChanged" />

            <ComboBox
                x:Name="FilterComboBox"
                Grid.Column="1"
                ItemsSource="{x:Bind ViewModel.AssetTypeOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedAssetTypeOption, Mode=TwoWay}"
                SelectionChanged="OnFilterSelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AssetTypeOptionViewModel">
                        <TextBlock Text="{x:Bind DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ToggleButton
                x:Name="ModifiedOnlyToggleButton"
                Grid.Column="2"
                IsChecked="{x:Bind ViewModel.ShowModifiedOnly, Mode=TwoWay}"
                MinWidth="96" />

            <ToggleButton
                x:Name="PreviewOnlyToggleButton"
                Grid.Column="3"
                IsChecked="{x:Bind ViewModel.ShowPreviewableOnly, Mode=TwoWay}"
                MinWidth="96" />
        </Grid>

        <Grid
            Grid.Row="2"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.MultiSelectionQuickActionsVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="10,7"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="8">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBlock
                        x:Name="MultiSelectionLabelText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.SelectedAssetCount, Mode=OneWay}" />
                    <TextBlock
                        x:Name="MultiSelectionUnitText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Button
                x:Name="BatchExtractSelectedButton"
                Grid.Column="1"
                Click="OnBatchExtractSelectedButtonClick"
                IsEnabled="{x:Bind ViewModel.CanBatchExtractSelectedAssets, Mode=OneWay}" />
        </Grid>

        <Grid
            Grid.Row="3"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="AssetNameHeaderText"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="AssetTypeHeaderText"
                Grid.Column="1"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="AssetSizeHeaderText"
                Grid.Column="2"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="AssetStateHeaderText"
                Grid.Column="3"
                FontWeight="SemiBold" />
        </Grid>

        <Grid Grid.Row="4">
            <ListView
                x:Name="AssetListView"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedAsset, Mode=TwoWay}"
                SelectionMode="Extended"
                SelectionChanged="OnAssetListSelectionChanged"
                Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AssetListEntryViewModel">
                        <Grid
                            Padding="4,5"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="{x:Bind Item.Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Item.AssetPath}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind AssetTypeText}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind SizeText}" />
                            <TextBlock
                                Grid.Column="3"
                                Text="{x:Bind StateText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="10"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="EmptyStateHintText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
