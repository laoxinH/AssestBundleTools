<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.WorkspaceBatchExtractionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:AssestBundleTools.Presentation.WinUI.Views.Shared"
    mc:Ignorable="d">

    <Grid
        x:Name="ContentRoot"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ThemeShadow x:Key="BatchExtractionCardShadow" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="LeftInsetColumn"
                    Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition
                    x:Name="RightInsetColumn"
                    Width="0" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="1"
                Padding="14,0"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource AppIconFontFamily}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8EB;" />
                <TextBlock
                    x:Name="TitleBarText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>

        <Grid
            Grid.Row="1"
            MinHeight="0"
            Padding="48,14,48,20"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="48"
                    Height="48"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="12">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="26"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE6E9;" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <TextBlock
                        x:Name="WindowTitleText"
                        FontSize="28"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="WindowSubtitleText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="13"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>

            <ContentControl
                x:Name="ContentHost"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                MinHeight="0" />

            <Border
                Grid.Row="2"
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Shadow="{StaticResource BatchExtractionCardShadow}"
                Translation="0,0,4">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                        CornerRadius="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource AppIconFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE6E9;" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="PlanSummaryTitleText"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold" />
                            <ProgressRing
                                Grid.Column="1"
                                Width="18"
                                Height="18"
                                IsActive="{Binding IsPreviewLoading}"
                                Visibility="{Binding PreviewLoadingVisibility}" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="2"
                            Text="{Binding PlanSummaryText}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            MaxLines="1"
                            Text="{Binding ValidationText}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding ValidationVisibility}" />
                    </StackPanel>

                    <CheckBox
                        x:Name="UseWorkspaceExtractionDirectoryCheckBox"
                        Grid.Column="2"
                        MaxWidth="320"
                        MinWidth="0"
                        FontSize="13"
                        VerticalAlignment="Center"
                        IsChecked="{Binding UseWorkspaceExtractionDirectory, Mode=TwoWay}" />

                    <Button
                        x:Name="CancelButton"
                        Grid.Column="3"
                        Width="118"
                        MinHeight="38"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Click="OnCancelButtonClick" />
                    <Button
                        x:Name="StartExtractionButton"
                        Grid.Column="4"
                        Width="160"
                        MinHeight="38"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Click="OnStartExtractionButtonClick"
                        IsEnabled="{Binding CanSubmit}"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>
        </Grid>

        <shared:AppNotificationPresenter
            Grid.RowSpan="2"
            NotificationService="{x:Bind NotificationService, Mode=OneWay}" />
    </Grid>
</Window>
