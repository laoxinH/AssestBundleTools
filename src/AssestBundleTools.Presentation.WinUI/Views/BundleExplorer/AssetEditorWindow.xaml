<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.AssetEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:AssestBundleTools.Presentation.WinUI.Views.Shared"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Background="Transparent"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1" Padding="14,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource AppIconFontFamily}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE6E9;" />
                <TextBlock
                    x:Name="TitleBarText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>

        <Grid
            x:Name="ContentRoot"
            Grid.Row="1"
            AllowDrop="True"
            Padding="14"
            Background="Transparent"
            DragEnter="OnAssetDocumentGroupDragEnter"
            DragLeave="OnAssetDocumentGroupDragLeave"
            DragOver="OnAssetDocumentGroupDragOver"
            Drop="OnAssetDocumentGroupDrop"
            Loaded="OnContentRootLoaded"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="AssetEditorGroupDragHandle"
                    Width="30"
                    Height="30"
                    CanDrag="{x:Bind ViewModel.DocumentGroup.HasDocumentTabs, Mode=OneWay}"
                    Background="Transparent"
                    CornerRadius="6"
                    DragStarting="OnAssetDocumentGroupDragStarting"
                    DropCompleted="OnAssetDocumentGroupDropCompleted"
                    Visibility="{x:Bind ViewModel.DocumentGroup.TabStripVisibility, Mode=OneWay}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="12"
                        Glyph="&#xEC9A;" />
                </Border>

                <TabView
                    x:Name="AssetEditorTabView"
                    Grid.Column="1"
                    Margin="-2,-2,-2,0"
                    AllowDropTabs="True"
                    CanDragTabs="True"
                    CanReorderTabs="True"
                    IsAddTabButtonVisible="False"
                    SelectedItem="{x:Bind ViewModel.DocumentGroup.ActiveDocumentTab, Mode=OneWay}"
                    TabCloseRequested="OnAssetEditorTabViewTabCloseRequested"
                    TabDragCompleted="OnAssetEditorTabViewTabDragCompleted"
                    TabDragStarting="OnAssetEditorTabViewTabDragStarting"
                    TabDroppedOutside="OnAssetEditorTabViewTabDroppedOutside"
                    TabItemsSource="{x:Bind ViewModel.DocumentGroup.DocumentTabs, Mode=OneWay}"
                    TabStripDragOver="OnAssetEditorTabViewTabStripDragOver"
                    TabStripDrop="OnAssetEditorTabViewTabStripDrop"
                    SelectionChanged="OnAssetEditorTabViewSelectionChanged"
                    Visibility="{x:Bind ViewModel.DocumentGroup.TabStripVisibility, Mode=OneWay}">
                <TabView.TabItemTemplate>
                    <DataTemplate x:DataType="viewModels:AssetDocumentTabItemViewModel">
                        <TabViewItem
                            ToolTipService.ToolTip="{x:Bind ToolTipText}">
                            <TabViewItem.Header>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="4"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="2"
                                        Visibility="{x:Bind SpineMarkerVisibility}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind DisplayName}" />
                                </Grid>
                            </TabViewItem.Header>
                            <TabViewItem.ContextFlyout>
                                <MenuFlyout Opening="OnAssetEditorTabContextFlyoutOpening">
                                    <MenuFlyoutItem
                                        x:Name="MoveAssetDocumentToMainWindowMenuItem"
                                        Click="OnMoveAssetDocumentToMainWindowMenuItemClick"
                                        Tag="{Binding}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Name="CloseAssetDocumentTabMenuItem"
                                        Click="OnCloseAssetDocumentTabMenuItemClick"
                                        Tag="{Binding}" />
                                </MenuFlyout>
                            </TabViewItem.ContextFlyout>
                        </TabViewItem>
                    </DataTemplate>
                </TabView.TabItemTemplate>
                </TabView>
            </Grid>

        <Grid
            Grid.Row="1"
            MinHeight="0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="380" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Grid MinHeight="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="340" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:InspectorPreviewSurfaceView
                    MinHeight="340"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AvailablePreviewSurfaceMinHeight="340"
                    FixedPreviewSurfaceHeight="520"
                    UseAvailablePreviewSpace="True"
                    Visibility="{x:Bind ViewModel.PreviewSurfaceVisibility, Mode=OneWay}"
                    ViewModel="{x:Bind ViewModel.Inspector, Mode=OneWay}"
                    LoadMoreTextRequested="OnPreviewSurfaceLoadMoreTextRequested"
                    OpenPreviewLocationRequested="OnPreviewSurfaceOpenPreviewLocationRequested"
                    ResolvedAssetOpenRequested="OnResolvedAssetOpenRequested" />

                <controls:TextAssetEditDraftView
                    x:Name="TextEditDraftView"
                    MinHeight="340"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.TextEditPanelVisibility, Mode=OneWay}"
                    ViewModel="{x:Bind ViewModel.ActiveTextEditDraft, Mode=OneWay}"
                    SaveRequested="OnTextEditSaveRequested" />

                <controls:SpriteEditGeometryPanelView
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Visibility="{x:Bind ViewModel.Inspector.Preview.Image.SpriteEditGeometryPanelVisibility, Mode=OneWay}"
                    ViewModel="{x:Bind ViewModel.Inspector.Preview.Image, Mode=OneWay}" />

                <Border
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="0,2"
                    Background="Transparent">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled">
                        <Grid>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="0"
                                Visibility="{x:Bind ViewModel.NormalActionBarVisibility, Mode=OneWay}">
                                <Button
                                    x:Name="ExtractButton"
                                    Click="OnExtractButtonClick"
                                    IsEnabled="{x:Bind ViewModel.Inspector.CanExtract, Mode=OneWay}"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="&#xE0DD;" />
                                        <TextBlock x:Name="ExtractButtonText" />
                                    </StackPanel>
                                </Button>

                                <Border
                                    Width="1"
                                    Height="16"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                                <Button
                                    x:Name="ModifyButton"
                                    AutomationProperties.Name="{x:Bind ViewModel.Inspector.ModifyButtonText, Mode=OneWay}"
                                    Click="OnModifyButtonClick"
                                    IsEnabled="{x:Bind ViewModel.Inspector.CanModify, Mode=OneWay}"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.Inspector.ModifyButtonText, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="{x:Bind ViewModel.Inspector.ModifyButtonIconGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            x:Name="ModifyButtonText"
                                            Text="{x:Bind ViewModel.Inspector.ModifyButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>

                                <Border
                                    Width="1"
                                    Height="16"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind ViewModel.Inspector.EditButtonVisibility, Mode=OneWay}" />

                                <Button
                                    x:Name="EditTextButton"
                                    AutomationProperties.Name="{x:Bind ViewModel.Inspector.EditButtonText, Mode=OneWay}"
                                    Click="OnEditTextButtonClick"
                                    IsEnabled="{x:Bind ViewModel.Inspector.CanEditText, Mode=OneWay}"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.Inspector.EditButtonText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.Inspector.EditButtonVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="{x:Bind ViewModel.Inspector.EditButtonIconGlyph, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.Inspector.EditButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="0"
                                Visibility="{x:Bind ViewModel.SpriteEditActionBarVisibility, Mode=OneWay}">
                                <Button
                                    x:Name="ReplaceSpriteTextureButton"
                                    Click="OnReplaceSpriteTextureButtonClick"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="&#xEA6A;" />
                                        <TextBlock x:Name="ReplaceSpriteTextureButtonText" />
                                    </StackPanel>
                                </Button>

                                <Border
                                    Width="1"
                                    Height="16"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                                <Button
                                    x:Name="SaveSpriteEditButton"
                                    Click="OnSaveSpriteEditButtonClick"
                                    IsEnabled="{x:Bind ViewModel.Inspector.Preview.Image.CanSaveSpriteEdit, Mode=OneWay}"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="&#xEF99;" />
                                        <TextBlock x:Name="SaveSpriteEditButtonText" />
                                    </StackPanel>
                                </Button>

                                <Border
                                    Width="1"
                                    Height="16"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                                <Button
                                    x:Name="ExitSpriteEditButton"
                                    Click="OnExitSpriteEditButtonClick"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="&#xE115;" />
                                        <TextBlock x:Name="ExitSpriteEditButtonText" />
                                    </StackPanel>
                                </Button>

                                <Border
                                    Width="1"
                                    Height="16"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                                <Button
                                    x:Name="UndoSpriteEditButton"
                                    Click="OnUndoSpriteEditButtonClick"
                                    IsEnabled="{x:Bind ViewModel.Inspector.Preview.Image.CanUndoSpriteEdit, Mode=OneWay}"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="&#xE1A5;" />
                                        <TextBlock x:Name="UndoSpriteEditButtonText" />
                                    </StackPanel>
                                </Button>

                                <Border
                                    Width="1"
                                    Height="16"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                                <Button
                                    x:Name="RedoSpriteEditButton"
                                    Click="OnRedoSpriteEditButtonClick"
                                    IsEnabled="{x:Bind ViewModel.Inspector.Preview.Image.CanRedoSpriteEdit, Mode=OneWay}"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="&#xE131;" />
                                        <TextBlock x:Name="RedoSpriteEditButtonText" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="0"
                                Visibility="{x:Bind ViewModel.SpineEditActionBarVisibility, Mode=OneWay}">
                                <Button
                                    x:Name="SaveSpineEditButton"
                                    Click="OnSaveSpineEditButtonClick"
                                    IsEnabled="{x:Bind ViewModel.CanSaveSpineEdit, Mode=OneWay}"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="&#xEF99;" />
                                        <TextBlock x:Name="SaveSpineEditButtonText" />
                                    </StackPanel>
                                </Button>

                                <Border
                                    Width="1"
                                    Height="16"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                                <Button
                                    x:Name="ExitSpineEditButton"
                                    Click="OnExitSpineEditButtonClick"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="&#xE115;" />
                                        <TextBlock x:Name="ExitSpineEditButtonText" />
                                    </StackPanel>
                                </Button>

                                <Border
                                    Width="1"
                                    Height="16"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                                <Button
                                    x:Name="UndoSpineEditButton"
                                    Click="OnUndoSpineEditButtonClick"
                                    IsEnabled="{x:Bind ViewModel.CanUndoSpineEdit, Mode=OneWay}"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="&#xE1A5;" />
                                        <TextBlock x:Name="UndoSpineEditButtonText" />
                                    </StackPanel>
                                </Button>

                                <Border
                                    Width="1"
                                    Height="16"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                                <Button
                                    x:Name="RedoSpineEditButton"
                                    Click="OnRedoSpineEditButtonClick"
                                    IsEnabled="{x:Bind ViewModel.CanRedoSpineEdit, Mode=OneWay}"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="&#xE131;" />
                                        <TextBlock x:Name="RedoSpineEditButtonText" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="0"
                                Visibility="{x:Bind ViewModel.TextEditActionBarVisibility, Mode=OneWay}">
                                <Button
                                    x:Name="SaveTextEditButton"
                                    Click="OnSaveTextEditButtonClick"
                                    IsEnabled="{x:Bind ViewModel.CanSaveTextEdit, Mode=OneWay}"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <ProgressRing
                                            Width="12"
                                            Height="12"
                                            IsActive="{x:Bind ViewModel.IsTextEditBusy, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.TextEditBusyVisibility, Mode=OneWay}" />
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="&#xEF99;"
                                            Visibility="{x:Bind ViewModel.SaveTextEditIconVisibility, Mode=OneWay}" />
                                        <TextBlock x:Name="SaveTextEditButtonText" />
                                    </StackPanel>
                                </Button>

                                <Border
                                    Width="1"
                                    Height="16"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                                <Button
                                    x:Name="ExitTextEditButton"
                                    Click="OnExitTextEditButtonClick"
                                    Style="{StaticResource WorkspaceOperationButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="12"
                                            Glyph="&#xE115;" />
                                        <TextBlock x:Name="ExitTextEditButtonText" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border
                Grid.Column="1"
                Padding="10"
                Style="{StaticResource SettingsSectionCardStyle}">
                <controls:InspectorPanelView
                    ShowActionBar="False"
                    ShowDetailsPreview="False"
                    SpineEditDraft="{x:Bind ViewModel.ActiveSpineEditDraft, Mode=OneWay}"
                    SpineEditPanelVisibility="{x:Bind ViewModel.SpineEditPanelVisibility, Mode=OneWay}"
                    ViewModel="{x:Bind ViewModel.Inspector, Mode=OneWay}"
                    ApplyReplacementRequested="OnInspectorApplyReplacementRequested"
                    ExtractRequested="OnInspectorExtractRequested"
                    EditRequested="OnInspectorEditRequested"
                    ModifyFromFileReplacementSourceRequested="OnInspectorModifyFromFileReplacementSourceRequested"
                    LoadMoreTextRequested="OnInspectorLoadMoreTextRequested"
                    OpenPreviewLocationRequested="OnInspectorOpenPreviewLocationRequested"
                    RedoReplacementRequested="OnInspectorRedoReplacementRequested"
                    DeleteChangeRecordRequested="OnInspectorDeleteChangeRecordRequested"
                    ResolvedAssetOpenRequested="OnResolvedAssetOpenRequested"
                    SelectFileReplacementSourceRequested="OnInspectorSelectFileReplacementSourceRequested"
                    SpineEditBatchMatchRequested="OnSpineEditBatchMatchRequested"
                    SpineEditPartFileSelectionRequested="OnSpineEditPartFileSelectionRequested"
                    UndoReplacementRequested="OnInspectorUndoReplacementRequested"
                    SpineAtlasPageSelectionRequested="OnInspectorSpineAtlasPageSelectionRequested" />
            </Border>
        </Grid>

        <Grid
            x:Name="AssetDocumentGroupDropPreviewOverlay"
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="12"
                Opacity="0.08" />
            <Border
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="12" />
        </Grid>

        <shared:AppNotificationPresenter
            Grid.RowSpan="2"
            NotificationService="{x:Bind ViewModel.NotificationService, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
