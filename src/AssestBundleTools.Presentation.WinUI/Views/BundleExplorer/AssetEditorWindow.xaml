<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.AssetEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <Grid
        x:Name="ContentRoot"
        AllowDrop="True"
        Padding="14"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        DragEnter="OnAssetDocumentGroupDragEnter"
        DragLeave="OnAssetDocumentGroupDragLeave"
        DragOver="OnAssetDocumentGroupDragOver"
        Drop="OnAssetDocumentGroupDrop"
        Loaded="OnContentRootLoaded"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="AssetEditorGroupDragHandle"
                Width="30"
                Height="30"
                CanDrag="{x:Bind ViewModel.DocumentGroup.HasDocumentTabs, Mode=OneWay}"
                Background="Transparent"
                CornerRadius="6"
                DragStarting="OnAssetDocumentGroupDragStarting"
                DropCompleted="OnAssetDocumentGroupDropCompleted"
                Visibility="{x:Bind ViewModel.DocumentGroup.TabStripVisibility, Mode=OneWay}">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="12"
                    Glyph="&#xE700;" />
            </Border>

            <TabView
                x:Name="AssetEditorTabView"
                Grid.Column="1"
                Margin="-2,-2,-2,0"
                AllowDropTabs="True"
                CanDragTabs="True"
                CanReorderTabs="True"
                IsAddTabButtonVisible="False"
                SelectedItem="{x:Bind ViewModel.DocumentGroup.ActiveDocumentTab, Mode=OneWay}"
                TabCloseRequested="OnAssetEditorTabViewTabCloseRequested"
                TabDragCompleted="OnAssetEditorTabViewTabDragCompleted"
                TabDragStarting="OnAssetEditorTabViewTabDragStarting"
                TabDroppedOutside="OnAssetEditorTabViewTabDroppedOutside"
                TabItemsSource="{x:Bind ViewModel.DocumentGroup.DocumentTabs, Mode=OneWay}"
                TabStripDragOver="OnAssetEditorTabViewTabStripDragOver"
                TabStripDrop="OnAssetEditorTabViewTabStripDrop"
                SelectionChanged="OnAssetEditorTabViewSelectionChanged"
                Visibility="{x:Bind ViewModel.DocumentGroup.TabStripVisibility, Mode=OneWay}">
                <TabView.TabItemTemplate>
                    <DataTemplate x:DataType="viewModels:AssetDocumentTabItemViewModel">
                        <TabViewItem
                            ToolTipService.ToolTip="{x:Bind ToolTipText}">
                            <TabViewItem.Header>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="4"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="2"
                                        Visibility="{x:Bind SpineMarkerVisibility}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind DisplayName}" />
                                </Grid>
                            </TabViewItem.Header>
                            <TabViewItem.ContextFlyout>
                                <MenuFlyout Opening="OnAssetEditorTabContextFlyoutOpening">
                                    <MenuFlyoutItem
                                        x:Name="MoveAssetDocumentToMainWindowMenuItem"
                                        Click="OnMoveAssetDocumentToMainWindowMenuItemClick"
                                        Tag="{Binding}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Name="CloseAssetDocumentTabMenuItem"
                                        Click="OnCloseAssetDocumentTabMenuItemClick"
                                        Tag="{Binding}" />
                                </MenuFlyout>
                            </TabViewItem.ContextFlyout>
                        </TabViewItem>
                    </DataTemplate>
                </TabView.TabItemTemplate>
            </TabView>
        </Grid>

        <Grid
            Grid.Row="1"
            MinHeight="0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="380" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Grid MinHeight="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:InspectorPreviewSurfaceView
                    MinHeight="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    FixedPreviewSurfaceHeight="520"
                    UseAvailablePreviewSpace="True"
                    ViewModel="{x:Bind ViewModel.Inspector, Mode=OneWay}"
                    OpenPreviewLocationRequested="OnPreviewSurfaceOpenPreviewLocationRequested"
                    ResolvedAssetOpenRequested="OnResolvedAssetOpenRequested" />

                <Border
                    Grid.Row="1"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="MoveToMainWindowButton"
                                Click="OnMoveActiveAssetDocumentToMainWindowButtonClick"
                                IsEnabled="{x:Bind ViewModel.DocumentGroup.HasDocumentTabs, Mode=OneWay}"
                                Style="{StaticResource WorkspaceInlineActionButtonStyle}" />
                            <Button
                                x:Name="MoveGroupToMainWindowButton"
                                Click="OnMoveAssetDocumentGroupToMainWindowButtonClick"
                                IsEnabled="{x:Bind ViewModel.DocumentGroup.HasDocumentTabs, Mode=OneWay}"
                                Style="{StaticResource WorkspaceInlineActionButtonStyle}" />
                            <Button
                                x:Name="OpenGroupInNewWindowButton"
                                Click="OnOpenAssetDocumentGroupInNewWindowButtonClick"
                                IsEnabled="{x:Bind ViewModel.DocumentGroup.HasDocumentTabs, Mode=OneWay}"
                                Style="{StaticResource WorkspaceInlineActionButtonStyle}" />
                            <Button
                                x:Name="ExtractButton"
                                Click="OnExtractButtonClick"
                                IsEnabled="{x:Bind ViewModel.Inspector.CanExtract, Mode=OneWay}" />
                            <Button
                                x:Name="SelectReplacementButton"
                                Click="OnSelectReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.Inspector.CanSelectReplacementSource, Mode=OneWay}" />
                            <Button
                                x:Name="SelectFileReplacementButton"
                                Click="OnSelectFileReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.Inspector.CanSelectFileReplacementSource, Mode=OneWay}" />
                            <Button
                                x:Name="ApplyReplacementButton"
                                Click="OnApplyReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.Inspector.CanApplyReplacement, Mode=OneWay}" />
                            <Button
                                x:Name="UndoReplacementButton"
                                Click="OnUndoReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.Inspector.CanUndoReplacement, Mode=OneWay}" />
                            <Button
                                x:Name="RedoReplacementButton"
                                Click="OnRedoReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.Inspector.CanRedoReplacement, Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border
                Grid.Column="1"
                Padding="10"
                Style="{StaticResource SettingsSectionCardStyle}">
                <controls:InspectorPanelView
                    ShowActionBar="False"
                    ShowDetailsPreview="False"
                    ViewModel="{x:Bind ViewModel.Inspector, Mode=OneWay}"
                    ApplyReplacementRequested="OnInspectorApplyReplacementRequested"
                    ExtractRequested="OnInspectorExtractRequested"
                    OpenPreviewLocationRequested="OnInspectorOpenPreviewLocationRequested"
                    ResolvedAssetOpenRequested="OnResolvedAssetOpenRequested"
                    SelectFileReplacementSourceRequested="OnInspectorSelectFileReplacementSourceRequested"
                    SelectReplacementSourceRequested="OnInspectorSelectReplacementSourceRequested"
                    SpineAtlasPageSelectionRequested="OnInspectorSpineAtlasPageSelectionRequested" />
            </Border>
        </Grid>

        <Grid
            x:Name="AssetDocumentGroupDropPreviewOverlay"
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="12"
                Opacity="0.08" />
            <Border
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="12" />
        </Grid>
    </Grid>
</Window>
