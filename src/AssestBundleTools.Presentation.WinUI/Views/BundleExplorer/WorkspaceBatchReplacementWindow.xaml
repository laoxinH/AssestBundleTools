<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.WorkspaceBatchReplacementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:AssestBundleTools.Presentation.WinUI.Views.Shared"
    mc:Ignorable="d">

    <Grid
        x:Name="ContentRoot"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ThemeShadow x:Key="BatchReplacementCardShadow" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="LeftInsetColumn"
                    Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition
                    x:Name="RightInsetColumn"
                    Width="0" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="1"
                Padding="14,0"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8B7;" />
                <TextBlock
                    x:Name="TitleBarText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>

        <Grid
            Grid.Row="1"
            MinHeight="0"
            Padding="48,14,48,20"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="48"
                    Height="48"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="12">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="26"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE8A5;" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <TextBlock
                        x:Name="WindowTitleText"
                        FontSize="28"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="WindowSubtitleText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="13"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>

            <ContentControl
                x:Name="ContentHost"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                MinHeight="0" />

            <Border
                Grid.Row="2"
                MinHeight="70"
                Padding="16,10"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE8A5;" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="PlanSummaryTitleText"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold" />
                            <ProgressRing
                                Grid.Column="1"
                                Width="18"
                                Height="18"
                                IsActive="{Binding IsSummaryProgressActive}"
                                Visibility="{Binding PlanLoadingVisibility}" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="2"
                            Text="{Binding PlanSummaryText}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            FontSize="12"
                            MaxLines="2"
                            Text="{Binding ValidationText}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords"
                            Visibility="{Binding ValidationVisibility}" />
                    </StackPanel>

                    <Button
                        x:Name="CancelButton"
                        Grid.Column="2"
                        Width="128"
                        MinHeight="40"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Click="OnCancelButtonClick" />
                    <Button
                        x:Name="StartReplacementButton"
                        Grid.Column="3"
                        Width="156"
                        MinHeight="40"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Content="{Binding PrimaryButtonText}"
                        Click="OnStartReplacementButtonClick"
                        IsEnabled="{Binding CanSubmit}"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>
        </Grid>

        <shared:AppNotificationPresenter
            Grid.RowSpan="2"
            NotificationService="{x:Bind NotificationService, Mode=OneWay}" />
    </Grid>
</Window>
