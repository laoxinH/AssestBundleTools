<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.BundleExplorerPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="ExplorerBundleItemButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style
            x:Key="ExplorerToolbarIconButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="WorkbenchTitleIconButtonStyle"
            BasedOn="{StaticResource ExplorerToolbarIconButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style
            x:Key="WorkspaceChipIconBadgeStyle"
            TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- 工作台顶部所有操作入口统一走同一套 chip 模板，
             避免主操作、次级操作各自维护一套外观与状态。 -->
        <Style
            x:Key="WorkspaceChipButtonBaseStyle"
            TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border
                                x:Name="SurfaceBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <CompositeTransform x:Name="SurfaceTransform" />
                                </Border.RenderTransform>
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}" />
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="SurfaceBorder"
                                                Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="SurfaceBorder"
                                                Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation
                                                Storyboard.TargetName="SurfaceTransform"
                                                Storyboard.TargetProperty="TranslateY"
                                                To="-1"
                                                Duration="0:0:0.10"
                                                EnableDependentAnimation="True" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="SurfaceBorder"
                                                Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="SurfaceBorder"
                                                Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation
                                                Storyboard.TargetName="SurfaceTransform"
                                                Storyboard.TargetProperty="TranslateY"
                                                To="0.5"
                                                Duration="0:0:0.08"
                                                EnableDependentAnimation="True" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="SurfaceBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.55"
                                                Duration="0:0:0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="WorkspacePrimaryActionChipButtonStyle"
            BasedOn="{StaticResource WorkspaceChipButtonBaseStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="WorkspaceSecondaryActionChipButtonStyle"
            BasedOn="{StaticResource WorkspaceChipButtonBaseStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style
            x:Key="CollapsedBundlePaneActionButtonStyle"
            TargetType="Button">
            <Setter Property="Width" Value="54" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid
        x:Name="PageLayoutRoot"
        Padding="24,18,16,20"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                x:Name="PageEyebrowText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="PageTitleText"
                    VerticalAlignment="Center"
                    Style="{StaticResource WorkspacePageTitleTextStyle}" />
                <Button
                    x:Name="ReturnToConsoleIconButton"
                    Click="OnReturnToConsoleIconButtonClick"
                    Style="{StaticResource WorkbenchTitleIconButtonStyle}"
                    VerticalAlignment="Center">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        Glyph="&#xE72B;" />
                </Button>
            </StackPanel>
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            ZoomMode="Disabled">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="CreateWorkspaceChipButton"
                    Style="{StaticResource WorkspacePrimaryActionChipButtonStyle}"
                    Click="OnNewWorkspaceButtonClick">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="CreateWorkspaceChipIconBorder"
                            Style="{StaticResource WorkspaceChipIconBadgeStyle}">
                            <FontIcon
                                x:Name="CreateWorkspaceChipIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Glyph="&#xE710;" />
                        </Border>

                        <TextBlock
                            x:Name="CreateWorkspaceChipText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>

                <Button
                    x:Name="OpenWorkspaceChipButton"
                    Style="{StaticResource WorkspacePrimaryActionChipButtonStyle}"
                    Click="OnOpenWorkspaceButtonClick">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="OpenWorkspaceChipIconBorder"
                            Style="{StaticResource WorkspaceChipIconBadgeStyle}">
                            <FontIcon
                                x:Name="OpenWorkspaceChipIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Glyph="&#xE838;" />
                        </Border>

                        <TextBlock
                            x:Name="OpenWorkspaceChipText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>

                <Button
                    x:Name="RefreshChipButton"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    IsEnabled="{x:Bind ViewModel.WorkspaceShell.HasWorkspace, Mode=OneWay}"
                    Style="{StaticResource WorkspaceSecondaryActionChipButtonStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource WorkspaceChipIconBadgeStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Glyph="&#xE72C;" />
                        </Border>

                        <TextBlock
                            x:Name="RefreshChipText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>

                <Button
                    x:Name="BatchExtractChipButton"
                    Click="OnBatchExtractChipButtonClick"
                    IsEnabled="{x:Bind ViewModel.WorkspaceShell.HasWorkspace, Mode=OneWay}"
                    Style="{StaticResource WorkspaceSecondaryActionChipButtonStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource WorkspaceChipIconBadgeStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Glyph="&#xE896;" />
                        </Border>

                        <TextBlock
                            x:Name="BatchExtractChipText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>

                <Button
                    x:Name="SaveAsBundleChipButton"
                    Click="OnSaveAsBundleChipButtonClick"
                    IsEnabled="{x:Bind ViewModel.WorkspaceShell.HasWorkspace, Mode=OneWay}"
                    Style="{StaticResource WorkspaceSecondaryActionChipButtonStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource WorkspaceChipIconBadgeStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Glyph="&#xE74E;" />
                        </Border>

                        <TextBlock
                            x:Name="SaveAsBundleChipText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>

                <ItemsControl
                    Margin="4,0,0,0"
                    ItemsSource="{x:Bind ViewModel.WorkspaceShell.WorkspaceStatusChips, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:WorkspaceStatusChipViewModel">
                            <Border
                                Margin="0,0,8,0"
                                Padding="10,7"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Margin="0,1,0,0"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind Glyph}" />

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="1">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="11"
                                            Text="{x:Bind Label}" />
                                        <TextBlock
                                            MaxWidth="220"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Value}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid
            x:Name="BundleWorkspaceGrid"
            Grid.Row="2"
            MinHeight="0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="BundlePaneColumnDefinition"
                    Width="1.08*" />
                <ColumnDefinition
                    x:Name="AssetPaneColumnDefinition"
                    Width="1.56*" />
                <ColumnDefinition
                    x:Name="InspectorPaneColumnDefinition"
                    Width="1.36*" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="BundlePaneHost"
                MinHeight="0"
                AllowDrop="True"
                DragOver="OnWorkspaceImportDragOver"
                DragLeave="OnWorkspaceImportDragLeave"
                Drop="OnWorkspaceImportDrop">
                <Border
                    x:Name="BundlePaneExpandedCard"
                    Padding="12"
                    Style="{StaticResource SettingsSectionCardStyle}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="BundlePaneExpandedTranslateTransform" />
                    </Border.RenderTransform>

                <Grid
                    MinHeight="0"
                    RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="LeftPanelTitleText"
                            Style="{StaticResource WorkspaceSectionTitleTextStyle}" />

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                x:Name="BundleImportFileButton"
                                Style="{StaticResource ExplorerToolbarIconButtonStyle}"
                                Click="OnBundleImportFileButtonClick"
                                IsEnabled="{x:Bind ViewModel.WorkspaceShell.HasWorkspace, Mode=OneWay}">
                                <Button.Resources>
                                    <SolidColorBrush
                                        x:Key="ButtonBackground"
                                        Color="Transparent" />
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPointerOver"
                                        Color="#10000000" />
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPressed"
                                        Color="#16000000" />
                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrush"
                                        Color="Transparent" />
                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrushPointerOver"
                                        Color="Transparent" />
                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrushPressed"
                                        Color="Transparent" />
                                </Button.Resources>
                                <Grid
                                    Width="18"
                                    Height="18">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="15"
                                        Glyph="&#xE8A5;" />
                                    <Border
                                        Width="9"
                                        Height="9"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="999">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="6"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Glyph="&#xE710;" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button
                                x:Name="BundleImportDirectoryButton"
                                Style="{StaticResource ExplorerToolbarIconButtonStyle}"
                                Click="OnBundleImportDirectoryButtonClick"
                                IsEnabled="{x:Bind ViewModel.WorkspaceShell.HasWorkspace, Mode=OneWay}">
                                <Button.Resources>
                                    <SolidColorBrush
                                        x:Key="ButtonBackground"
                                        Color="Transparent" />
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPointerOver"
                                        Color="#10000000" />
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPressed"
                                        Color="#16000000" />
                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrush"
                                        Color="Transparent" />
                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrushPointerOver"
                                        Color="Transparent" />
                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrushPressed"
                                        Color="Transparent" />
                                </Button.Resources>
                                <Grid
                                    Width="18"
                                    Height="18">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="15"
                                        Glyph="&#xE838;" />
                                    <Border
                                        Width="9"
                                        Height="9"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="999">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="6"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Glyph="&#xE710;" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button
                                x:Name="BundleSearchToggleButton"
                                Style="{StaticResource ExplorerToolbarIconButtonStyle}"
                                Click="OnBundleSearchToggleButtonClick"
                                IsEnabled="{x:Bind ViewModel.BundlePane.CanToggleBundleSearch, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.BundlePane.BundleSearchToggleToolTip, Mode=OneWay}">
                                <Button.Resources>
                                    <SolidColorBrush
                                        x:Key="ButtonBackground"
                                        Color="Transparent" />
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPointerOver"
                                        Color="#10000000" />
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPressed"
                                        Color="#16000000" />
                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrush"
                                        Color="Transparent" />
                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrushPointerOver"
                                        Color="Transparent" />
                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrushPressed"
                                        Color="Transparent" />
                                </Button.Resources>
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="17"
                                    Glyph="{x:Bind ViewModel.BundlePane.BundleSearchToggleGlyph, Mode=OneWay}" />
                            </Button>

                            <Button
                                x:Name="BundlePaneCollapseButton"
                                Style="{StaticResource ExplorerToolbarIconButtonStyle}"
                                Click="OnBundlePaneCollapseButtonClick"
                                IsEnabled="{x:Bind ViewModel.BundlePane.CanToggleBundlePaneCollapse, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.BundlePane.BundlePaneCollapseToolTip, Mode=OneWay}">
                                <Button.Resources>
                                    <SolidColorBrush
                                        x:Key="ButtonBackground"
                                        Color="Transparent" />
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPointerOver"
                                        Color="#10000000" />
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPressed"
                                        Color="#16000000" />
                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrush"
                                        Color="Transparent" />
                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrushPointerOver"
                                        Color="Transparent" />
                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrushPressed"
                                        Color="Transparent" />
                                </Button.Resources>
                                <Path
                                    Width="10"
                                    Height="12"
                                    Data="M 8.5 1.5 L 3.5 6 L 8.5 10.5"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.7" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border
                        x:Name="BundleSearchHost"
                        Grid.Row="1"
                        Height="0"
                        Opacity="0"
                        Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BundleSearchTranslateTransform" Y="-6" />
                        </Border.RenderTransform>

                        <TextBox
                            x:Name="BundleSearchTextBox"
                            Text="{x:Bind ViewModel.BundlePane.BundleSearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <Grid
                        Grid.Row="2"
                        MinHeight="0">
                        <TextBlock
                            x:Name="NoWorkspaceText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.BundlePane.BundlePaneEmptyStateText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind ViewModel.BundlePane.BundlePaneEmptyStateVisibility, Mode=OneWay}" />

                        <TextBlock
                            x:Name="BundleSearchEmptyStateText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.BundlePane.BundleSearchEmptyStateText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind ViewModel.BundlePane.BundleSearchEmptyStateVisibility, Mode=OneWay}" />

                        <ScrollViewer
                            MinHeight="0"
                            Visibility="{x:Bind ViewModel.BundlePane.BundleListVisibility, Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.BundlePane.BundleGroups, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:BundleGroupViewModel">
                                        <StackPanel Margin="0,0,0,10" Spacing="4">
                                            <Grid Margin="0,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE8B7;" />
                                                    <TextBlock
                                                        Text="{x:Bind DisplayName}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>

                                                <Border
                                                    Grid.Column="1"
                                                    Padding="8,2"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="999">
                                                    <TextBlock
                                                        Text="{x:Bind Bundles.Count}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </Grid>

                                            <ItemsControl
                                                Margin="8,0,0,0"
                                                ItemsSource="{x:Bind Bundles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:BundleNodeViewModel">
                                                        <Button
                                                            Margin="0,0,0,1"
                                                            Style="{StaticResource ExplorerBundleItemButtonStyle}"
                                                            Click="OnBundleNodeButtonClick"
                                                            Tag="{x:Bind}">
                                                            <Button.ContextFlyout>
                                                                <MenuFlyout Opening="OnBundleNodeContextFlyoutOpening">
                                                                    <MenuFlyoutItem
                                                                        Name="OpenContainingLocationMenuItem"
                                                                        Click="OnBundleNodeOpenContainingLocationMenuItemClick"
                                                                        IsEnabled="{x:Bind CanOpenSourceLocation}"
                                                                        Tag="{x:Bind}">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon
                                                                                FontFamily="Segoe Fluent Icons"
                                                                                Glyph="&#xE838;" />
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                    <MenuFlyoutSeparator />
                                                                    <MenuFlyoutItem
                                                                        Name="RemoveBundleMenuItem"
                                                                        Click="OnBundleNodeRemoveMenuItemClick"
                                                                        Tag="{x:Bind}">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon
                                                                                FontFamily="Segoe Fluent Icons"
                                                                                Glyph="&#xE74D;" />
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                </MenuFlyout>
                                                            </Button.ContextFlyout>
                                                            <Button.Resources>
                                                                <SolidColorBrush
                                                                    x:Key="ButtonBackground"
                                                                    Color="Transparent" />
                                                                <SolidColorBrush
                                                                    x:Key="ButtonBackgroundPointerOver"
                                                                    Color="#11000000" />
                                                                <SolidColorBrush
                                                                    x:Key="ButtonBackgroundPressed"
                                                                    Color="#19000000" />
                                                                <SolidColorBrush
                                                                    x:Key="ButtonBorderBrush"
                                                                    Color="Transparent" />
                                                                <SolidColorBrush
                                                                    x:Key="ButtonBorderBrushPointerOver"
                                                                    Color="Transparent" />
                                                                <SolidColorBrush
                                                                    x:Key="ButtonBorderBrushPressed"
                                                                    Color="Transparent" />
                                                            </Button.Resources>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border
                                                                    Grid.ColumnSpan="2"
                                                                    Margin="0"
                                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                    CornerRadius="6"
                                                                    Opacity="{x:Bind SelectionBackgroundOpacity, Mode=OneWay}" />

                                                                <Border
                                                                    Width="2"
                                                                    Margin="0,12,0,12"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{ThemeResource TextFillColorPrimaryBrush}"
                                                                    CornerRadius="1"
                                                                    Visibility="{x:Bind SelectionIndicatorVisibility, Mode=OneWay}" />

                                                                <Grid
                                                                    Grid.Column="1"
                                                                    Padding="10,6,8,6"
                                                                    ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <FontIcon
                                                                        Margin="0,2,0,0"
                                                                        FontFamily="Segoe Fluent Icons"
                                                                        FontSize="13"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Glyph="&#xE8A5;" />

                                                                    <StackPanel
                                                                        Grid.Column="1"
                                                                        Spacing="1">
                                                                        <TextBlock
                                                                            Text="{x:Bind DisplayName}"
                                                                            FontSize="14"
                                                                            FontWeight="SemiBold"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                            Text="{x:Bind LogicalPath}"
                                                                            FontSize="12"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="NoWrap" />
                                                                    </StackPanel>

                                                                    <Border
                                                                        Grid.Column="2"
                                                                        Margin="8,0,0,0"
                                                                        Padding="8,2"
                                                                        VerticalAlignment="Center"
                                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                        CornerRadius="999">
                                                                        <TextBlock
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                            FontSize="11"
                                                                            Text="{x:Bind AssetCount}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
                </Border>

                <Border
                    x:Name="BundlePaneCollapsedCard"
                    Padding="5,8"
                    Visibility="Collapsed"
                    Style="{StaticResource SettingsSectionCardStyle}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="BundlePaneCollapsedTranslateTransform" />
                    </Border.RenderTransform>

                    <Grid
                        MinHeight="0"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button
                            x:Name="BundlePaneExpandButton"
                            Style="{StaticResource ExplorerToolbarIconButtonStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Click="OnBundlePaneCollapseButtonClick"
                            IsEnabled="{x:Bind ViewModel.BundlePane.CanToggleBundlePaneCollapse, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.BundlePane.BundlePaneCollapseToolTip, Mode=OneWay}">
                            <Button.Resources>
                                <SolidColorBrush
                                    x:Key="ButtonBackground"
                                    Color="Transparent" />
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPointerOver"
                                    Color="#10000000" />
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPressed"
                                    Color="#16000000" />
                                <SolidColorBrush
                                    x:Key="ButtonBorderBrush"
                                    Color="Transparent" />
                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPointerOver"
                                    Color="Transparent" />
                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPressed"
                                    Color="Transparent" />
                            </Button.Resources>
                            <Path
                                Width="10"
                                Height="12"
                                Data="M 3.5 1.5 L 8.5 6 L 3.5 10.5"
                                Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.7" />
                        </Button>

                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <Button
                                x:Name="CollapsedBundleImportFileButton"
                                Style="{StaticResource CollapsedBundlePaneActionButtonStyle}"
                                Click="OnBundleImportFileButtonClick"
                                PointerEntered="OnCollapsedBundlePaneActionPointerEntered"
                                PointerExited="OnCollapsedBundlePaneActionPointerExited"
                                PointerPressed="OnCollapsedBundlePaneActionPointerPressed"
                                PointerReleased="OnCollapsedBundlePaneActionPointerReleased"
                                PointerCanceled="OnCollapsedBundlePaneActionPointerCanceled"
                                IsEnabled="{x:Bind ViewModel.WorkspaceShell.HasWorkspace, Mode=OneWay}">
                                <Grid
                                    x:Name="CollapsedBundleImportFileActionSurface"
                                    MinHeight="54"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <CompositeTransform x:Name="CollapsedBundleImportFileActionTransform" />
                                    </Grid.RenderTransform>

                                    <Border
                                        Padding="5,8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10" />

                                    <Border
                                        x:Name="CollapsedBundleImportFileHoverOverlay"
                                        Background="#12000000"
                                        CornerRadius="10"
                                        IsHitTestVisible="False"
                                        Opacity="0" />

                                    <Border
                                        x:Name="CollapsedBundleImportFilePressedOverlay"
                                        Background="#1F000000"
                                        CornerRadius="10"
                                        IsHitTestVisible="False"
                                        Opacity="0" />

                                    <Border
                                        x:Name="CollapsedBundleImportFileHoverStroke"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        IsHitTestVisible="False"
                                        Opacity="0" />

                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                        <Grid
                                            Width="18"
                                            Height="18">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="15"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE8A5;" />
                                            <Border
                                                Width="9"
                                                Height="9"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="999">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="6"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Glyph="&#xE710;" />
                                            </Border>
                                        </Grid>

                                        <TextBlock
                                            x:Name="CollapsedBundleImportFileButtonText"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="9.5"
                                            FontWeight="SemiBold"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button
                                x:Name="CollapsedBundleImportDirectoryButton"
                                Style="{StaticResource CollapsedBundlePaneActionButtonStyle}"
                                Click="OnBundleImportDirectoryButtonClick"
                                PointerEntered="OnCollapsedBundlePaneActionPointerEntered"
                                PointerExited="OnCollapsedBundlePaneActionPointerExited"
                                PointerPressed="OnCollapsedBundlePaneActionPointerPressed"
                                PointerReleased="OnCollapsedBundlePaneActionPointerReleased"
                                PointerCanceled="OnCollapsedBundlePaneActionPointerCanceled"
                                IsEnabled="{x:Bind ViewModel.WorkspaceShell.HasWorkspace, Mode=OneWay}">
                                <Grid
                                    x:Name="CollapsedBundleImportDirectoryActionSurface"
                                    MinHeight="54"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <CompositeTransform x:Name="CollapsedBundleImportDirectoryActionTransform" />
                                    </Grid.RenderTransform>

                                    <Border
                                        Padding="5,8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10" />

                                    <Border
                                        x:Name="CollapsedBundleImportDirectoryHoverOverlay"
                                        Background="#12000000"
                                        CornerRadius="10"
                                        IsHitTestVisible="False"
                                        Opacity="0" />

                                    <Border
                                        x:Name="CollapsedBundleImportDirectoryPressedOverlay"
                                        Background="#1F000000"
                                        CornerRadius="10"
                                        IsHitTestVisible="False"
                                        Opacity="0" />

                                    <Border
                                        x:Name="CollapsedBundleImportDirectoryHoverStroke"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        IsHitTestVisible="False"
                                        Opacity="0" />

                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                        <Grid
                                            Width="18"
                                            Height="18">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="15"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE838;" />
                                            <Border
                                                Width="9"
                                                Height="9"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="999">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="6"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Glyph="&#xE710;" />
                                            </Border>
                                        </Grid>

                                        <TextBlock
                                            x:Name="CollapsedBundleImportDirectoryButtonText"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="9.5"
                                            FontWeight="SemiBold"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Border
                                Width="54"
                                Padding="5,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        x:Name="CollapsedBundlePaneBundleCountLabelText"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.BundlePane.CollapsedBundlePaneBundleCountText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Width="54"
                                Padding="5,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        x:Name="CollapsedBundlePaneGroupCountLabelText"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.BundlePane.CollapsedBundlePaneGroupCountText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Width="54"
                                Padding="5,8"
                                Background="{ThemeResource AccentAcrylicInAppFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ToolTipService.ToolTip="{x:Bind ViewModel.BundlePane.CollapsedBundlePaneSelectedBundleToolTip, Mode=OneWay}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        x:Name="CollapsedBundlePaneSelectionLabelText"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.BundlePane.CollapsedBundlePaneSelectedBundleShortText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="WorkspaceImportDropOverlay"
                    Margin="4"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="18"
                    Canvas.ZIndex="20"
                    IsHitTestVisible="False"
                    Opacity="0.96"
                    Visibility="Collapsed">
                    <Grid>
                        <StackPanel
                            MaxWidth="280"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14">
                            <Border
                                Width="60"
                                Height="60"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="18">
                                <Grid
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="20"
                                        Glyph="&#xE8A5;" />
                                    <Border
                                        Width="11"
                                        Height="11"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="999">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="7"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Glyph="&#xE710;" />
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock
                                x:Name="WorkspaceImportDropOverlayTitleText"
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />

                            <TextBlock
                                x:Name="WorkspaceImportDropOverlayHintText"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="WorkspaceImportBusyOverlay"
                    Margin="4"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Canvas.ZIndex="30"
                    IsHitTestVisible="True"
                    Opacity="0.96"
                    Visibility="{x:Bind ViewModel.WorkspaceImportProgress.OverlayVisibility, Mode=OneWay}">
                    <Grid Padding="18">
                        <StackPanel
                            MaxWidth="280"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Spacing="12">
                            <ProgressRing
                                Width="42"
                                Height="42"
                                HorizontalAlignment="Center"
                                IsActive="{x:Bind ViewModel.WorkspaceImportProgress.IsActive, Mode=OneWay}" />

                            <StackPanel Spacing="5">
                                <TextBlock
                                    x:Name="WorkspaceImportBusyOverlayTitleText"
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />

                                <TextBlock
                                    Text="{x:Bind ViewModel.WorkspaceImportProgress.ProgressText, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />

                                <TextBlock
                                    x:Name="WorkspaceImportBusyOverlayHintText"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="12"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ProgressBar
                                Minimum="0"
                                Maximum="100"
                                Value="{x:Bind ViewModel.WorkspaceImportProgress.ProgressBarValue, Mode=OneWay}"
                                IsIndeterminate="{x:Bind ViewModel.WorkspaceImportProgress.IsProgressBarIndeterminate, Mode=OneWay}" />

                            <TextBlock
                                Text="{x:Bind ViewModel.WorkspaceImportProgress.DetailText, Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

            <Border
                Grid.Column="1"
                Padding="12"
                Style="{StaticResource SettingsSectionCardStyle}">
                <Grid
                    MinHeight="0"
                    RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="CenterPanelTitleText"
                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />

                    <TabView
                        x:Name="BundleTabView"
                        Grid.Row="1"
                        Margin="-2,-2,-2,0"
                        CanDragTabs="True"
                        CanReorderTabs="True"
                        IsAddTabButtonVisible="False"
                        SelectedItem="{x:Bind ViewModel.DocumentWorkspace.ActiveBundleTab, Mode=OneWay}"
                        TabDragCompleted="OnBundleTabViewTabDragCompleted"
                        TabCloseRequested="OnBundleTabViewTabCloseRequested"
                        TabItemsSource="{x:Bind ViewModel.DocumentWorkspace.BundleTabs, Mode=OneWay}"
                        SelectionChanged="OnBundleTabViewSelectionChanged">
                        <TabView.TabItemTemplate>
                            <DataTemplate x:DataType="viewModels:BundleDocumentTabViewModel">
                                <TabViewItem
                                    Header="{x:Bind DisplayName}"
                                    ToolTipService.ToolTip="{x:Bind LogicalPath}">
                                    <TabViewItem.ContextFlyout>
                                        <MenuFlyout Opening="OnBundleTabContextFlyoutOpening">
                                            <MenuFlyoutItem
                                                x:Name="CloseOtherBundleTabsMenuItem"
                                                Click="OnCloseOtherBundleTabsMenuItemClick"
                                                Tag="{Binding}" />
                                            <MenuFlyoutItem
                                                x:Name="CloseAllBundleTabsMenuItem"
                                                Click="OnCloseAllBundleTabsMenuItemClick"
                                                Tag="{Binding}" />
                                        </MenuFlyout>
                                    </TabViewItem.ContextFlyout>
                                </TabViewItem>
                            </DataTemplate>
                        </TabView.TabItemTemplate>
                    </TabView>

                    <controls:AssetPaneView
                        Grid.Row="2"
                        AssetSelectionChanged="OnPrimaryPaneAssetSelectionChanged"
                        BatchExtractRequested="OnPrimaryPaneBatchExtractRequested"
                        FilterChanged="OnPrimaryPaneFilterChanged"
                        ViewModel="{x:Bind ViewModel.AssetWorkflow.PrimaryPane, Mode=OneWay}" />
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="12"
                Style="{StaticResource SettingsSectionCardStyle}">
                <Grid
                    MinHeight="0"
                    RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="RightPanelTitleText"
                        Style="{StaticResource WorkspaceSectionTitleTextStyle}" />

                    <TabView
                        x:Name="AssetDocumentTabView"
                        Grid.Row="1"
                        Margin="-2,-2,-2,0"
                        CanDragTabs="True"
                        CanReorderTabs="True"
                        IsAddTabButtonVisible="False"
                        SelectedItem="{x:Bind ViewModel.DocumentWorkspace.ActiveAssetDocumentTab, Mode=OneWay}"
                        TabDragCompleted="OnAssetDocumentTabViewTabDragCompleted"
                        TabCloseRequested="OnAssetDocumentTabViewTabCloseRequested"
                        TabItemsSource="{x:Bind ViewModel.DocumentWorkspace.CurrentAssetTabs, Mode=OneWay}"
                        SelectionChanged="OnAssetDocumentTabViewSelectionChanged"
                        Visibility="{x:Bind ViewModel.DocumentWorkspace.AssetDocumentTabStripVisibility, Mode=OneWay}">
                        <TabView.TabItemTemplate>
                            <DataTemplate x:DataType="viewModels:AssetDocumentTabViewModel">
                                <TabViewItem
                                    Header="{x:Bind DisplayName}"
                                    ToolTipService.ToolTip="{x:Bind ToolTipText}">
                                    <TabViewItem.ContextFlyout>
                                        <MenuFlyout Opening="OnAssetDocumentTabContextFlyoutOpening">
                                            <MenuFlyoutItem
                                                x:Name="CloseOtherAssetDocumentTabsMenuItem"
                                                Click="OnCloseOtherAssetDocumentTabsMenuItemClick"
                                                Tag="{Binding}" />
                                            <MenuFlyoutItem
                                                x:Name="CloseAllAssetDocumentTabsMenuItem"
                                                Click="OnCloseAllAssetDocumentTabsMenuItemClick"
                                                Tag="{Binding}" />
                                        </MenuFlyout>
                                    </TabViewItem.ContextFlyout>
                                </TabViewItem>
                            </DataTemplate>
                        </TabView.TabItemTemplate>
                    </TabView>

                    <controls:InspectorPanelView
                        Grid.Row="2"
                        ExtractRequested="OnInspectorExtractRequested"
                        OpenPreviewLocationRequested="OnInspectorOpenPreviewLocationRequested"
                        ResolvedAssetOpenRequested="OnInspectorResolvedAssetOpenRequested"
                        SelectFileReplacementSourceRequested="OnInspectorSelectFileReplacementSourceRequested"
                        SelectReplacementSourceRequested="OnInspectorSelectReplacementSourceRequested"
                        ApplyReplacementRequested="OnInspectorApplyReplacementRequested"
                        UndoReplacementRequested="OnInspectorUndoReplacementRequested"
                        ViewModel="{x:Bind ViewModel.AssetWorkflow.Inspector, Mode=OneWay}" />
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
