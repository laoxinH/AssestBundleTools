<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.TextDocumentSurfaceView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:webview2="using:Microsoft.UI.Xaml.Controls"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <Grid>
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <webview2:WebView2
                x:Name="EditorWebView"
                DefaultBackgroundColor="Transparent" />
        </Border>

        <Grid
            x:Name="FallbackSurface"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="Collapsed"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Padding="10"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Top"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE946;" />
                    <StackPanel
                        Grid.Column="1"
                        Spacing="2">
                        <TextBlock
                            x:Name="FallbackDiagnosticTitleText"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="FallbackDiagnosticDescriptionText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <Button
                        x:Name="CopyFallbackDiagnosticButton"
                        Grid.Column="2"
                        Click="OnCopyFallbackDiagnosticButtonClick"
                        Style="{StaticResource WorkspaceOperationButtonStyle}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="12"
                                Glyph="&#xE8C8;" />
                            <TextBlock x:Name="CopyFallbackDiagnosticButtonText" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid
                Grid.Row="1"
                MinHeight="0"
                ColumnSpacing="12"
                Visibility="{Binding ReadOnlyViewVisibility, ElementName=Root, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding SearchResultsColumnWidth, ElementName=Root, Mode=OneWay}" />
                </Grid.ColumnDefinitions>

                <ListView
                    MinHeight="0"
                    ItemsSource="{Binding Lines, ElementName=Root, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TextDocumentLineViewModel">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontFamily="Cascadia Mono, Consolas"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind LineNumberText}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontFamily="Cascadia Mono, Consolas"
                                    Text="{x:Bind Text}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView
                    Grid.Column="1"
                    MinHeight="0"
                    ItemsSource="{Binding SearchMatches, ElementName=Root, Mode=OneWay}"
                    SelectionMode="None"
                    Visibility="{Binding SearchResultsVisibility, ElementName=Root, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TextDocumentSearchMatchViewModel">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontFamily="Cascadia Mono, Consolas"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind LocationText}" />
                                <TextBlock
                                    Text="{x:Bind LineText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid
                Grid.Row="1"
                MinHeight="0"
                ColumnSpacing="12"
                Visibility="{Binding EditableViewVisibility, ElementName=Root, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding SearchResultsColumnWidth, ElementName=Root, Mode=OneWay}" />
                </Grid.ColumnDefinitions>

                <TextBox
                    AcceptsReturn="True"
                    FontFamily="Cascadia Mono, Consolas"
                    HorizontalAlignment="Stretch"
                    IsSpellCheckEnabled="False"
                    MinHeight="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{Binding EditableText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="NoWrap"
                    VerticalAlignment="Stretch" />

                <ListView
                    Grid.Column="1"
                    MinHeight="0"
                    ItemsSource="{Binding SearchMatches, ElementName=Root, Mode=OneWay}"
                    SelectionMode="None"
                    Visibility="{Binding SearchResultsVisibility, ElementName=Root, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TextDocumentSearchMatchViewModel">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontFamily="Cascadia Mono, Consolas"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind LocationText}" />
                                <TextBlock
                                    Text="{x:Bind LineText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid
                Grid.Row="2"
                ColumnSpacing="10"
                Visibility="{Binding FooterVisibility, ElementName=Root, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusText, ElementName=Root, Mode=OneWay}" />

                <Button
                    x:Name="LoadMoreLinesButton"
                    Grid.Column="1"
                    Click="OnLoadMoreLinesButtonClick"
                    IsEnabled="{Binding CanLoadMoreLines, ElementName=Root, Mode=OneWay}"
                    Style="{StaticResource WorkspaceOperationButtonStyle}"
                    Visibility="{Binding LoadMoreLinesButtonVisibility, ElementName=Root, Mode=OneWay}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Glyph="&#xE70D;" />
                        <TextBlock x:Name="LoadMoreLinesButtonText" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
