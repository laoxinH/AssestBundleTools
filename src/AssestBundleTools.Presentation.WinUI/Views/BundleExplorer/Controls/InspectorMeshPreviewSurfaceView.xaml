<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.InspectorMeshPreviewSurfaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="InspectorMeshPreviewBadgeBorderStyle"
            TargetType="Border">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#78111115" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style
            x:Key="InspectorMeshPreviewBadgeTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorMeshPreviewAssociationTextStyle"
            BasedOn="{StaticResource InspectorMeshPreviewBadgeTextStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#DDE2E8F0" />
        </Style>

        <Style
            x:Key="InspectorMeshPreviewResolvedAssetTagButtonStyle"
            TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <canvas:CanvasControl
            x:Name="MeshCanvas"
            ClearColor="Transparent"
            Draw="OnMeshCanvasDraw"
            PointerCanceled="OnMeshCanvasPointerReleased"
            PointerCaptureLost="OnMeshCanvasPointerReleased"
            PointerMoved="OnMeshCanvasPointerMoved"
            PointerPressed="OnMeshCanvasPointerPressed"
            PointerReleased="OnMeshCanvasPointerReleased"
            PointerWheelChanged="OnMeshCanvasPointerWheelChanged"
            SizeChanged="OnMeshCanvasSizeChanged" />

        <Border
            Margin="8"
            MaxWidth="248"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource InspectorMeshPreviewBadgeBorderStyle}"
            Visibility="{x:Bind ViewModel.ControlsVisibility, Mode=OneWay}">
            <StackPanel Spacing="3">
                <TextBlock
                    Style="{StaticResource InspectorMeshPreviewBadgeTextStyle}"
                    Text="{x:Bind ViewModel.BadgeText, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource InspectorMeshPreviewAssociationTextStyle}"
                    Text="{x:Bind ViewModel.TextureAssociationText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.TextureAssociationVisibility, Mode=OneWay}" />
                <ItemsControl
                    ItemsSource="{x:Bind ViewModel.TextureAssociationRows, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.TextureAssociationRowsVisibility, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bindings:ResolvedAssetReferenceViewModel">
                            <Grid
                                Margin="0,4,0,0"
                                ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource InspectorMeshPreviewAssociationTextStyle}"
                                    Text="{x:Bind Text, Mode=OneTime}" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="{x:Bind OpenButtonText, Mode=OneTime}"
                                    Click="OnResolvedAssetOpenButtonClick"
                                    Style="{StaticResource InspectorMeshPreviewResolvedAssetTagButtonStyle}"
                                    Tag="{x:Bind Target, Mode=OneTime}"
                                    ToolTipService.ToolTip="{x:Bind OpenButtonToolTipText, Mode=OneTime}"
                                    Visibility="{x:Bind OpenButtonVisibility, Mode=OneTime}">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="13"
                                        Foreground="#FFF8FAFC"
                                        Glyph="&#xE8A7;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
