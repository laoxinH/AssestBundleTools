<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.SpriteEditGeometryPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="SpriteEditGeometryLabelTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style
            x:Key="SpriteEditGeometryNumberBoxStyle"
            TargetType="NumberBox">
            <Setter Property="Width" Value="86" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="16" />
            <Setter Property="SpinButtonPlacementMode" Value="Compact" />
        </Style>
    </UserControl.Resources>

    <Border
        Padding="12,10"
        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Visibility="{x:Bind ViewModel.SpriteEditGeometryPanelVisibility, Mode=OneWay}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="SpriteEditGeometryTitleText"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                ZoomMode="Disabled">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Name="SpriteEditCropXLabelText"
                            Style="{StaticResource SpriteEditGeometryLabelTextStyle}" />
                        <NumberBox
                            x:Name="SpriteEditCropXNumberBox"
                            Style="{StaticResource SpriteEditGeometryNumberBoxStyle}"
                            Value="{x:Bind ViewModel.SpriteEditCropX, Mode=OneWay}"
                            ValueChanged="OnSpriteEditGeometryNumberBoxValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Name="SpriteEditCropYLabelText"
                            Style="{StaticResource SpriteEditGeometryLabelTextStyle}" />
                        <NumberBox
                            x:Name="SpriteEditCropYNumberBox"
                            Style="{StaticResource SpriteEditGeometryNumberBoxStyle}"
                            Value="{x:Bind ViewModel.SpriteEditCropY, Mode=OneWay}"
                            ValueChanged="OnSpriteEditGeometryNumberBoxValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Name="SpriteEditCropWidthLabelText"
                            Style="{StaticResource SpriteEditGeometryLabelTextStyle}" />
                        <NumberBox
                            x:Name="SpriteEditCropWidthNumberBox"
                            Style="{StaticResource SpriteEditGeometryNumberBoxStyle}"
                            Value="{x:Bind ViewModel.SpriteEditCropWidth, Mode=OneWay}"
                            ValueChanged="OnSpriteEditGeometryNumberBoxValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Name="SpriteEditCropHeightLabelText"
                            Style="{StaticResource SpriteEditGeometryLabelTextStyle}" />
                        <NumberBox
                            x:Name="SpriteEditCropHeightNumberBox"
                            Style="{StaticResource SpriteEditGeometryNumberBoxStyle}"
                            Value="{x:Bind ViewModel.SpriteEditCropHeight, Mode=OneWay}"
                            ValueChanged="OnSpriteEditGeometryNumberBoxValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Name="SpriteEditPivotXLabelText"
                            Style="{StaticResource SpriteEditGeometryLabelTextStyle}" />
                        <NumberBox
                            x:Name="SpriteEditPivotXNumberBox"
                            Style="{StaticResource SpriteEditGeometryNumberBoxStyle}"
                            Value="{x:Bind ViewModel.SpriteEditPivotX, Mode=OneWay}"
                            ValueChanged="OnSpriteEditGeometryNumberBoxValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Name="SpriteEditPivotYLabelText"
                            Style="{StaticResource SpriteEditGeometryLabelTextStyle}" />
                        <NumberBox
                            x:Name="SpriteEditPivotYNumberBox"
                            Style="{StaticResource SpriteEditGeometryNumberBoxStyle}"
                            Value="{x:Bind ViewModel.SpriteEditPivotY, Mode=OneWay}"
                            ValueChanged="OnSpriteEditGeometryNumberBoxValueChanged" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
