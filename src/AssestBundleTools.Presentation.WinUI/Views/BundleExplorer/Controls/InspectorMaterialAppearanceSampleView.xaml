<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.InspectorMaterialAppearanceSampleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="12"
        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="14"
        Visibility="{x:Bind ViewModel.Visibility, Mode=OneWay}">
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                Width="104"
                Height="104"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Ellipse
                    Fill="{x:Bind ViewModel.SampleBrush, Mode=OneWay}"
                    Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                    StrokeThickness="1" />
                <Ellipse
                    Margin="8"
                    Fill="White"
                    Opacity="{x:Bind ViewModel.MetallicSheenOpacity, Mode=OneWay}" />
                <Ellipse
                    Width="36"
                    Height="28"
                    Margin="22,18,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Fill="White"
                    Opacity="{x:Bind ViewModel.HighlightOpacity, Mode=OneWay}" />
                <Ellipse
                    Margin="-7"
                    Stroke="{ThemeResource AccentFillColorSecondaryBrush}"
                    StrokeThickness="5"
                    Opacity="{x:Bind ViewModel.EmissionGlowOpacity, Mode=OneWay}" />
                <Rectangle
                    Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Opacity="{x:Bind ViewModel.AlphaOverlayOpacity, Mode=OneWay}"
                    RadiusX="52"
                    RadiusY="52" />
            </Grid>

            <StackPanel
                Grid.Column="1"
                Spacing="6">
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    FontSize="11.5"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.NoteText, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
                <Grid
                    Margin="0,4,0,0"
                    ColumnSpacing="8"
                    RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="11.5"
                        Text="{x:Bind ViewModel.BaseColorText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="11.5"
                        Text="{x:Bind ViewModel.AlphaText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Row="1"
                        FontSize="11.5"
                        Text="{x:Bind ViewModel.MetallicText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        FontSize="11.5"
                        Text="{x:Bind ViewModel.SmoothnessText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
