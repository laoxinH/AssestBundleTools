<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.SpineEditPartsPanelView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="SpineEditPartRoleTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style
            x:Key="SpineEditCommandButtonStyle"
            BasedOn="{StaticResource WorkspaceOperationButtonStyle}"
            TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style
            x:Key="SpineEditPartCardStyle"
            TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style
            x:Key="SpineEditPartIconContainerStyle"
            TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>

    <StackPanel
        Spacing="14"
        Visibility="{x:Bind ViewModel.Visibility, Mode=OneWay}">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SpineEditPartIconContainerStyle}">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource AppIconFontFamily}"
                    FontSize="17"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE75D;" />
            </Border>

            <StackPanel
                Grid.Column="1"
                Spacing="3">
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.DescriptionText, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Button
                x:Name="BatchMatchButton"
                Grid.Column="2"
                Click="OnBatchMatchButtonClick"
                Style="{StaticResource SpineEditCommandButtonStyle}"
                VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="13"
                        Glyph="&#xE8F1;" />
                    <TextBlock Text="{x:Bind ViewModel.BatchMatchButtonText, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel
            HorizontalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
            <Border
                Width="44"
                Height="44"
                HorizontalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="8">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource AppIconFontFamily}"
                    FontSize="20"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE75D;" />
            </Border>
            <TextBlock
                MaxWidth="300"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <ItemsControl
            ItemsSource="{x:Bind ViewModel.Parts, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.PartsVisibility, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:SpineAssetGroupEditPartViewModel">
                    <Border Style="{StaticResource SpineEditPartCardStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource SpineEditPartIconContainerStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource AppIconFontFamily}"
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE753;" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SpineEditPartRoleTextStyle}"
                                        Text="{x:Bind RoleText, Mode=OneWay}" />
                                    <Border
                                        Grid.Column="1"
                                        Padding="7,2"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Visibility="{x:Bind ChangedBadgeVisibility, Mode=OneWay}">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{Binding ViewModel.ChangedBadgeText, ElementName=Root}" />
                                    </Border>
                                </Grid>

                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    MaxLines="2"
                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />

                                <TextBlock
                                    FontFamily="Cascadia Mono"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    MaxLines="2"
                                    Text="{x:Bind MetadataText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="WrapWholeWords"
                                    ToolTipService.ToolTip="{x:Bind MetadataText, Mode=OneWay}" />

                                <Border
                                    Height="1"
                                    Margin="0,2,0,0"
                                    Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="2"
                                        Text="{x:Bind SourceText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWholeWords"
                                        ToolTipService.ToolTip="{x:Bind SourceText, Mode=OneWay}" />

                                    <Button
                                        Grid.Column="1"
                                        Click="OnSelectPartFileButtonClick"
                                        Style="{StaticResource SpineEditCommandButtonStyle}"
                                        Tag="{Binding}"
                                        VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon
                                                FontFamily="{StaticResource AppIconFontFamily}"
                                                FontSize="12"
                                                Glyph="&#xE6F3;" />
                                            <TextBlock Text="{x:Bind SelectButtonText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
