<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.SpineEditPartsPanelView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="SpineEditPartRoleTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style
            x:Key="SpineEditSmallTagButtonStyle"
            BasedOn="{StaticResource WorkspaceOperationButtonStyle}"
            TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
    </UserControl.Resources>

    <Grid
        RowSpacing="10"
        Visibility="{x:Bind ViewModel.Visibility, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                VerticalAlignment="Center" />

            <Button
                x:Name="BatchMatchButton"
                Grid.Column="1"
                Click="OnBatchMatchButtonClick"
                Style="{StaticResource SpineEditSmallTagButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="12"
                        Glyph="&#xE8B7;" />
                    <TextBlock Text="{x:Bind ViewModel.BatchMatchButtonText, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.DescriptionText, Mode=OneWay}"
            TextWrapping="WrapWholeWords" />

        <TextBlock
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
            TextWrapping="WrapWholeWords"
            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />

        <ItemsControl
            Grid.Row="3"
            ItemsSource="{x:Bind ViewModel.Parts, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.PartsVisibility, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:SpineAssetGroupEditPartViewModel">
                    <Border
                        Margin="0,0,0,8"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Style="{StaticResource SpineEditPartRoleTextStyle}"
                                    Text="{x:Bind RoleText, Mode=OneWay}" />
                                <Border
                                    Padding="7,2"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="9"
                                    Visibility="{x:Bind ChangedBadgeVisibility, Mode=OneWay}">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ViewModel.ChangedBadgeText, ElementName=Root}" />
                                </Border>
                            </StackPanel>

                            <TextBlock
                                Grid.Row="1"
                                FontSize="14"
                                FontWeight="SemiBold"
                                MaxLines="2"
                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />

                            <TextBlock
                                Grid.Row="2"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                MaxLines="2"
                                Text="{x:Bind MetadataText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="WrapWholeWords"
                                ToolTipService.ToolTip="{x:Bind MetadataText, Mode=OneWay}" />

                            <Grid
                                Grid.Row="3"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="2"
                                    Text="{x:Bind SourceText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="WrapWholeWords"
                                    ToolTipService.ToolTip="{x:Bind SourceText, Mode=OneWay}"
                                    VerticalAlignment="Center" />

                                <Button
                                    Grid.Column="1"
                                    Click="OnSelectPartFileButtonClick"
                                    Style="{StaticResource SpineEditSmallTagButtonStyle}"
                                    VerticalAlignment="Center"
                                    Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="12"
                                            Glyph="&#xE8E5;" />
                                        <TextBlock Text="{x:Bind SelectButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
