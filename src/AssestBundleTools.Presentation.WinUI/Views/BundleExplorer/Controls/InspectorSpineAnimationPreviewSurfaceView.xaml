<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.InspectorSpineAnimationPreviewSurfaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="SpinePreviewActionButtonStyle"
            TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter
                Property="Background"
                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border
                                x:Name="PreviewActionSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <CompositeTransform x:Name="PreviewActionSurfaceTransform" />
                                </Border.RenderTransform>
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="1" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurfaceTransform"
                                                Storyboard.TargetProperty="TranslateY"
                                                To="-0.5"
                                                Duration="0:0:0.08"
                                                EnableDependentAnimation="True" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="1" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurfaceTransform"
                                                Storyboard.TargetProperty="TranslateY"
                                                To="1"
                                                Duration="0:0:0.06"
                                                EnableDependentAnimation="True" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurfaceTransform"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.96"
                                                Duration="0:0:0.06"
                                                EnableDependentAnimation="True" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurfaceTransform"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.96"
                                                Duration="0:0:0.06"
                                                EnableDependentAnimation="True" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.45"
                                                Duration="0:0:0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Orientation="Horizontal"
                Spacing="6">
                <Button
                    x:Name="SetupPoseButton"
                    Click="OnSetupPoseButtonClick"
                    Style="{StaticResource SpinePreviewActionButtonStyle}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Glyph="&#xE777;" />
                </Button>

                <Button
                    x:Name="StepPreviousButton"
                    Click="OnStepPreviousButtonClick"
                    Style="{StaticResource SpinePreviewActionButtonStyle}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Glyph="&#xE100;" />
                </Button>

                <Button
                    x:Name="PlayPauseButton"
                    Click="OnPlayPauseButtonClick"
                    Style="{StaticResource SpinePreviewActionButtonStyle}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" />
                </Button>

                <Button
                    x:Name="StepNextButton"
                    Click="OnStepNextButtonClick"
                    Style="{StaticResource SpinePreviewActionButtonStyle}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Glyph="&#xE101;" />
                </Button>

                <Button
                    x:Name="RestartButton"
                    Click="OnRestartButtonClick"
                    Style="{StaticResource SpinePreviewActionButtonStyle}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Glyph="&#xE72C;" />
                </Button>
            </StackPanel>

            <Button
                x:Name="ExportFramesButton"
                Grid.Column="1"
                IsEnabled="{x:Bind ViewModel.CanExportFrameSequence, Mode=OneWay}"
                Click="OnExportFramesButtonClick"
                Style="{StaticResource SpinePreviewActionButtonStyle}">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Glyph="&#xE74E;" />
            </Button>
        </Grid>

        <Grid
            x:Name="PreviewViewportSquareFrame"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            MinHeight="0"
            VerticalAlignment="Stretch"
            SizeChanged="OnPreviewViewportSquareFrameSizeChanged">
            <Grid
                x:Name="PreviewViewportHost"
                Background="Transparent"
                PointerCanceled="OnPreviewViewportPointerReleased"
                PointerCaptureLost="OnPreviewViewportPointerReleased"
                PointerMoved="OnPreviewViewportPointerMoved"
                PointerPressed="OnPreviewViewportPointerPressed"
                PointerReleased="OnPreviewViewportPointerReleased"
                PointerWheelChanged="OnPreviewViewportPointerWheelChanged"
                SizeChanged="OnPreviewViewportHostSizeChanged">
                <controls:CheckerboardBackground
                    CellSize="12"
                    Visibility="{x:Bind ViewModel.CheckerboardBackgroundVisibility, Mode=OneWay}" />
                <Border
                    Background="White"
                    Visibility="{x:Bind ViewModel.SolidBackgroundVisibility, Mode=OneWay}" />

                <SwapChainPanel
                    x:Name="SpineSwapChainPanel"
                    Visibility="Collapsed" />
                <canvas:CanvasControl
                    x:Name="SpineCanvas"
                    ClearColor="Transparent" />

                <StackPanel
                    Margin="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.Visibility, Mode=OneWay}">
                    <Button
                        x:Name="BackgroundModeButton"
                        Click="OnBackgroundModeButtonClick"
                        Style="{StaticResource SpinePreviewActionButtonStyle}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="13"
                            Glyph="{x:Bind ViewModel.BackgroundModeGlyph, Mode=OneWay}" />
                    </Button>

                    <Button
                        x:Name="ZoomOutViewportButton"
                        Click="OnZoomOutViewportButtonClick"
                        Style="{StaticResource SpinePreviewActionButtonStyle}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="13"
                            Glyph="&#xE738;" />
                    </Button>

                    <Button
                        x:Name="ZoomInViewportButton"
                        Click="OnZoomInViewportButtonClick"
                        Style="{StaticResource SpinePreviewActionButtonStyle}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="13"
                            Glyph="&#xE710;" />
                    </Button>

                    <Button
                        x:Name="ResetViewportButton"
                        Click="OnResetViewportButtonClick"
                        Style="{StaticResource SpinePreviewActionButtonStyle}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="13"
                            Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="2"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="2*"
                        MinWidth="112"
                        MaxWidth="220" />
                    <ColumnDefinition
                        Width="*"
                        MinWidth="96"
                        MaxWidth="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="AnimationComboBox"
                    MinWidth="112"
                    MaxWidth="220"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.AnimationNames, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedAnimationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource CompactSelectorComboBoxStyle}" />

                <ComboBox
                    x:Name="SkinComboBox"
                    Grid.Column="1"
                    MinWidth="96"
                    MaxWidth="150"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{x:Bind ViewModel.IsSkinSelectionEnabled, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.SkinNames, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedSkinName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource CompactSelectorComboBoxStyle}" />

                <ComboBox
                    x:Name="PlaybackSpeedComboBox"
                    Grid.Column="2"
                    MinWidth="82"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.PlaybackSpeedOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.PlaybackSpeed, Mode=OneWay}"
                    SelectionChanged="OnPlaybackSpeedSelectionChanged"
                    Style="{StaticResource CompactSelectorComboBoxStyle}" />
            </Grid>

            <Grid
                Grid.Row="1"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Slider
                    x:Name="PlaybackSlider"
                    Minimum="0"
                    Maximum="{x:Bind ViewModel.Duration, Mode=OneWay}"
                    Value="{x:Bind ViewModel.DisplayPlaybackTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Column="1"
                    MinWidth="96"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.DisplayPlaybackTimeText, Mode=OneWay}"
                    TextAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
