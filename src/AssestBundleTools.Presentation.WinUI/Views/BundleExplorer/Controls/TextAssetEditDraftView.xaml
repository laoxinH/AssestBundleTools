<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.TextAssetEditDraftView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Padding="18,16,18,10"
        Background="Transparent"
        RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ModeHintText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                PlaceholderText=""
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                x:Name="SearchButton"
                Grid.Column="2"
                Click="OnSearchButtonClick"
                IsEnabled="{x:Bind ViewModel.CanSearch, Mode=OneWay}"
                Style="{StaticResource WorkspaceOperationButtonStyle}">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="13"
                    Glyph="&#xE721;" />
            </Button>
        </Grid>

        <controls:TextDocumentSurfaceView
            Grid.Row="1"
            MinHeight="0"
            CanLoadMoreLines="{x:Bind ViewModel.CanLoadMoreLines, Mode=OneWay}"
            EditableText="{x:Bind ViewModel.EditableText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            EditableViewVisibility="{x:Bind ViewModel.EditableViewVisibility, Mode=OneWay}"
            Lines="{x:Bind ViewModel.Lines, Mode=OneWay}"
            LoadMoreLinesButtonVisibility="{x:Bind ViewModel.LoadMoreLinesButtonVisibility, Mode=OneWay}"
            ReadOnlyViewVisibility="{x:Bind ViewModel.ReadOnlyViewVisibility, Mode=OneWay}"
            SearchMatches="{x:Bind ViewModel.SearchMatches, Mode=OneWay}"
            SearchResultsColumnWidth="{x:Bind ViewModel.SearchResultsColumnWidth, Mode=OneWay}"
            SearchResultsVisibility="{x:Bind ViewModel.SearchResultsVisibility, Mode=OneWay}"
            StatusText="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            LoadMoreLinesRequested="OnLoadMoreLinesRequested" />
    </Grid>
</UserControl>
