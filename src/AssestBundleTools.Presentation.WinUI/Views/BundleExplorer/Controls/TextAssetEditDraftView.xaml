<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.TextAssetEditDraftView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <Grid
        Padding="18,16,18,10"
        Background="Transparent"
        RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ModeHintText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                PlaceholderText=""
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                x:Name="SearchButton"
                Grid.Column="2"
                Click="OnSearchButtonClick"
                IsEnabled="{x:Bind ViewModel.CanSearch, Mode=OneWay}"
                Style="{StaticResource WorkspaceOperationButtonStyle}">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="13"
                    Glyph="&#xE721;" />
            </Button>
        </Grid>

        <Grid
            Grid.Row="1"
            MinHeight="0"
            ColumnSpacing="12"
            Visibility="{x:Bind ViewModel.ReadOnlyViewVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{x:Bind ViewModel.SearchResultsColumnWidth, Mode=OneWay}" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="LineListView"
                MinHeight="0"
                ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:TextAssetEditLineViewModel">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontFamily="Cascadia Mono, Consolas"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind LineNumberText}" />
                            <TextBlock
                                Grid.Column="1"
                                FontFamily="Cascadia Mono, Consolas"
                                Text="{x:Bind Text}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView
                Grid.Column="1"
                MinHeight="0"
                ItemsSource="{x:Bind ViewModel.SearchMatches, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.SearchResultsVisibility, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:TextAssetEditSearchMatchViewModel">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontFamily="Cascadia Mono, Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind LocationText}" />
                            <TextBlock
                                Text="{x:Bind LineText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid
            Grid.Row="1"
            MinHeight="0"
            ColumnSpacing="12"
            Visibility="{x:Bind ViewModel.EditableViewVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{x:Bind ViewModel.SearchResultsColumnWidth, Mode=OneWay}" />
            </Grid.ColumnDefinitions>

            <TextBox
                AcceptsReturn="True"
                FontFamily="Cascadia Mono, Consolas"
                HorizontalAlignment="Stretch"
                IsSpellCheckEnabled="False"
                MinHeight="0"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind ViewModel.EditableText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="NoWrap"
                VerticalAlignment="Stretch" />

            <ListView
                Grid.Column="1"
                MinHeight="0"
                ItemsSource="{x:Bind ViewModel.SearchMatches, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.SearchResultsVisibility, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:TextAssetEditSearchMatchViewModel">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontFamily="Cascadia Mono, Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind LocationText}" />
                            <TextBlock
                                Text="{x:Bind LineText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <TextBlock
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>
</UserControl>
