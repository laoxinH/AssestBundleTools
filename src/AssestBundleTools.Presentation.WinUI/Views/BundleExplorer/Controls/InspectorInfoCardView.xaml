<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.InspectorInfoCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    xmlns:controls="using:AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="InspectorInfoCardBorderStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style
            x:Key="InspectorInfoCardHeaderButtonStyle"
            TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style
            x:Key="InspectorInfoCardCopyButtonStyle"
            TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style
            x:Key="InspectorInfoRowOpenButtonStyle"
            TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style
            x:Key="InspectorInfoCardTitleTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorInfoCardSummaryTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorInfoRowLabelTextStyle"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorInfoRowValueTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
    </UserControl.Resources>

    <Border
        DataContext="{Binding Card, ElementName=Root}"
        Style="{StaticResource InspectorInfoCardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Padding="6,6,6,4"
                ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Click="OnHeaderButtonClick"
                    Style="{StaticResource InspectorInfoCardHeaderButtonStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource AppIconFontFamily}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{Binding ExpandGlyph}" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                Style="{StaticResource InspectorInfoCardTitleTextStyle}"
                                Text="{Binding Title}" />
                            <TextBlock
                                Style="{StaticResource InspectorInfoCardSummaryTextStyle}"
                                Text="{Binding SummaryText}"
                                Visibility="{Binding SummaryVisibility}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button
                    Grid.Column="1"
                    Click="OnCopyButtonClick"
                    Style="{StaticResource InspectorInfoCardCopyButtonStyle}"
                    ToolTipService.ToolTip="{Binding CopyToolTipText}"
                    Visibility="{Binding CopyButtonVisibility}">
                    <FontIcon
                        FontFamily="{StaticResource AppIconFontFamily}"
                        Glyph="&#xE5D7;" />
                </Button>
            </Grid>

            <Border
                Grid.Row="1"
                Margin="12,0,12,0"
                Background="{ThemeResource CardStrokeColorDefaultBrush}"
                Height="1"
                Visibility="{Binding ContentVisibility}" />

            <StackPanel
                Grid.Row="2"
                Margin="12,6,12,12"
                Visibility="{Binding ContentVisibility}">
                <controls:InspectorMaterialAppearanceSampleView
                    Margin="0,0,0,10"
                    ViewModel="{Binding VisualMaterialAppearance}"
                    Visibility="{Binding MaterialAppearanceVisualVisibility}" />

                <Border
                    Margin="0,0,0,10"
                    MinHeight="138"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding ImagePreviewVisualVisibility}">
                    <Grid>
                        <Image
                            MaxHeight="220"
                            Source="{Binding VisualImageSource}"
                            Stretch="Uniform" />
                        <Rectangle
                            Fill="{Binding VisualImageTintBrush}"
                            Opacity="0.28"
                            Visibility="{Binding ImagePreviewTintVisibility}" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bindings:InspectorInfoRowViewModel">
                            <Grid
                                Margin="0,0,0,8"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="42"
                                    Height="42"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Visibility="{x:Bind VisualVisibility, Mode=OneTime}">
                                    <Grid>
                                        <Image
                                            Source="{x:Bind ThumbnailImageSource, Mode=OneTime}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind ThumbnailVisibility, Mode=OneTime}" />
                                        <Rectangle
                                            Margin="6"
                                            Fill="{x:Bind ColorSwatchBrush, Mode=OneTime}"
                                            RadiusX="6"
                                            RadiusY="6"
                                            Visibility="{x:Bind ColorSwatchVisibility, Mode=OneTime}" />
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource AppIconFontFamily}"
                                            FontSize="15"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xEA6A;"
                                            Visibility="{x:Bind ThumbnailPlaceholderVisibility, Mode=OneTime}" />
                                    </Grid>
                                </Border>

                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource InspectorInfoRowLabelTextStyle}"
                                    Text="{x:Bind Label, Mode=OneTime}"
                                    Visibility="{x:Bind LabelVisibility, Mode=OneTime}" />

                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource InspectorInfoRowValueTextStyle}"
                                    Text="{x:Bind Value, Mode=OneTime}" />

                                <Button
                                    Grid.Column="3"
                                    Margin="0,-4,0,0"
                                    AutomationProperties.Name="{x:Bind OpenButtonText, Mode=OneTime}"
                                    Click="OnResolvedAssetOpenButtonClick"
                                    Style="{StaticResource InspectorInfoRowOpenButtonStyle}"
                                    Tag="{x:Bind Target, Mode=OneTime}"
                                    ToolTipService.ToolTip="{x:Bind OpenButtonToolTipText, Mode=OneTime}"
                                    Visibility="{x:Bind OpenButtonVisibility, Mode=OneTime}">
                                    <FontIcon
                                        FontFamily="{StaticResource AppIconFontFamily}"
                                        FontSize="12"
                                        Glyph="&#xECF4;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
