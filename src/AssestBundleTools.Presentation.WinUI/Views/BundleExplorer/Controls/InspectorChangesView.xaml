<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.InspectorChangesView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="ChangeRecordActionButtonStyle"
            TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid DataContext="{Binding ViewModel, ElementName=Root}">
        <ScrollViewer
            x:Name="ChangesSectionScrollViewer"
            MinHeight="0"
            Tag="3"
            ViewChanged="OnChangesSectionScrollViewerViewChanged"
            Visibility="{Binding ChangesSectionVisibility}">
            <StackPanel>
                <Grid
                    Margin="8,8,8,10"
                    Visibility="{Binding RestoreOriginalVisibility}">
                    <Button
                        x:Name="RestoreOriginalButton"
                        HorizontalAlignment="Right"
                        Click="OnRestoreOriginalButtonClick"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource ChangeRecordActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="{StaticResource AppIconFontFamily}"
                                FontSize="13"
                                Glyph="&#xE72C;" />
                            <TextBlock x:Name="RestoreOriginalButtonText" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl
                    Padding="8,0,8,8"
                    ItemsSource="{Binding ChangeRecords}"
                    Visibility="{Binding ChangeRecordsListVisibility}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:InspectorChangeRecordViewModel">
                        <Border
                            Margin="0,0,0,8"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="32"
                                    Height="32"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource AppIconFontFamily}"
                                        FontSize="14"
                                        Glyph="{x:Bind Glyph, Mode=OneTime}" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind TitleText, Mode=OneTime}"
                                            TextWrapping="WrapWholeWords" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="8,3"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="8"
                                            Visibility="{x:Bind BadgeVisibility, Mode=OneTime}">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind BadgeText, Mode=OneTime}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind SourceText, Mode=OneTime}"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="{x:Bind SourceTextVisibility, Mode=OneTime}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind TimeText, Mode=OneTime}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        FontFamily="Cascadia Mono"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind SecondaryText, Mode=OneTime}"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="{x:Bind SecondaryTextVisibility, Mode=OneTime}" />

                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button
                                            Click="OnUndoReplacementButtonClick"
                                            IsEnabled="{x:Bind IsActionEnabled, Mode=OneWay}"
                                            Style="{StaticResource ChangeRecordActionButtonStyle}"
                                            Tag="{x:Bind OperationId, Mode=OneTime}"
                                            Visibility="{x:Bind UndoButtonVisibility, Mode=OneTime}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <ProgressRing
                                                    Width="12"
                                                    Height="12"
                                                    IsActive="{x:Bind IsPending, Mode=OneWay}"
                                                    Visibility="{x:Bind PendingVisibility, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind UndoButtonText, Mode=OneTime}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Click="OnRedoReplacementButtonClick"
                                            IsEnabled="{x:Bind IsActionEnabled, Mode=OneWay}"
                                            Style="{StaticResource ChangeRecordActionButtonStyle}"
                                            Tag="{x:Bind OperationId, Mode=OneTime}"
                                            Visibility="{x:Bind RedoButtonVisibility, Mode=OneTime}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <ProgressRing
                                                    Width="12"
                                                    Height="12"
                                                    IsActive="{x:Bind IsPending, Mode=OneWay}"
                                                    Visibility="{x:Bind PendingVisibility, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind RedoButtonText, Mode=OneTime}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Click="OnDeleteRecordButtonClick"
                                            IsEnabled="{x:Bind IsActionEnabled, Mode=OneWay}"
                                            Style="{StaticResource ChangeRecordActionButtonStyle}"
                                            Tag="{x:Bind OperationId, Mode=OneTime}"
                                            Visibility="{x:Bind DeleteButtonVisibility, Mode=OneTime}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <ProgressRing
                                                    Width="12"
                                                    Height="12"
                                                    IsActive="{x:Bind IsPending, Mode=OneWay}"
                                                    Visibility="{x:Bind PendingVisibility, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind DeleteButtonText, Mode=OneTime}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid
            x:Name="ChangesEmptyState"
            Padding="16"
            Visibility="{Binding ChangeRecordsEmptyStateVisibility}">
            <StackPanel
                MaxWidth="320"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <Border
                    Width="52"
                    Height="52"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="24"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xEA2E;" />
                </Border>
                <TextBlock
                    x:Name="ChangesEmptyStateTitleText"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding ChangeSummaryText}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
