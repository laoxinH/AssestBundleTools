<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.AssetPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="AssetPaneToolbarIconButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="AssetPaneFilterComboBoxStyle"
            BasedOn="{StaticResource DefaultComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style
            x:Key="AssetPaneListViewItemStyle"
            TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <!-- 资产列表行已经在 DataTemplate 内自绘选中、悬停和按压层，
                             这里改为极简容器模板，避免系统默认高亮再叠一层矩形状态。 -->
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="AssetPaneTableHeaderTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style
            x:Key="AssetPanePrimaryNameTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.75" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style
            x:Key="AssetPaneSecondaryPathTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style
            x:Key="AssetPaneBodyCellTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style
            x:Key="AssetPaneSortableHeaderButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style
            x:Key="AssetPaneEmptyStateCardStyle"
            TargetType="Border">
            <Setter Property="MaxWidth" Value="430" />
            <Setter Property="Padding" Value="24,22" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style
            x:Key="AssetPaneEmptyStateIconBadgeStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style
            x:Key="AssetPaneEmptyStateTitleTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="AssetPaneEmptyStateBodyTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="350" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="AssetPaneEmptyStateHintTextStyle"
            BasedOn="{StaticResource AssetPaneEmptyStateBodyTextStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="MaxWidth" Value="330" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton
                        x:Name="AssetsViewModeToggleButton"
                        Checked="OnAssetsViewModeToggleButtonChecked"
                        IsChecked="{x:Bind ViewModel.IsAssetViewMode, Mode=OneWay}"
                        Unchecked="OnAssetsViewModeToggleButtonUnchecked"
                        Style="{StaticResource CompactSegmentToggleButtonStyle}" />

                    <ToggleButton
                        x:Name="SpineGroupsViewModeToggleButton"
                        Checked="OnSpineGroupsViewModeToggleButtonChecked"
                        IsChecked="{x:Bind ViewModel.IsSpineGroupViewMode, Mode=OneWay}"
                        Unchecked="OnSpineGroupsViewModeToggleButtonUnchecked"
                        Style="{StaticResource CompactSegmentToggleButtonStyle}" />
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.AssetFilterVisibility, Mode=OneWay}">
                    <ComboBox
                        x:Name="FilterComboBox"
                        ItemsSource="{x:Bind ViewModel.AssetTypeOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedAssetTypeOption, Mode=TwoWay}"
                        SelectionChanged="OnFilterSelectionChanged"
                        Style="{StaticResource AssetPaneFilterComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:AssetTypeOptionViewModel">
                                <TextBlock Text="{x:Bind DisplayText}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleButton
                            x:Name="ModifiedOnlyToggleButton"
                            Checked="OnModifiedOnlyToggleButtonChecked"
                            IsChecked="{x:Bind ViewModel.ShowModifiedOnly, Mode=OneWay}"
                            Unchecked="OnModifiedOnlyToggleButtonUnchecked"
                            Style="{StaticResource CompactSegmentToggleButtonStyle}" />

                        <ToggleButton
                            x:Name="PreviewOnlyToggleButton"
                            Checked="OnPreviewOnlyToggleButtonChecked"
                            IsChecked="{x:Bind ViewModel.ShowPreviewableOnly, Mode=OneWay}"
                            Unchecked="OnPreviewOnlyToggleButtonUnchecked"
                            Style="{StaticResource CompactSegmentToggleButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Button
                x:Name="SearchToggleButton"
                Grid.Column="1"
                Click="OnSearchToggleButtonClick"
                IsEnabled="{x:Bind ViewModel.CanToggleSearch, Mode=OneWay}"
                Style="{StaticResource AssetPaneToolbarIconButtonStyle}"
                VerticalAlignment="Center">
                <Button.Resources>
                    <SolidColorBrush
                        x:Key="ButtonBackground"
                        Color="Transparent" />
                    <SolidColorBrush
                        x:Key="ButtonBackgroundPointerOver"
                        Color="#10000000" />
                    <SolidColorBrush
                        x:Key="ButtonBackgroundPressed"
                        Color="#16000000" />
                    <SolidColorBrush
                        x:Key="ButtonBorderBrush"
                        Color="Transparent" />
                    <SolidColorBrush
                        x:Key="ButtonBorderBrushPointerOver"
                        Color="Transparent" />
                    <SolidColorBrush
                        x:Key="ButtonBorderBrushPressed"
                        Color="Transparent" />
                </Button.Resources>
                <FontIcon
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Glyph="{x:Bind ViewModel.SearchToggleGlyph, Mode=OneWay}" />
            </Button>
        </Grid>

        <Border
            x:Name="SearchHost"
            Grid.Row="1"
            Height="0"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SearchTranslateTransform" Y="-6" />
            </Border.RenderTransform>

            <TextBox
                x:Name="SearchTextBox"
                Text="{x:Bind ViewModel.SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="OnSearchTextChanged" />
        </Border>

        <Grid
            Grid.Row="2"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.MultiSelectionQuickActionsVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="10,7"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="8">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBlock
                        x:Name="MultiSelectionLabelText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.SelectedItemCount, Mode=OneWay}" />
                    <TextBlock
                        x:Name="MultiSelectionUnitText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="ExitMultiSelectionButton"
                    Click="OnExitMultiSelectionButtonClick"
                    Style="{StaticResource AssetPaneToolbarIconButtonStyle}">
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="15"
                        Glyph="&#xE711;" />
                </Button>
                <Button
                    x:Name="SelectAllMultiSelectionButton"
                    Click="OnSelectAllMultiSelectionButtonClick"
                    Style="{StaticResource AssetPaneToolbarIconButtonStyle}">
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="15"
                        Glyph="&#xE762;" />
                </Button>
                <Button
                    x:Name="InvertMultiSelectionButton"
                    Click="OnInvertMultiSelectionButtonClick"
                    Style="{StaticResource AssetPaneToolbarIconButtonStyle}">
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="15"
                        Glyph="&#xE8AB;" />
                </Button>
                <Button
                    x:Name="BatchExtractSelectedButton"
                    Click="OnBatchExtractSelectedButtonClick"
                    IsEnabled="{x:Bind ViewModel.CanBatchExtractSelectedAssets, Mode=OneWay}"
                    Style="{StaticResource AssetPaneToolbarIconButtonStyle}">
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="15"
                        Glyph="&#xE896;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <ListView
                x:Name="AssetListView"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                ItemContainerStyle="{StaticResource AssetPaneListViewItemStyle}"
                SelectionMode="Extended"
                SelectionChanged="OnAssetListSelectionChanged"
                Visibility="{x:Bind ViewModel.AssetListVisibility, Mode=OneWay}">
                <!-- 表头放进 ListView.Header，确保它和数据行共享同一内容宽度，
                     避免垂直滚动条出现后，外置表头与数据列产生位移。 -->
                <ListView.Header>
                    <Grid Padding="4,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Grid.Column="2"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="AssetNameSortButton"
                                Click="OnAssetNameSortButtonClick"
                                Style="{StaticResource AssetPaneSortableHeaderButtonStyle}">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <TextBlock
                                        x:Name="AssetNameHeaderText"
                                        Style="{StaticResource AssetPaneTableHeaderTextStyle}" />
                                    <FontIcon
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="10"
                                        Glyph="{x:Bind ViewModel.NameSortGlyph, Mode=OneWay}"
                                        Opacity="{x:Bind ViewModel.NameSortIndicatorOpacity, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                x:Name="AssetTypeHeaderText"
                                Grid.Column="1"
                                Style="{StaticResource AssetPaneTableHeaderTextStyle}" />
                            <Button
                                x:Name="AssetSizeSortButton"
                                Grid.Column="2"
                                Click="OnAssetSizeSortButtonClick"
                                Style="{StaticResource AssetPaneSortableHeaderButtonStyle}">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <TextBlock
                                        x:Name="AssetSizeHeaderText"
                                        Style="{StaticResource AssetPaneTableHeaderTextStyle}" />
                                    <FontIcon
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="10"
                                        Glyph="{x:Bind ViewModel.SizeSortGlyph, Mode=OneWay}"
                                        Opacity="{x:Bind ViewModel.SizeSortIndicatorOpacity, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                x:Name="AssetStateHeaderText"
                                Grid.Column="3"
                                Style="{StaticResource AssetPaneTableHeaderTextStyle}" />
                        </Grid>
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AssetListEntryViewModel">
                        <Grid
                            Padding="4,4,4,5"
                            PointerEntered="OnAssetRowPointerEntered"
                            PointerExited="OnAssetRowPointerExited"
                            PointerPressed="OnAssetRowPointerPressed"
                            PointerReleased="OnAssetRowPointerReleased"
                            PointerCanceled="OnAssetRowPointerCanceled"
                            Tag="{x:Bind}">
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="OnAssetRowContextFlyoutOpening">
                                    <MenuFlyoutItem
                                        Name="OpenAssetPaneItemInNewWindowMenuItem"
                                        Click="OnOpenAssetPaneItemInNewWindowMenuItemClick"
                                        Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                Glyph="&#xE8A7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Name="ExtractAssetPaneItemMenuItem"
                                        Click="OnExtractAssetPaneItemMenuItemClick"
                                        Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                Glyph="&#xE896;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Name="ReplaceAssetPaneItemMenuItem"
                                        Click="OnReplaceAssetPaneItemMenuItemClick"
                                        Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                Glyph="&#xE8AC;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Name="EnterAssetPaneItemMultiSelectionMenuItem"
                                        Click="OnEnterAssetPaneItemMultiSelectionMenuItemClick"
                                        Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                Glyph="&#xE762;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.ColumnSpan="3"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Opacity="{x:Bind SelectionBackgroundOpacity, Mode=OneWay}" />

                            <Border
                                x:Name="AssetRowHoverOverlay"
                                Grid.ColumnSpan="3"
                                Background="#11000000"
                                CornerRadius="6"
                                IsHitTestVisible="False"
                                Opacity="0" />

                            <Border
                                x:Name="AssetRowPressedOverlay"
                                Grid.ColumnSpan="3"
                                Background="#19000000"
                                CornerRadius="6"
                                IsHitTestVisible="False"
                                Opacity="0" />

                            <Border
                                Width="2"
                                Margin="0,8,0,8"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource TextFillColorPrimaryBrush}"
                                CornerRadius="1"
                                Visibility="{x:Bind SelectionIndicatorVisibility, Mode=OneWay}" />

                            <Grid
                                Grid.Column="2"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="1">
                                    <TextBlock
                                        PointerEntered="OnAssetNamePointerEntered"
                                        PointerExited="OnAssetNamePointerExited"
                                        PointerPressed="OnAssetNamePointerPressed"
                                        Unloaded="OnAssetNameTextBlockUnloaded"
                                        Style="{StaticResource AssetPanePrimaryNameTextStyle}"
                                        Text="{x:Bind DisplayName}">
                                        <ToolTipService.ToolTip>
                                            <controls:ToolTip Content="{x:Bind DisplayNameToolTipText}" />
                                        </ToolTipService.ToolTip>
                                    </TextBlock>
                                    <TextBlock
                                        Style="{StaticResource AssetPaneSecondaryPathTextStyle}"
                                        Text="{x:Bind DisplayAssetPath}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource AssetPaneBodyCellTextStyle}"
                                    Text="{x:Bind AssetTypeText}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource AssetPaneBodyCellTextStyle}"
                                    Text="{x:Bind SizeText}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource AssetPaneBodyCellTextStyle}"
                                    Text="{x:Bind StateText, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView
                x:Name="SpineGroupListView"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.SpineGroupItems, Mode=OneWay}"
                ItemContainerStyle="{StaticResource AssetPaneListViewItemStyle}"
                SelectionMode="Extended"
                SelectionChanged="OnSpineGroupListSelectionChanged"
                Visibility="{x:Bind ViewModel.SpineGroupListVisibility, Mode=OneWay}">
                <!-- Spine 组是跨资产聚合入口，首版只展示组成和诊断摘要，不伪装成 Unity 类型。 -->
                <ListView.Header>
                    <Grid Padding="4,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Grid.Column="2"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="SpineGroupNameHeaderText"
                                Style="{StaticResource AssetPaneTableHeaderTextStyle}" />
                            <TextBlock
                                x:Name="SpineGroupPartsHeaderText"
                                Grid.Column="1"
                                Style="{StaticResource AssetPaneTableHeaderTextStyle}" />
                            <TextBlock
                                x:Name="SpineGroupTexturePagesHeaderText"
                                Grid.Column="2"
                                Style="{StaticResource AssetPaneTableHeaderTextStyle}" />
                            <TextBlock
                                x:Name="SpineGroupStateHeaderText"
                                Grid.Column="3"
                                Style="{StaticResource AssetPaneTableHeaderTextStyle}" />
                        </Grid>
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SpineAssetGroupEntryViewModel">
                        <Grid
                            Padding="4,4,4,5"
                            PointerEntered="OnAssetRowPointerEntered"
                            PointerExited="OnAssetRowPointerExited"
                            PointerPressed="OnAssetRowPointerPressed"
                            PointerReleased="OnAssetRowPointerReleased"
                            PointerCanceled="OnAssetRowPointerCanceled"
                            Tag="{x:Bind}">
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="OnSpineGroupRowContextFlyoutOpening">
                                    <MenuFlyoutItem
                                        Name="OpenAssetPaneItemInNewWindowMenuItem"
                                        Click="OnOpenAssetPaneItemInNewWindowMenuItemClick"
                                        Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                Glyph="&#xE8A7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Name="ExtractAssetPaneItemMenuItem"
                                        Click="OnExtractAssetPaneItemMenuItemClick"
                                        Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                Glyph="&#xE896;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Name="ReplaceAssetPaneItemMenuItem"
                                        Click="OnReplaceAssetPaneItemMenuItemClick"
                                        Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                Glyph="&#xE8AC;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Name="EnterAssetPaneItemMultiSelectionMenuItem"
                                        Click="OnEnterAssetPaneItemMultiSelectionMenuItemClick"
                                        Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                Glyph="&#xE762;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.ColumnSpan="3"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Opacity="{x:Bind SelectionBackgroundOpacity, Mode=OneWay}" />

                            <Border
                                x:Name="AssetRowHoverOverlay"
                                Grid.ColumnSpan="3"
                                Background="#11000000"
                                CornerRadius="6"
                                IsHitTestVisible="False"
                                Opacity="0" />

                            <Border
                                x:Name="AssetRowPressedOverlay"
                                Grid.ColumnSpan="3"
                                Background="#19000000"
                                CornerRadius="6"
                                IsHitTestVisible="False"
                                Opacity="0" />

                            <Border
                                Width="2"
                                Margin="0,8,0,8"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource TextFillColorPrimaryBrush}"
                                CornerRadius="1"
                                Visibility="{x:Bind SelectionIndicatorVisibility, Mode=OneWay}" />

                            <Grid
                                Grid.Column="2"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="1">
                                    <TextBlock
                                        Style="{StaticResource AssetPanePrimaryNameTextStyle}"
                                        Text="{x:Bind DisplayName}">
                                        <ToolTipService.ToolTip>
                                            <controls:ToolTip Content="{x:Bind DisplayNameToolTipText}" />
                                        </ToolTipService.ToolTip>
                                    </TextBlock>
                                    <TextBlock
                                        Style="{StaticResource AssetPaneSecondaryPathTextStyle}"
                                        Text="{x:Bind DisplayGroupKey}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource AssetPaneBodyCellTextStyle}"
                                    Text="{x:Bind PartsText}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource AssetPaneBodyCellTextStyle}"
                                    Text="{x:Bind TexturePagesText}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource AssetPaneBodyCellTextStyle}"
                                    Text="{x:Bind StateText, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                x:Name="AssetPaneEmptyStateCard"
                Style="{StaticResource AssetPaneEmptyStateCardStyle}"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="12">
                    <Grid
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Center">
                        <ProgressRing
                            Width="42"
                            Height="42"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind ViewModel.IsListLoading, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.EmptyStateLoadingVisibility, Mode=OneWay}" />
                        <Border
                            Style="{StaticResource AssetPaneEmptyStateIconBadgeStyle}"
                            Visibility="{x:Bind ViewModel.EmptyStateIconVisibility, Mode=OneWay}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="23"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="{x:Bind ViewModel.EmptyStateIconGlyph, Mode=OneWay}" />
                        </Border>
                    </Grid>

                    <TextBlock
                        Style="{StaticResource AssetPaneEmptyStateTitleTextStyle}"
                        Text="{x:Bind ViewModel.EmptyStateTitleText, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource AssetPaneEmptyStateBodyTextStyle}"
                        Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}" />
                    <TextBlock
                        x:Name="EmptyStateHintText"
                        Style="{StaticResource AssetPaneEmptyStateHintTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
