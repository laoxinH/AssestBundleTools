<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.InspectorPreviewSurfaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="InspectorPreviewSurfaceBorderStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter
                Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="CornerRadius"
                Value="12" />
        </Style>

        <Style
            x:Key="InspectorPreviewStateTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="MaxWidth"
                Value="360" />
            <Setter
                Property="HorizontalAlignment"
                Value="Center" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter
                Property="TextAlignment"
                Value="Center" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorPreviewActionButtonStyle"
            TargetType="Button">
            <Setter
                Property="Width"
                Value="32" />
            <Setter
                Property="Height"
                Value="32" />
            <Setter
                Property="MinWidth"
                Value="32" />
            <Setter
                Property="MinHeight"
                Value="32" />
            <Setter
                Property="Padding"
                Value="0" />
            <Setter
                Property="UseSystemFocusVisuals"
                Value="False" />
            <Setter
                Property="CornerRadius"
                Value="10" />
            <Setter
                Property="Background"
                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter
                Property="BorderBrush"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border
                                x:Name="PreviewActionSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <CompositeTransform x:Name="PreviewActionSurfaceTransform" />
                                </Border.RenderTransform>
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="1" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurfaceTransform"
                                                Storyboard.TargetProperty="TranslateY"
                                                To="-0.5"
                                                Duration="0:0:0.08"
                                                EnableDependentAnimation="True" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="1" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurfaceTransform"
                                                Storyboard.TargetProperty="TranslateY"
                                                To="1"
                                                Duration="0:0:0.06"
                                                EnableDependentAnimation="True" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurfaceTransform"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.96"
                                                Duration="0:0:0.06"
                                                EnableDependentAnimation="True" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurfaceTransform"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.96"
                                                Duration="0:0:0.06"
                                                EnableDependentAnimation="True" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.45"
                                                Duration="0:0:0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="InspectorAudioTransportButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style
            x:Key="InspectorAudioBadgeBorderStyle"
            TargetType="Border">
            <Setter Property="Padding" Value="10,6" />
            <Setter
                Property="Background"
                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style
            x:Key="InspectorAudioBadgeTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorPreviewOverlayBadgeBorderStyle"
            TargetType="Border">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="#E6111115" />
            <Setter
                Property="BorderBrush"
                Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style
            x:Key="InspectorPreviewOverlayBadgeTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorSpriteFocusPreviewCardStyle"
            TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter
                Property="Background"
                Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter
                Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </UserControl.Resources>

    <Border
        Height="{x:Bind ViewModel.Preview.PreviewSurfaceHeight, Mode=OneWay}"
        MinHeight="{x:Bind ViewModel.Preview.PreviewSurfaceMinHeight, Mode=OneWay}"
        Padding="12"
        Style="{StaticResource InspectorPreviewSurfaceBorderStyle}">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Button
                    x:Name="OpenPreviewLocationButton"
                    HorizontalAlignment="Right"
                    Click="OnOpenPreviewLocationButtonClick"
                    IsEnabled="{x:Bind ViewModel.Preview.CanOpenPreviewLocation, Mode=OneWay}"
                    Style="{StaticResource InspectorPreviewActionButtonStyle}"
                    Visibility="{x:Bind ViewModel.Preview.PreviewOpenLocationVisibility, Mode=OneWay}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        Glyph="&#xE838;" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.Preview.PreviewLoadingVisibility, Mode=OneWay}">
                    <ProgressRing
                        Width="30"
                        Height="30"
                        IsActive="True" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Preview.PreviewStatusText, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.Preview.PreviewMessageVisibility, Mode=OneWay}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="26"
                        Glyph="&#xE7BA;" />
                    <TextBlock
                        Style="{StaticResource InspectorPreviewStateTextStyle}"
                        Text="{x:Bind ViewModel.Preview.PreviewStatusText, Mode=OneWay}" />
                </StackPanel>

                <Grid
                    Margin="8"
                    Visibility="{x:Bind ViewModel.Preview.PreviewImageVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="PreviewImageViewportHost"
                        Grid.Row="0"
                        SizeChanged="OnPreviewImageViewportHostSizeChanged">
                        <Rectangle>
                            <Rectangle.Fill>
                                <ImageBrush
                                    ImageSource="ms-appx:///Assets/PreviewCheckerboard.png"
                                    Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>

                        <Viewbox
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform"
                            StretchDirection="DownOnly">
                            <Grid
                                Width="{x:Bind ViewModel.Preview.Image.CanvasWidth, Mode=OneWay}"
                                Height="{x:Bind ViewModel.Preview.Image.CanvasHeight, Mode=OneWay}">
                                <Image
                                    Width="{x:Bind ViewModel.Preview.Image.CanvasWidth, Mode=OneWay}"
                                    Height="{x:Bind ViewModel.Preview.Image.CanvasHeight, Mode=OneWay}"
                                    Source="{x:Bind ViewModel.Preview.Image.ImageSource, Mode=OneWay}"
                                    Stretch="Fill" />
                            </Grid>
                        </Viewbox>

                        <Canvas
                            IsHitTestVisible="False"
                            Visibility="{x:Bind ViewModel.Preview.Image.OverlayVisibility, Mode=OneWay}">
                            <Rectangle
                                Canvas.Left="{x:Bind ViewModel.Preview.Image.OverlayX, Mode=OneWay}"
                                Canvas.Top="{x:Bind ViewModel.Preview.Image.OverlayY, Mode=OneWay}"
                                Width="{x:Bind ViewModel.Preview.Image.OverlayWidth, Mode=OneWay}"
                                Height="{x:Bind ViewModel.Preview.Image.OverlayHeight, Mode=OneWay}"
                                RadiusX="6"
                                RadiusY="6"
                                Fill="Transparent"
                                Stroke="#CC101418"
                                StrokeThickness="1.5" />

                            <Rectangle
                                Canvas.Left="{x:Bind ViewModel.Preview.Image.OverlayX, Mode=OneWay}"
                                Canvas.Top="{x:Bind ViewModel.Preview.Image.OverlayY, Mode=OneWay}"
                                Width="{x:Bind ViewModel.Preview.Image.OverlayWidth, Mode=OneWay}"
                                Height="{x:Bind ViewModel.Preview.Image.OverlayHeight, Mode=OneWay}"
                                RadiusX="6"
                                RadiusY="6"
                                Fill="Transparent"
                                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                StrokeThickness="0.75" />

                            <Line
                                X1="{x:Bind ViewModel.Preview.Image.BorderLeftX, Mode=OneWay}"
                                X2="{x:Bind ViewModel.Preview.Image.BorderLeftX, Mode=OneWay}"
                                Y1="{x:Bind ViewModel.Preview.Image.BorderVerticalTop, Mode=OneWay}"
                                Y2="{x:Bind ViewModel.Preview.Image.BorderVerticalBottom, Mode=OneWay}"
                                Stroke="{ThemeResource AccentFillColorSecondaryBrush}"
                                StrokeThickness="0.75"
                                Visibility="{x:Bind ViewModel.Preview.Image.BorderVisibility, Mode=OneWay}" />
                            <Line
                                X1="{x:Bind ViewModel.Preview.Image.BorderRightX, Mode=OneWay}"
                                X2="{x:Bind ViewModel.Preview.Image.BorderRightX, Mode=OneWay}"
                                Y1="{x:Bind ViewModel.Preview.Image.BorderVerticalTop, Mode=OneWay}"
                                Y2="{x:Bind ViewModel.Preview.Image.BorderVerticalBottom, Mode=OneWay}"
                                Stroke="{ThemeResource AccentFillColorSecondaryBrush}"
                                StrokeThickness="0.75"
                                Visibility="{x:Bind ViewModel.Preview.Image.BorderVisibility, Mode=OneWay}" />
                            <Line
                                X1="{x:Bind ViewModel.Preview.Image.BorderHorizontalLeft, Mode=OneWay}"
                                X2="{x:Bind ViewModel.Preview.Image.BorderHorizontalRight, Mode=OneWay}"
                                Y1="{x:Bind ViewModel.Preview.Image.BorderTopY, Mode=OneWay}"
                                Y2="{x:Bind ViewModel.Preview.Image.BorderTopY, Mode=OneWay}"
                                Stroke="{ThemeResource AccentFillColorSecondaryBrush}"
                                StrokeThickness="0.75"
                                Visibility="{x:Bind ViewModel.Preview.Image.BorderVisibility, Mode=OneWay}" />
                            <Line
                                X1="{x:Bind ViewModel.Preview.Image.BorderHorizontalLeft, Mode=OneWay}"
                                X2="{x:Bind ViewModel.Preview.Image.BorderHorizontalRight, Mode=OneWay}"
                                Y1="{x:Bind ViewModel.Preview.Image.BorderBottomY, Mode=OneWay}"
                                Y2="{x:Bind ViewModel.Preview.Image.BorderBottomY, Mode=OneWay}"
                                Stroke="{ThemeResource AccentFillColorSecondaryBrush}"
                                StrokeThickness="0.75"
                                Visibility="{x:Bind ViewModel.Preview.Image.BorderVisibility, Mode=OneWay}" />

                            <Ellipse
                                Width="10"
                                Height="10"
                                Canvas.Left="{x:Bind ViewModel.Preview.Image.PivotX, Mode=OneWay}"
                                Canvas.Top="{x:Bind ViewModel.Preview.Image.PivotY, Mode=OneWay}"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                Stroke="#EE101418"
                                StrokeThickness="1"
                                Visibility="{x:Bind ViewModel.Preview.Image.PivotVisibility, Mode=OneWay}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="-5" Y="-5" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <Border
                                MaxWidth="320"
                                Canvas.Left="{x:Bind ViewModel.Preview.Image.OverlayLabelX, Mode=OneWay}"
                                Canvas.Top="{x:Bind ViewModel.Preview.Image.OverlayLabelY, Mode=OneWay}"
                                Style="{StaticResource InspectorPreviewOverlayBadgeBorderStyle}">
                                <TextBlock
                                    Style="{StaticResource InspectorPreviewOverlayBadgeTextStyle}"
                                    Text="{x:Bind ViewModel.Preview.Image.OverlayLabelText, Mode=OneWay}" />
                            </Border>
                        </Canvas>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        Style="{StaticResource InspectorSpriteFocusPreviewCardStyle}"
                        Visibility="{x:Bind ViewModel.Preview.Image.SpriteFocusPreviewVisibility, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="96"
                                Height="72"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <ImageBrush
                                                ImageSource="ms-appx:///Assets/PreviewCheckerboard.png"
                                                Stretch="UniformToFill" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Image
                                        Margin="6"
                                        Source="{x:Bind ViewModel.Preview.Image.SpriteFocusImageSource, Mode=OneWay}"
                                        Stretch="Uniform" />
                                </Grid>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.Preview.Image.SpriteFocusPreviewTitleText, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.Preview.Image.SpriteFocusPreviewSizeText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel
                    Margin="8,0,8,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.Preview.PreviewAudioVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="40"
                            Height="40"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            CornerRadius="12">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="18"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE8D6;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.AssetName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Preview.AudioPreviewSizeSummaryText, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.Preview.AudioPreviewSizeSummaryVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid
                        ColumnSpacing="6"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource InspectorAudioBadgeBorderStyle}"
                            Visibility="{x:Bind ViewModel.Preview.AudioPreviewContainerBadgeVisibility, Mode=OneWay}">
                            <TextBlock
                                Style="{StaticResource InspectorAudioBadgeTextStyle}"
                                Text="{x:Bind ViewModel.Preview.AudioPreviewContainerBadgeText, Mode=OneWay}" />
                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource InspectorAudioBadgeBorderStyle}"
                            Visibility="{x:Bind ViewModel.Preview.AudioPreviewDurationBadgeVisibility, Mode=OneWay}">
                            <TextBlock
                                Style="{StaticResource InspectorAudioBadgeTextStyle}"
                                Text="{x:Bind ViewModel.Preview.AudioPreviewDurationBadgeText, Mode=OneWay}" />
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource InspectorAudioBadgeBorderStyle}"
                            Visibility="{x:Bind ViewModel.Preview.AudioPreviewChannelBadgeVisibility, Mode=OneWay}">
                            <TextBlock
                                Style="{StaticResource InspectorAudioBadgeTextStyle}"
                                Text="{x:Bind ViewModel.Preview.AudioPreviewChannelBadgeText, Mode=OneWay}" />
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource InspectorAudioBadgeBorderStyle}"
                            Visibility="{x:Bind ViewModel.Preview.AudioPreviewFrequencyBadgeVisibility, Mode=OneWay}">
                            <TextBlock
                                Style="{StaticResource InspectorAudioBadgeTextStyle}"
                                Text="{x:Bind ViewModel.Preview.AudioPreviewFrequencyBadgeText, Mode=OneWay}" />
                        </Border>
                    </Grid>

                    <MediaPlayerElement
                        x:Name="AudioPreviewPlayer"
                        Width="1"
                        Height="1"
                        HorizontalAlignment="Left"
                        AreTransportControlsEnabled="False"
                        AutoPlay="False"
                        IsHitTestVisible="False"
                        Opacity="0.01"
                        Source="{x:Bind ViewModel.Preview.PreviewAudioSource, Mode=OneWay}" />

                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="AudioTransportPlayPauseButton"
                                Click="OnAudioTransportPlayPauseButtonClick"
                                Style="{StaticResource InspectorAudioTransportButtonStyle}">
                                <FontIcon
                                    x:Name="AudioTransportPlayPauseIcon"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE768;" />
                            </Button>

                            <Button
                                x:Name="AudioTransportResetButton"
                                Grid.Column="1"
                                Click="OnAudioTransportResetButtonClick"
                                Style="{StaticResource InspectorAudioTransportButtonStyle}">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE72C;" />
                            </Button>

                            <TextBlock
                                x:Name="AudioTransportTimeText"
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                FontFamily="Cascadia Mono"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="00:00 / 00:00" />
                        </Grid>

                        <Slider
                            x:Name="AudioTransportPositionSlider"
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.1"
                            ValueChanged="OnAudioTransportPositionSliderValueChanged" />
                    </Grid>
                </StackPanel>

                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled"
                    Visibility="{x:Bind ViewModel.Preview.PreviewTextVisibility, Mode=OneWay}"
                    ZoomMode="Disabled">
                    <TextBlock
                        FontFamily="Cascadia Mono"
                        FontSize="13"
                        Text="{x:Bind ViewModel.Preview.PreviewText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </ScrollViewer>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.Preview.PreviewSummaryVisibility, Mode=OneWay}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="26"
                        Glyph="&#xE7BA;" />
                    <TextBlock
                        Style="{StaticResource InspectorPreviewStateTextStyle}"
                        Text="{x:Bind ViewModel.Preview.PreviewText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
