<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.InspectorAnimationClipPreviewSurfaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="AnimationClipPreviewSecondaryTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="AnimationClipPreviewSectionTitleStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style
            x:Key="AnimationClipPreviewCardStyle"
            TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="42"
                Height="42"
                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                CornerRadius="13">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="18"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Glyph="&#xE8B9;" />
            </Border>

            <StackPanel
                Grid.Column="1"
                Spacing="2">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    MaxLines="2"
                    Text="{x:Bind ViewModel.AssetNameText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    MaxLines="2"
                    Style="{StaticResource AnimationClipPreviewSecondaryTextStyle}"
                    Text="{x:Bind ViewModel.TimingText, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Border
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="4">
                <TextBlock
                    FontWeight="SemiBold"
                    MaxLines="2"
                    Text="{x:Bind ViewModel.CurveCountText, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    MaxLines="1"
                    Style="{StaticResource AnimationClipPreviewSecondaryTextStyle}"
                    Text="{x:Bind ViewModel.BindingSummaryText, Mode=OneWay}" />
                <TextBlock
                    MaxLines="1"
                    Style="{StaticResource AnimationClipPreviewSecondaryTextStyle}"
                    Text="{x:Bind ViewModel.LegacyText, Mode=OneWay}" />
                <TextBlock
                    MaxLines="1"
                    Style="{StaticResource AnimationClipPreviewSecondaryTextStyle}"
                    Text="{x:Bind ViewModel.LoopText, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <StackPanel Spacing="4">
            <TextBlock
                Style="{StaticResource AnimationClipPreviewSectionTitleStyle}"
                Text="{x:Bind ViewModel.EventsTitle, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource AnimationClipPreviewSecondaryTextStyle}"
                Text="{x:Bind ViewModel.EventSummaryText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.EventRowsVisibility, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource AnimationClipPreviewSecondaryTextStyle}"
                Text="{x:Bind ViewModel.EmptyEventsText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.EventRowsEmptyVisibility, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource AnimationClipPreviewSecondaryTextStyle}"
                Text="{x:Bind ViewModel.TruncatedText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.TruncatedTextVisibility, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
