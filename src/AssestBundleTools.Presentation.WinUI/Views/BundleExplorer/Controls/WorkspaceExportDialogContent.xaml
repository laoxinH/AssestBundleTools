<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.WorkspaceExportDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ThemeShadow x:Key="WorkspaceExportCardShadow" />
        <Style x:Key="WorkspaceExportSectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="WorkspaceExportSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="WorkspaceExportPanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Shadow" Value="{StaticResource WorkspaceExportCardShadow}" />
        </Style>
        <Style x:Key="WorkspaceExportCompactButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" MinWidth="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource WorkspaceExportPanelCardStyle}" Translation="0,0,8">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="BundleSectionTitleText"
                        Style="{StaticResource WorkspaceExportSectionTitleTextStyle}" />
                    <TextBlock
                        x:Name="BundleSectionHintText"
                        Style="{StaticResource WorkspaceExportSecondaryTextStyle}" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="BundleSearchTextBox"
                        Text="{Binding BundleSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding BundleSortOptions}"
                        SelectedItem="{Binding SelectedBundleSortOption, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName" />
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="SelectAllBundlesButton"
                        Click="OnSelectAllBundlesButtonClick"
                        Style="{StaticResource WorkspaceExportCompactButtonStyle}" />
                    <Button
                        x:Name="ClearBundleSelectionButton"
                        Click="OnClearBundleSelectionButtonClick"
                        Style="{StaticResource WorkspaceExportCompactButtonStyle}" />
                </StackPanel>
                <ListView
                    Grid.Row="3"
                    ItemsSource="{Binding VisibleBundles}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border
                                    Margin="0,4,0,2"
                                    Padding="8,2"
                                    Visibility="{Binding HeaderVisibility}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding HeaderText}" />
                                        <Rectangle
                                            Grid.Column="1"
                                            Height="1"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    </Grid>
                                </Border>
                                <Grid
                                    MinHeight="78"
                                    Padding="8"
                                    ColumnSpacing="12"
                                    Visibility="{Binding BundleVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        Width="28"
                                        MinWidth="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding Bundle.IsSelected, Mode=TwoWay}" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Bundle.DisplayName}" />
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Bundle.SummaryText}" />
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Bundle.OutputPath}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource WorkspaceExportPanelCardStyle}" Translation="0,0,8">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="ResourceProcessorSectionTitleText"
                            Style="{StaticResource WorkspaceExportSectionTitleTextStyle}" />
                        <TextBlock
                            x:Name="ResourceProcessorSectionHintText"
                            Style="{StaticResource WorkspaceExportSecondaryTextStyle}" />
                    </StackPanel>
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{Binding ResourceProcessors}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="210" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        Width="28"
                                        MinWidth="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Description}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding Processors}"
                                        SelectedItem="{Binding SelectedProcessor, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Description}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource WorkspaceExportPanelCardStyle}" Translation="0,0,8">
                <Grid ColumnSpacing="10" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="ExportToWorkspaceDirectoryCheckBox"
                        Grid.ColumnSpan="2"
                        IsChecked="{Binding ExportToWorkspaceDirectory, Mode=TwoWay}" />
                    <CheckBox
                        x:Name="OverwriteExistingFilesCheckBox"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        IsChecked="{Binding OverwriteExistingFiles, Mode=TwoWay}" />
                    <CheckBox
                        x:Name="ForceAudioPayloadWriteCheckBox"
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        IsChecked="{Binding ForceAudioPayloadWrite, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="{Binding ForceAudioWarningText}"
                        TextWrapping="WrapWholeWords" />
                    <Border
                        Grid.Row="4"
                        Padding="10,4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <TextBlock x:Name="OutputDirectoryLabelText" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{Binding OutputDirectoryText}"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border
                        Grid.Row="5"
                        Padding="10,4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <TextBlock x:Name="CompressionModeLabelText" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <ComboBox
                        Grid.Row="5"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding CompressionOptions}"
                        SelectedItem="{Binding SelectedCompressionOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
