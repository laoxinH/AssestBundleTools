<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.WorkspaceExportDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ThemeShadow x:Key="WorkspaceExportCardShadow" />
        <Style x:Key="WorkspaceExportSectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="WorkspaceExportCardTitleIconStyle" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="WorkspaceExportSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="WorkspaceExportPanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Shadow" Value="{StaticResource WorkspaceExportCardShadow}" />
        </Style>
        <Style x:Key="WorkspaceExportCompactButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <DataTemplate x:Key="WorkspaceExportComboBoxItemTemplate">
            <StackPanel Spacing="1" MaxWidth="320">
                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Text="{Binding Description}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*" MinWidth="440" />
            <ColumnDefinition Width="105*" MinWidth="500" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource WorkspaceExportPanelCardStyle}" Translation="0,0,8">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource WorkspaceExportCardTitleIconStyle}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="12"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE8A5;" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            x:Name="BundleSectionTitleText"
                            Style="{StaticResource WorkspaceExportSectionTitleTextStyle}" />
                        <TextBlock
                            x:Name="BundleSectionHintText"
                            Style="{StaticResource WorkspaceExportSecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="168" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="BundleSearchTextBox"
                        MinHeight="38"
                        Text="{Binding BundleSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Grid.Column="1"
                        MinHeight="38"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding BundleSortOptions}"
                        SelectedItem="{Binding SelectedBundleSortOption, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName" />
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="SelectAllBundlesButton"
                            Click="OnSelectAllBundlesButtonClick"
                            Style="{StaticResource WorkspaceExportCompactButtonStyle}" />
                        <Button
                            x:Name="ClearBundleSelectionButton"
                            Click="OnClearBundleSelectionButtonClick"
                            Style="{StaticResource WorkspaceExportCompactButtonStyle}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding SelectedBundleCountText}" />
                </Grid>
                <ListView
                    Grid.Row="3"
                    ItemsSource="{Binding VisibleBundles}"
                    SelectionMode="None"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border
                                    Margin="0,4,0,2"
                                    Padding="8,2"
                                    Visibility="{Binding HeaderVisibility}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding HeaderText}" />
                                    </Grid>
                                </Border>
                                <Grid
                                    MinHeight="88"
                                    Padding="8"
                                    ColumnSpacing="10"
                                    Visibility="{Binding BundleVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        Width="28"
                                        MinWidth="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding Bundle.IsSelected, Mode=TwoWay}" />
                                    <Border
                                        Grid.Column="1"
                                        Width="30"
                                        Height="34"
                                        VerticalAlignment="Center"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="18"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE8A5;" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{Binding Bundle.DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Bundle.SummaryText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Bundle.OutputPath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Spacing="8">
                                        <Border
                                            Padding="9,2"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="10"
                                            Visibility="{Binding Bundle.ModifiedStatusVisibility}">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Text="{Binding Bundle.StatusText}" />
                                        </Border>
                                        <Border
                                            Padding="9,2"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="10"
                                            Visibility="{Binding Bundle.UnmodifiedStatusVisibility}">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Bundle.StatusText}" />
                                        </Border>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Bundle.LastChangedLocalTimeText}"
                                            Visibility="{Binding Bundle.LastChangedLocalTimeVisibility}" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource WorkspaceExportPanelCardStyle}" Translation="0,0,8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource WorkspaceExportCardTitleIconStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE713;" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                x:Name="ResourceProcessorSectionTitleText"
                                Style="{StaticResource WorkspaceExportSectionTitleTextStyle}" />
                            <TextBlock
                                x:Name="ResourceProcessorSectionHintText"
                                Style="{StaticResource WorkspaceExportSecondaryTextStyle}" />
                        </StackPanel>
                        <StackPanel
                            x:Name="ResourceProcessorHelpHost"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6"
                            Background="Transparent"
                            PointerEntered="OnResourceProcessorHelpPointerEntered"
                            PointerExited="OnResourceProcessorHelpPointerExited"
                            ToolTipService.Placement="Right">
                            <TextBlock
                                x:Name="ResourceProcessorHelpText"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                            <FontIcon
                                x:Name="ResourceProcessorHelpIcon"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE946;" />
                        </StackPanel>
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{Binding ResourceProcessors}"
                        SelectionMode="None"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="70" Padding="8,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="300" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        Width="28"
                                        MinWidth="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            Text="{Binding Description}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="2"
                                        MinHeight="50"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding Processors}"
                                        ItemTemplate="{StaticResource WorkspaceExportComboBoxItemTemplate}"
                                        SelectedItem="{Binding SelectedProcessor, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Grid Grid.Row="1" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85*" />
                    <ColumnDefinition Width="115*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource WorkspaceExportPanelCardStyle}" Translation="0,0,8">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource WorkspaceExportCardTitleIconStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="&#xE9D5;" />
                            </Border>
                            <TextBlock
                                x:Name="ExportOptionsSectionTitleText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource WorkspaceExportSectionTitleTextStyle}" />
                        </Grid>
                        <StackPanel Spacing="4">
                            <CheckBox
                                x:Name="ExportToWorkspaceDirectoryCheckBox"
                                IsChecked="{Binding ExportToWorkspaceDirectory, Mode=TwoWay}" />
                            <CheckBox
                                x:Name="OverwriteExistingFilesCheckBox"
                                IsChecked="{Binding OverwriteExistingFiles, Mode=TwoWay}" />
                            <CheckBox
                                x:Name="ForceAudioPayloadWriteCheckBox"
                                IsChecked="{Binding ForceAudioPayloadWrite, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        x:Name="ForceAudioPayloadWriteText"
                                        VerticalAlignment="Center" />
                                    <Border
                                        x:Name="ForceAudioPayloadWriteHelpHost"
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        PointerEntered="OnForceAudioPayloadWriteHelpPointerEntered"
                                        PointerExited="OnForceAudioPayloadWriteHelpPointerExited"
                                        ToolTipService.Placement="Right">
                                        <FontIcon
                                            x:Name="ForceAudioPayloadWriteHelpIcon"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE946;" />
                                    </Border>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource WorkspaceExportPanelCardStyle}" Translation="0,0,8">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource WorkspaceExportCardTitleIconStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="&#xE8C7;" />
                            </Border>
                            <TextBlock
                                x:Name="CompressionModeLabelText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource WorkspaceExportSectionTitleTextStyle}" />
                        </Grid>
                        <ComboBox
                            MinHeight="50"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding CompressionOptions}"
                            ItemTemplate="{StaticResource WorkspaceExportComboBoxItemTemplate}"
                            SelectedItem="{Binding SelectedCompressionOption, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
