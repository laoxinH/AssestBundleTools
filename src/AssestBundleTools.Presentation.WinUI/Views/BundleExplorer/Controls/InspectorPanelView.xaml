<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.InspectorPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="InspectorInfoCardBorderStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter
                Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="CornerRadius"
                Value="12" />
        </Style>

        <Style
            x:Key="InspectorInfoCardHeaderButtonStyle"
            TargetType="Button">
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="BorderBrush"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Padding"
                Value="10,8" />
            <Setter
                Property="CornerRadius"
                Value="10" />
            <Setter
                Property="HorizontalAlignment"
                Value="Stretch" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />
        </Style>

        <Style
            x:Key="InspectorInfoCardCopyButtonStyle"
            TargetType="Button">
            <Setter
                Property="Background"
                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter
                Property="BorderBrush"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Padding"
                Value="0" />
            <Setter
                Property="Width"
                Value="30" />
            <Setter
                Property="Height"
                Value="30" />
            <Setter
                Property="CornerRadius"
                Value="15" />
            <Setter
                Property="HorizontalAlignment"
                Value="Right" />
            <Setter
                Property="VerticalAlignment"
                Value="Top" />
        </Style>

        <Style
            x:Key="InspectorInfoCardTitleTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="14" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorInfoCardSummaryTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="12" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorInfoRowLabelTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="Margin"
                Value="0,0,12,0" />
            <Setter
                Property="FontSize"
                Value="12.5" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorInfoRowValueTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="12.5" />
            <Setter
                Property="IsTextSelectionEnabled"
                Value="True" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorPreviewSurfaceBorderStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter
                Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="CornerRadius"
                Value="12" />
        </Style>

        <Style
            x:Key="InspectorPreviewActionButtonStyle"
            TargetType="Button">
            <Setter
                Property="Width"
                Value="32" />
            <Setter
                Property="Height"
                Value="32" />
            <Setter
                Property="MinWidth"
                Value="32" />
            <Setter
                Property="MinHeight"
                Value="32" />
            <Setter
                Property="Padding"
                Value="0" />
            <Setter
                Property="UseSystemFocusVisuals"
                Value="False" />
            <Setter
                Property="CornerRadius"
                Value="10" />
            <Setter
                Property="Background"
                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter
                Property="BorderBrush"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border
                                x:Name="PreviewActionSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <CompositeTransform x:Name="PreviewActionSurfaceTransform" />
                                </Border.RenderTransform>
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="1" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurfaceTransform"
                                                Storyboard.TargetProperty="TranslateY"
                                                To="-0.5"
                                                Duration="0:0:0.08"
                                                EnableDependentAnimation="True" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="1" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurfaceTransform"
                                                Storyboard.TargetProperty="TranslateY"
                                                To="1"
                                                Duration="0:0:0.06"
                                                EnableDependentAnimation="True" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurfaceTransform"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.96"
                                                Duration="0:0:0.06"
                                                EnableDependentAnimation="True" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurfaceTransform"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.96"
                                                Duration="0:0:0.06"
                                                EnableDependentAnimation="True" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PreviewActionSurface"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.45"
                                                Duration="0:0:0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="InspectorAudioTransportButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter
                Property="Width"
                Value="34" />
            <Setter
                Property="Height"
                Value="34" />
            <Setter
                Property="MinWidth"
                Value="34" />
            <Setter
                Property="MinHeight"
                Value="34" />
            <Setter
                Property="Padding"
                Value="0" />
            <Setter
                Property="CornerRadius"
                Value="10" />
        </Style>

        <Style
            x:Key="InspectorAudioBadgeBorderStyle"
            TargetType="Border">
            <Setter
                Property="Padding"
                Value="10,6" />
            <Setter
                Property="Background"
                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter
                Property="CornerRadius"
                Value="10" />
        </Style>

        <Style
            x:Key="InspectorAudioBadgeTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="11.5" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorPreviewOverlayBadgeBorderStyle"
            TargetType="Border">
            <Setter
                Property="Padding"
                Value="12,8" />
            <Setter
                Property="Background"
                Value="#E6111115" />
            <Setter
                Property="BorderBrush"
                Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="CornerRadius"
                Value="12" />
        </Style>

        <Style
            x:Key="InspectorPreviewOverlayBadgeTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontFamily"
                Value="Consolas" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="#FFF8FAFC" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border
            Padding="14"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="10"
            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="EmptyStateTitleText"
                    Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <Grid
            MinHeight="0"
            Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    Grid.Row="0"
                    Margin="8,0,8,0"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled">
                    <Border
                        Padding="3"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <RadioButton
                                x:Name="DetailsSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="0"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsDetailsSectionSelected, Mode=OneWay}" />
                            <RadioButton
                                x:Name="DependenciesSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="1"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsDependenciesSectionSelected, Mode=OneWay}" />
                            <RadioButton
                                x:Name="ReplacementSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="2"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsReplacementSectionSelected, Mode=OneWay}" />
                            <RadioButton
                                x:Name="ChangesSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="3"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsChangesSectionSelected, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <Grid
                    Grid.Row="1"
                    MinHeight="0">
                    <ScrollViewer
                        MinHeight="0"
                        Visibility="{x:Bind ViewModel.DetailsSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="8">
                            <Border
                                Height="{x:Bind ViewModel.Preview.PreviewSurfaceHeight, Mode=OneWay}"
                                MinHeight="{x:Bind ViewModel.Preview.PreviewSurfaceMinHeight, Mode=OneWay}"
                                Padding="12"
                                Style="{StaticResource InspectorPreviewSurfaceBorderStyle}">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Button
                                            x:Name="OpenPreviewLocationButton"
                                            HorizontalAlignment="Right"
                                            Click="OnOpenPreviewLocationButtonClick"
                                            IsEnabled="{x:Bind ViewModel.Preview.CanOpenPreviewLocation, Mode=OneWay}"
                                            Style="{StaticResource InspectorPreviewActionButtonStyle}"
                                            Visibility="{x:Bind ViewModel.Preview.PreviewOpenLocationVisibility, Mode=OneWay}">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="14"
                                                Glyph="&#xE838;" />
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10"
                                        Visibility="{x:Bind ViewModel.Preview.PreviewLoadingVisibility, Mode=OneWay}">
                                        <ProgressRing
                                            Width="30"
                                            Height="30"
                                            IsActive="True" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.Preview.PreviewStatusText, Mode=OneWay}"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10"
                                        Visibility="{x:Bind ViewModel.Preview.PreviewMessageVisibility, Mode=OneWay}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            Glyph="&#xE7BA;"
                                            FontSize="26" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.Preview.PreviewStatusText, Mode=OneWay}"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                <Grid
                    x:Name="PreviewImageViewportHost"
                    Margin="8"
                    SizeChanged="OnPreviewImageViewportHostSizeChanged"
                    Visibility="{x:Bind ViewModel.Preview.PreviewImageVisibility, Mode=OneWay}">
                    <Viewbox
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        StretchDirection="DownOnly">
                        <Grid
                            Width="{x:Bind ViewModel.Preview.PreviewImageCanvasWidth, Mode=OneWay}"
                            Height="{x:Bind ViewModel.Preview.PreviewImageCanvasHeight, Mode=OneWay}">
                            <Image
                                Width="{x:Bind ViewModel.Preview.PreviewImageCanvasWidth, Mode=OneWay}"
                                Height="{x:Bind ViewModel.Preview.PreviewImageCanvasHeight, Mode=OneWay}"
                                Stretch="Fill"
                                Source="{x:Bind ViewModel.Preview.PreviewImageSource, Mode=OneWay}" />
                        </Grid>
                    </Viewbox>

                    <Canvas
                        IsHitTestVisible="False"
                        Visibility="{x:Bind ViewModel.Preview.PreviewImageOverlayVisibility, Mode=OneWay}">
                        <Rectangle
                            Canvas.Left="{x:Bind ViewModel.Preview.PreviewImageOverlayX, Mode=OneWay}"
                            Canvas.Top="{x:Bind ViewModel.Preview.PreviewImageOverlayY, Mode=OneWay}"
                            Width="{x:Bind ViewModel.Preview.PreviewImageOverlayWidth, Mode=OneWay}"
                            Height="{x:Bind ViewModel.Preview.PreviewImageOverlayHeight, Mode=OneWay}"
                            RadiusX="6"
                            RadiusY="6"
                            Fill="Transparent"
                            Stroke="#CC101418"
                            StrokeThickness="1.5" />

                        <Rectangle
                            Canvas.Left="{x:Bind ViewModel.Preview.PreviewImageOverlayX, Mode=OneWay}"
                            Canvas.Top="{x:Bind ViewModel.Preview.PreviewImageOverlayY, Mode=OneWay}"
                            Width="{x:Bind ViewModel.Preview.PreviewImageOverlayWidth, Mode=OneWay}"
                            Height="{x:Bind ViewModel.Preview.PreviewImageOverlayHeight, Mode=OneWay}"
                            RadiusX="6"
                            RadiusY="6"
                            Fill="Transparent"
                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                            StrokeThickness="0.75" />

                        <Border
                            Style="{StaticResource InspectorPreviewOverlayBadgeBorderStyle}"
                            Canvas.Left="{x:Bind ViewModel.Preview.PreviewImageOverlayLabelX, Mode=OneWay}"
                            Canvas.Top="{x:Bind ViewModel.Preview.PreviewImageOverlayLabelY, Mode=OneWay}"
                            MaxWidth="320">
                            <TextBlock
                                Style="{StaticResource InspectorPreviewOverlayBadgeTextStyle}"
                                Text="{x:Bind ViewModel.Preview.PreviewImageOverlayLabelText, Mode=OneWay}" />
                        </Border>
                    </Canvas>
                </Grid>

                                    <StackPanel
                                        Margin="8,0,8,8"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Spacing="10"
                                        Visibility="{x:Bind ViewModel.Preview.PreviewAudioVisibility, Mode=OneWay}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="40"
                                                Height="40"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                CornerRadius="12">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="18"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Glyph="&#xE8D6;" />
                                            </Border>

                                            <StackPanel
                                                Grid.Column="1"
                                                Spacing="2">
                                                <TextBlock
                                                    FontSize="18"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind ViewModel.AssetName, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="WrapWholeWords" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.Preview.AudioPreviewSizeSummaryText, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords"
                                                    Visibility="{x:Bind ViewModel.Preview.AudioPreviewSizeSummaryVisibility, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid
                                            ColumnSpacing="6"
                                            RowSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{StaticResource InspectorAudioBadgeBorderStyle}"
                                                Visibility="{x:Bind ViewModel.Preview.AudioPreviewContainerBadgeVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    Style="{StaticResource InspectorAudioBadgeTextStyle}"
                                                    Text="{x:Bind ViewModel.Preview.AudioPreviewContainerBadgeText, Mode=OneWay}" />
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Style="{StaticResource InspectorAudioBadgeBorderStyle}"
                                                Visibility="{x:Bind ViewModel.Preview.AudioPreviewDurationBadgeVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    Style="{StaticResource InspectorAudioBadgeTextStyle}"
                                                    Text="{x:Bind ViewModel.Preview.AudioPreviewDurationBadgeText, Mode=OneWay}" />
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource InspectorAudioBadgeBorderStyle}"
                                                Visibility="{x:Bind ViewModel.Preview.AudioPreviewChannelBadgeVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    Style="{StaticResource InspectorAudioBadgeTextStyle}"
                                                    Text="{x:Bind ViewModel.Preview.AudioPreviewChannelBadgeText, Mode=OneWay}" />
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Style="{StaticResource InspectorAudioBadgeBorderStyle}"
                                                Visibility="{x:Bind ViewModel.Preview.AudioPreviewFrequencyBadgeVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    Style="{StaticResource InspectorAudioBadgeTextStyle}"
                                                    Text="{x:Bind ViewModel.Preview.AudioPreviewFrequencyBadgeText, Mode=OneWay}" />
                                            </Border>
                                        </Grid>

                                        <MediaPlayerElement
                                            x:Name="AudioPreviewPlayer"
                                            Width="1"
                                            Height="1"
                                            AreTransportControlsEnabled="False"
                                            AutoPlay="False"
                                            HorizontalAlignment="Left"
                                            IsHitTestVisible="False"
                                            Opacity="0.01"
                                            Source="{x:Bind ViewModel.Preview.PreviewAudioSource, Mode=OneWay}" />

                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid
                                                Grid.Row="0"
                                                ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button
                                                    x:Name="AudioTransportPlayPauseButton"
                                                    Click="OnAudioTransportPlayPauseButtonClick"
                                                    Style="{StaticResource InspectorAudioTransportButtonStyle}">
                                                    <FontIcon
                                                        x:Name="AudioTransportPlayPauseIcon"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="14"
                                                        Glyph="&#xE768;" />
                                                </Button>

                                                <Button
                                                    x:Name="AudioTransportResetButton"
                                                    Grid.Column="1"
                                                    Click="OnAudioTransportResetButtonClick"
                                                    Style="{StaticResource InspectorAudioTransportButtonStyle}">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="14"
                                                        Glyph="&#xE72C;" />
                                                </Button>

                                                <TextBlock
                                                    x:Name="AudioTransportTimeText"
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Cascadia Mono"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="00:00 / 00:00" />
                                            </Grid>

                                            <Slider
                                                x:Name="AudioTransportPositionSlider"
                                                Grid.Row="1"
                                                Minimum="0"
                                                Maximum="1"
                                                StepFrequency="0.1"
                                                ValueChanged="OnAudioTransportPositionSliderValueChanged" />
                                        </Grid>
                                    </StackPanel>

                                    <ScrollViewer
                                        HorizontalScrollBarVisibility="Auto"
                                        HorizontalScrollMode="Enabled"
                                        VerticalScrollBarVisibility="Auto"
                                        VerticalScrollMode="Enabled"
                                        ZoomMode="Disabled"
                                        Visibility="{x:Bind ViewModel.Preview.PreviewTextVisibility, Mode=OneWay}">
                                        <TextBlock
                                            FontFamily="Cascadia Mono"
                                            FontSize="13"
                                            Text="{x:Bind ViewModel.Preview.PreviewText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </ScrollViewer>

                                    <ScrollViewer
                                        HorizontalScrollBarVisibility="Disabled"
                                        HorizontalScrollMode="Disabled"
                                        VerticalScrollBarVisibility="Auto"
                                        VerticalScrollMode="Enabled"
                                        ZoomMode="Disabled"
                                        Visibility="{x:Bind ViewModel.Preview.PreviewSummaryVisibility, Mode=OneWay}">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.Preview.PreviewText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                    </ScrollViewer>
                                </Grid>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="6">
                                <TextBlock
                                    x:Name="InformationSectionTitleText"
                                    Style="{StaticResource WorkspacePaneTitleTextStyle}" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.InformationCards, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:InspectorInfoCardViewModel">
                                            <Border
                                                Margin="0,0,0,8"
                                                Style="{StaticResource InspectorInfoCardBorderStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid
                                                        Grid.Row="0"
                                                        Padding="6,6,6,4"
                                                        ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Button
                                                            Grid.Column="0"
                                                            Click="OnInspectorInfoCardHeaderButtonClick"
                                                            Style="{StaticResource InspectorInfoCardHeaderButtonStyle}">
                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <FontIcon
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    FontSize="12"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />

                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    Spacing="2">
                                                                    <TextBlock
                                                                        Style="{StaticResource InspectorInfoCardTitleTextStyle}"
                                                                        Text="{x:Bind Title, Mode=OneWay}" />
                                                                    <TextBlock
                                                                        Style="{StaticResource InspectorInfoCardSummaryTextStyle}"
                                                                        Text="{x:Bind SummaryText, Mode=OneWay}"
                                                                        Visibility="{x:Bind SummaryVisibility, Mode=OneWay}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>

                                                        <Button
                                                            Grid.Column="1"
                                                            Click="OnInspectorInfoCardCopyButtonClick"
                                                            Style="{StaticResource InspectorInfoCardCopyButtonStyle}"
                                                            ToolTipService.ToolTip="{x:Bind CopyToolTipText, Mode=OneWay}">
                                                            <FontIcon
                                                                FontFamily="Segoe Fluent Icons"
                                                                Glyph="&#xE8C8;" />
                                                        </Button>
                                                    </Grid>

                                                    <Border
                                                        Grid.Row="1"
                                                        Margin="12,0,12,0"
                                                        Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        Height="1"
                                                        Visibility="{x:Bind ContentVisibility, Mode=OneWay}" />

                                                    <ItemsControl
                                                        Grid.Row="2"
                                                        Margin="12,6,12,12"
                                                        ItemsSource="{x:Bind Rows, Mode=OneWay}"
                                                        Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:InspectorInfoRowViewModel">
                                                                <Grid
                                                                    Margin="0,0,0,8"
                                                                    ColumnSpacing="0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock
                                                                        Style="{StaticResource InspectorInfoRowLabelTextStyle}"
                                                                        Text="{x:Bind Label, Mode=OneTime}"
                                                                        Visibility="{x:Bind LabelVisibility, Mode=OneTime}" />

                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Style="{StaticResource InspectorInfoRowValueTextStyle}"
                                                                        Text="{x:Bind Value, Mode=OneTime}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        MinHeight="0"
                        Visibility="{x:Bind ViewModel.DependenciesSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="8">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.AssetDependenciesVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="AssetDependenciesTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.AssetDependencies, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AssetDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind Name, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind BundleName, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind MetadataText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind SupplementaryText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords"
                                                                    Visibility="{x:Bind SupplementaryVisibility, Mode=OneTime}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.ReferencedByDependenciesVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="ReferencedByTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.ReferencedByDependencies, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AssetDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind Name, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind BundleName, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind MetadataText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind SupplementaryText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords"
                                                                    Visibility="{x:Bind SupplementaryVisibility, Mode=OneTime}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.DependencyClosureVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="DependencyClosureTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.DependencyClosureItems, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AssetDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind Name, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind BundleName, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind MetadataText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind SupplementaryText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords"
                                                                    Visibility="{x:Bind SupplementaryVisibility, Mode=OneTime}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.BundleExternalDependenciesVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="BundleExternalDependenciesTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.BundleExternalDependencies, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:BundleExternalDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind DisplayName, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind KindText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    FontFamily="Cascadia Mono"
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind ReferencePath, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.DependenciesEmptyStateVisibility, Mode=OneWay}">
                                        <TextBlock
                                            x:Name="DependenciesEmptyStateText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="WrapWholeWords" />
                                    </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        MinHeight="0"
                        Visibility="{x:Bind ViewModel.ReplacementSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="8">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="ReplacementTargetTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.AssetName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.BundleDisplayName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.AssetTypeText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="ReplacementSourceTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.ReplacementSourceText, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <Button
                                                x:Name="SelectFileReplacementButton"
                                                HorizontalAlignment="Left"
                                                Click="OnSelectFileReplacementButtonClick"
                                                IsEnabled="{x:Bind ViewModel.CanSelectFileReplacementSource, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="ReplacementCompatibilityTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ExtractCapabilityLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ExtractCapabilityText, Mode=OneWay}" />
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="FileReplacementCapabilityLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FileReplacementCapabilityText, Mode=OneWay}" />
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="WorkspaceReplacementCapabilityLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WorkspaceReplacementCapabilityText, Mode=OneWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.ReplacementStatusText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        MinHeight="0"
                        Visibility="{x:Bind ViewModel.ChangesSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="8">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="ChangeSummaryTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.AssetName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.BundleDisplayName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.ChangeSummaryText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                    </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border
                    Grid.Row="2"
                    Margin="8,0,8,8"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ExtractButton"
                                Click="OnExtractButtonClick"
                                IsEnabled="{x:Bind ViewModel.CanExtract, Mode=OneWay}" />
                            <Button
                                x:Name="SelectReplacementButton"
                                Click="OnSelectReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.CanSelectReplacementSource, Mode=OneWay}" />
                            <Button
                                x:Name="ApplyReplacementButton"
                                Click="OnApplyReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.CanApplyReplacement, Mode=OneWay}" />
                            <Button
                                x:Name="UndoReplacementButton"
                                Click="OnUndoReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.CanUndoReplacement, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

