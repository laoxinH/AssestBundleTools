<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.InspectorPanelView"
    x:Name="InspectorPanelRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="InspectorResolvedAssetTagButtonStyle"
            TargetType="Button">
            <Setter
                Property="Background"
                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter
                Property="BorderBrush"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Padding"
                Value="0" />
            <Setter
                Property="Width"
                Value="30" />
            <Setter
                Property="Height"
                Value="30" />
            <Setter
                Property="CornerRadius"
                Value="15" />
            <Setter
                Property="HorizontalAlignment"
                Value="Right" />
            <Setter
                Property="VerticalAlignment"
                Value="Top" />
        </Style>

        <Style
            x:Key="InspectorChangeRecordTagButtonStyle"
            TargetType="Button">
            <Setter
                Property="Background"
                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter
                Property="BorderBrush"
                Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter
                Property="CornerRadius"
                Value="12" />
            <Setter
                Property="Padding"
                Value="10,0" />
            <Setter
                Property="MinHeight"
                Value="28" />
            <Setter
                Property="MinWidth"
                Value="0" />
            <Setter
                Property="FontSize"
                Value="12" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
        </Style>

        <Style
            x:Key="InspectorEmptyStateCardStyle"
            TargetType="Border">
            <Setter
                Property="MaxWidth"
                Value="390" />
            <Setter
                Property="Padding"
                Value="24,22" />
            <Setter
                Property="HorizontalAlignment"
                Value="Center" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter
                Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="CornerRadius"
                Value="8" />
        </Style>

        <Style
            x:Key="InspectorEmptyStateTitleTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="15" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter
                Property="HorizontalAlignment"
                Value="Center" />
            <Setter
                Property="TextAlignment"
                Value="Center" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorEmptyStateBodyTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter
                Property="HorizontalAlignment"
                Value="Center" />
            <Setter
                Property="MaxWidth"
                Value="320" />
            <Setter
                Property="TextAlignment"
                Value="Center" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Border
            x:Name="InspectorEmptyStateCard"
            Style="{StaticResource InspectorEmptyStateCardStyle}"
            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="12">
                <Border
                    Width="52"
                    Height="52"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="23"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE8A5;" />
                </Border>
                <TextBlock
                    x:Name="EmptyStateTitleText"
                    Style="{StaticResource InspectorEmptyStateTitleTextStyle}" />
                <TextBlock
                    Style="{StaticResource InspectorEmptyStateBodyTextStyle}"
                    Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Grid
            MinHeight="0"
            Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    x:Name="SectionSelectorScrollViewer"
                    Grid.Row="0"
                    Margin="8,0,8,0"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    ViewChanged="OnSectionSelectorScrollViewerViewChanged"
                    ZoomMode="Disabled">
                    <Border
                        Padding="3"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <RadioButton
                                x:Name="DetailsSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="0"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsDetailsSectionSelected, Mode=OneWay}" />
                            <RadioButton
                                x:Name="DependenciesSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="1"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsDependenciesSectionSelected, Mode=OneWay}" />
                            <RadioButton
                                x:Name="ReplacementSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="2"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsReplacementSectionSelected, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ReplacementSectionTabVisibility, Mode=OneWay}" />
                            <RadioButton
                                x:Name="ChangesSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="3"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsChangesSectionSelected, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <Grid
                    Grid.Row="1"
                    MinHeight="0">
                    <ScrollViewer
                        x:Name="DetailsSectionScrollViewer"
                        MinHeight="0"
                        Tag="0"
                        ViewChanged="OnSectionScrollViewerViewChanged"
                        Visibility="{x:Bind ViewModel.DetailsSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="8">
                            <controls:InspectorPreviewSurfaceView
                                FixedPreviewSurfaceHeight="320"
                                IsPreviewActive="{x:Bind ShowDetailsPreview, Mode=OneWay}"
                                ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                LoadMoreTextRequested="OnPreviewSurfaceLoadMoreTextRequested"
                                OpenPreviewLocationRequested="OnPreviewSurfaceOpenPreviewLocationRequested"
                                SpriteTextureReplacementRequested="OnPreviewSurfaceSpriteTextureReplacementRequested"
                                ResolvedAssetOpenRequested="OnPreviewSurfaceResolvedAssetOpenRequested"
                                Visibility="{x:Bind DetailsPreviewVisibility, Mode=OneWay}" />

                            <controls:SpineAtlasPageSelectorView
                                ViewModel="{x:Bind ViewModel.SpineAtlasPageSelector, Mode=OneWay}"
                                SelectionRequested="OnSpineAtlasPageSelectorSelectionRequested" />

                            <StackPanel Spacing="6">
                                <TextBlock
                                    x:Name="InformationSectionTitleText"
                                    Style="{StaticResource WorkspacePaneTitleTextStyle}" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.InformationCards, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:InspectorInfoCardViewModel">
                                            <controls:InspectorInfoCardView
                                                Card="{Binding}"
                                                Margin="0,0,0,8"
                                                HorizontalAlignment="Stretch"
                                                ResolvedAssetOpenRequested="OnInfoCardResolvedAssetOpenRequested" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="DependenciesSectionScrollViewer"
                        MinHeight="0"
                        Tag="1"
                        ViewChanged="OnSectionScrollViewerViewChanged"
                        Visibility="{x:Bind ViewModel.DependenciesSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="8">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.AssetDependenciesVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="AssetDependenciesTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.AssetDependencies, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AssetDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <StackPanel Spacing="4">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        FontWeight="SemiBold"
                                                                        Text="{x:Bind Name, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <Button
                                                                        Grid.Column="1"
                                                                        AutomationProperties.Name="{x:Bind OpenButtonText, Mode=OneTime}"
                                                                        Click="OnResolvedAssetOpenButtonClick"
                                                                        Style="{StaticResource InspectorResolvedAssetTagButtonStyle}"
                                                                        Tag="{x:Bind Target, Mode=OneTime}"
                                                                        ToolTipService.ToolTip="{x:Bind OpenButtonToolTipText, Mode=OneTime}"
                                                                        Visibility="{x:Bind OpenButtonVisibility, Mode=OneTime}">
                                                                        <FontIcon
                                                                            FontFamily="Segoe MDL2 Assets"
                                                                            FontSize="14"
                                                                            Glyph="&#xE8A7;" />
                                                                    </Button>
                                                                </Grid>
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind BundleName, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind MetadataText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind SupplementaryText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords"
                                                                    Visibility="{x:Bind SupplementaryVisibility, Mode=OneTime}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.ReferencedByDependenciesVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="ReferencedByTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.ReferencedByDependencies, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AssetDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <StackPanel Spacing="4">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        FontWeight="SemiBold"
                                                                        Text="{x:Bind Name, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <Button
                                                                        Grid.Column="1"
                                                                        AutomationProperties.Name="{x:Bind OpenButtonText, Mode=OneTime}"
                                                                        Click="OnResolvedAssetOpenButtonClick"
                                                                        Style="{StaticResource InspectorResolvedAssetTagButtonStyle}"
                                                                        Tag="{x:Bind Target, Mode=OneTime}"
                                                                        ToolTipService.ToolTip="{x:Bind OpenButtonToolTipText, Mode=OneTime}"
                                                                        Visibility="{x:Bind OpenButtonVisibility, Mode=OneTime}">
                                                                        <FontIcon
                                                                            FontFamily="Segoe MDL2 Assets"
                                                                            FontSize="14"
                                                                            Glyph="&#xE8A7;" />
                                                                    </Button>
                                                                </Grid>
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind BundleName, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind MetadataText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind SupplementaryText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords"
                                                                    Visibility="{x:Bind SupplementaryVisibility, Mode=OneTime}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.DependencyClosureVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="DependencyClosureTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.DependencyClosureItems, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AssetDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <StackPanel Spacing="4">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        FontWeight="SemiBold"
                                                                        Text="{x:Bind Name, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <Button
                                                                        Grid.Column="1"
                                                                        AutomationProperties.Name="{x:Bind OpenButtonText, Mode=OneTime}"
                                                                        Click="OnResolvedAssetOpenButtonClick"
                                                                        Style="{StaticResource InspectorResolvedAssetTagButtonStyle}"
                                                                        Tag="{x:Bind Target, Mode=OneTime}"
                                                                        ToolTipService.ToolTip="{x:Bind OpenButtonToolTipText, Mode=OneTime}"
                                                                        Visibility="{x:Bind OpenButtonVisibility, Mode=OneTime}">
                                                                        <FontIcon
                                                                            FontFamily="Segoe MDL2 Assets"
                                                                            FontSize="14"
                                                                            Glyph="&#xE8A7;" />
                                                                    </Button>
                                                                </Grid>
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind BundleName, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind MetadataText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind SupplementaryText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords"
                                                                    Visibility="{x:Bind SupplementaryVisibility, Mode=OneTime}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.BundleExternalDependenciesVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="BundleExternalDependenciesTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.BundleExternalDependencies, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:BundleExternalDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind DisplayName, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind KindText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    FontFamily="Cascadia Mono"
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind ReferencePath, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.DependenciesEmptyStateVisibility, Mode=OneWay}">
                                        <TextBlock
                                            x:Name="DependenciesEmptyStateText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="WrapWholeWords" />
                                    </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="ReplacementSectionScrollViewer"
                        MinHeight="0"
                        Tag="2"
                        ViewChanged="OnSectionScrollViewerViewChanged"
                        Visibility="{x:Bind ViewModel.ReplacementSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="10">
                            <controls:SpineEditPartsPanelView
                                Visibility="{x:Bind SpineEditPanelVisibility, Mode=OneWay}"
                                ViewModel="{x:Bind SpineEditDraft, Mode=OneWay}"
                                BatchMatchRequested="OnSpineEditBatchMatchRequested"
                                PartFileSelectionRequested="OnSpineEditPartFileSelectionRequested" />

                            <StackPanel
                                Spacing="8"
                                Visibility="{x:Bind StandardReplacementContentVisibility, Mode=OneWay}">
                                <Border
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            x:Name="ReplacementTargetTitleText"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.AssetName, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.BundleDisplayName, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.AssetTypeText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            x:Name="ReplacementSourceTitleText"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.ReplacementSourceText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="SelectFileReplacementButton"
                                                Click="OnSelectFileReplacementButtonClick"
                                                IsEnabled="{x:Bind ViewModel.CanSelectFileReplacementSource, Mode=OneWay}" />
                                            <Button
                                                x:Name="ApplySelectedReplacementButton"
                                                Click="OnApplySelectedReplacementButtonClick"
                                                IsEnabled="{x:Bind ViewModel.CanApplyReplacement, Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            x:Name="ReplacementCompatibilityTitleText"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ExtractCapabilityLabelText" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ExtractCapabilityText, Mode=OneWay}" />
                                        </Grid>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FileReplacementCapabilityLabelText" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FileReplacementCapabilityText, Mode=OneWay}" />
                                        </Grid>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="WorkspaceReplacementCapabilityLabelText" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WorkspaceReplacementCapabilityText, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.ReplacementStatusText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="ChangesSectionScrollViewer"
                        MinHeight="0"
                        Tag="3"
                        ViewChanged="OnSectionScrollViewerViewChanged"
                        Visibility="{x:Bind ViewModel.ChangesSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="8">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="ChangeSummaryTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.AssetName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.BundleDisplayName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.ChangeRecordsEmptyStateVisibility, Mode=OneWay}">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.ChangeSummaryText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                    </Border>

                                    <ItemsControl
                                        ItemsSource="{x:Bind ViewModel.ChangeRecords, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.ChangeRecordsListVisibility, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:InspectorChangeRecordViewModel">
                                                <Border
                                                    Margin="0,0,0,8"
                                                    Padding="12"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Width="32"
                                                            Height="32"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            CornerRadius="16">
                                                            <FontIcon
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="14"
                                                                Glyph="{x:Bind Glyph, Mode=OneTime}" />
                                                        </Border>
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            Spacing="8">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind TitleText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <Border
                                                                    Grid.Column="1"
                                                                    Padding="8,3"
                                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                    CornerRadius="10"
                                                                    Visibility="{x:Bind BadgeVisibility, Mode=OneTime}">
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind BadgeText, Mode=OneTime}" />
                                                                </Border>
                                                            </Grid>

                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind SourceText, Mode=OneTime}"
                                                                TextWrapping="WrapWholeWords"
                                                                Visibility="{x:Bind SourceTextVisibility, Mode=OneTime}" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                Text="{x:Bind TimeText, Mode=OneTime}"
                                                                TextWrapping="WrapWholeWords" />
                                                            <TextBlock
                                                                FontFamily="Cascadia Mono"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                Text="{x:Bind SecondaryText, Mode=OneTime}"
                                                                TextWrapping="WrapWholeWords"
                                                                Visibility="{x:Bind SecondaryTextVisibility, Mode=OneTime}" />

                                                            <StackPanel
                                                                Orientation="Horizontal"
                                                                Spacing="6">
                                                                <Button
                                                                    Click="OnChangeRecordUndoReplacementButtonClick"
                                                                    IsEnabled="{x:Bind IsActionEnabled, Mode=OneWay}"
                                                                    Style="{StaticResource InspectorChangeRecordTagButtonStyle}"
                                                                    Tag="{x:Bind OperationId, Mode=OneTime}"
                                                                    Visibility="{x:Bind UndoButtonVisibility, Mode=OneTime}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <ProgressRing
                                                                            Width="12"
                                                                            Height="12"
                                                                            IsActive="{x:Bind IsPending, Mode=OneWay}"
                                                                            Visibility="{x:Bind PendingVisibility, Mode=OneWay}" />
                                                                        <TextBlock Text="{x:Bind UndoButtonText, Mode=OneTime}" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button
                                                                    Click="OnChangeRecordRedoReplacementButtonClick"
                                                                    IsEnabled="{x:Bind IsActionEnabled, Mode=OneWay}"
                                                                    Style="{StaticResource InspectorChangeRecordTagButtonStyle}"
                                                                    Tag="{x:Bind OperationId, Mode=OneTime}"
                                                                    Visibility="{x:Bind RedoButtonVisibility, Mode=OneTime}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <ProgressRing
                                                                            Width="12"
                                                                            Height="12"
                                                                            IsActive="{x:Bind IsPending, Mode=OneWay}"
                                                                            Visibility="{x:Bind PendingVisibility, Mode=OneWay}" />
                                                                        <TextBlock Text="{x:Bind RedoButtonText, Mode=OneTime}" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button
                                                                    Click="OnChangeRecordDeleteButtonClick"
                                                                    IsEnabled="{x:Bind IsActionEnabled, Mode=OneWay}"
                                                                    Style="{StaticResource InspectorChangeRecordTagButtonStyle}"
                                                                    Tag="{x:Bind OperationId, Mode=OneTime}"
                                                                    Visibility="{x:Bind DeleteButtonVisibility, Mode=OneTime}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <ProgressRing
                                                                            Width="12"
                                                                            Height="12"
                                                                            IsActive="{x:Bind IsPending, Mode=OneWay}"
                                                                            Visibility="{x:Bind PendingVisibility, Mode=OneWay}" />
                                                                        <TextBlock Text="{x:Bind DeleteButtonText, Mode=OneTime}" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border
                    Grid.Row="2"
                    Margin="8,0,8,6"
                    Padding="0,2"
                    Background="Transparent"
                    Visibility="{x:Bind ActionBarVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Button
                            x:Name="ExtractButton"
                            Click="OnExtractButtonClick"
                            IsEnabled="{x:Bind ViewModel.CanExtract, Mode=OneWay}"
                            Style="{StaticResource WorkspaceOperationButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Glyph="&#xE896;" />
                                <TextBlock x:Name="ExtractButtonText" />
                            </StackPanel>
                        </Button>

                        <Border
                            Width="1"
                            Height="16"
                            Margin="7,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                        <Button
                            x:Name="ModifyButton"
                            AutomationProperties.Name="{x:Bind ViewModel.ModifyButtonText, Mode=OneWay}"
                            Click="OnModifyButtonClick"
                            IsEnabled="{x:Bind ViewModel.CanModify, Mode=OneWay}"
                            Style="{StaticResource WorkspaceOperationButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ModifyButtonText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Glyph="{x:Bind ViewModel.ModifyButtonIconGlyph, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="ModifyButtonText"
                                    Text="{x:Bind ViewModel.ModifyButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <Border
                            Width="1"
                            Height="16"
                            Margin="7,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                            Visibility="{x:Bind ViewModel.EditButtonVisibility, Mode=OneWay}" />

                        <Button
                            x:Name="EditButton"
                            AutomationProperties.Name="{x:Bind ViewModel.EditButtonText, Mode=OneWay}"
                            Click="OnEditButtonClick"
                            IsEnabled="{x:Bind ViewModel.CanEditText, Mode=OneWay}"
                            Style="{StaticResource WorkspaceOperationButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.EditButtonText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.EditButtonVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Glyph="{x:Bind ViewModel.EditButtonIconGlyph, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.EditButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

