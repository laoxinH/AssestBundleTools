<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.InspectorPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="InspectorInfoCardBorderStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter
                Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="CornerRadius"
                Value="12" />
        </Style>

        <Style
            x:Key="InspectorInfoCardHeaderButtonStyle"
            TargetType="Button">
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="BorderBrush"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Padding"
                Value="10,8" />
            <Setter
                Property="CornerRadius"
                Value="10" />
            <Setter
                Property="HorizontalAlignment"
                Value="Stretch" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />
        </Style>

        <Style
            x:Key="InspectorInfoCardCopyButtonStyle"
            TargetType="Button">
            <Setter
                Property="Background"
                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter
                Property="BorderBrush"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Padding"
                Value="0" />
            <Setter
                Property="Width"
                Value="30" />
            <Setter
                Property="Height"
                Value="30" />
            <Setter
                Property="CornerRadius"
                Value="15" />
            <Setter
                Property="HorizontalAlignment"
                Value="Right" />
            <Setter
                Property="VerticalAlignment"
                Value="Top" />
        </Style>

        <Style
            x:Key="InspectorResolvedAssetTagButtonStyle"
            TargetType="Button">
            <Setter
                Property="Background"
                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter
                Property="BorderBrush"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Padding"
                Value="0" />
            <Setter
                Property="Width"
                Value="30" />
            <Setter
                Property="Height"
                Value="30" />
            <Setter
                Property="CornerRadius"
                Value="15" />
            <Setter
                Property="HorizontalAlignment"
                Value="Left" />
            <Setter
                Property="VerticalAlignment"
                Value="Top" />
        </Style>

        <Style
            x:Key="InspectorInfoCardTitleTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="14" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorInfoCardSummaryTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="12" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorInfoRowLabelTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="Margin"
                Value="0,0,12,0" />
            <Setter
                Property="FontSize"
                Value="12.5" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorInfoRowValueTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="12.5" />
            <Setter
                Property="IsTextSelectionEnabled"
                Value="True" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Border
            Padding="14"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="10"
            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="EmptyStateTitleText"
                    Style="{StaticResource WorkspaceSectionTitleTextStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <Grid
            MinHeight="0"
            Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    Grid.Row="0"
                    Margin="8,0,8,0"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled">
                    <Border
                        Padding="3"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <RadioButton
                                x:Name="DetailsSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="0"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsDetailsSectionSelected, Mode=OneWay}" />
                            <RadioButton
                                x:Name="DependenciesSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="1"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsDependenciesSectionSelected, Mode=OneWay}" />
                            <RadioButton
                                x:Name="ReplacementSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="2"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsReplacementSectionSelected, Mode=OneWay}" />
                            <RadioButton
                                x:Name="ChangesSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="3"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsChangesSectionSelected, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <Grid
                    Grid.Row="1"
                    MinHeight="0">
                    <ScrollViewer
                        MinHeight="0"
                        Visibility="{x:Bind ViewModel.DetailsSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="8">
                            <controls:InspectorPreviewSurfaceView
                                ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                OpenPreviewLocationRequested="OnPreviewSurfaceOpenPreviewLocationRequested"
                                ResolvedAssetOpenRequested="OnPreviewSurfaceResolvedAssetOpenRequested" />

                            <StackPanel Spacing="6">
                                <TextBlock
                                    x:Name="InformationSectionTitleText"
                                    Style="{StaticResource WorkspacePaneTitleTextStyle}" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.InformationCards, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:InspectorInfoCardViewModel">
                                            <Border
                                                Margin="0,0,0,8"
                                                Style="{StaticResource InspectorInfoCardBorderStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid
                                                        Grid.Row="0"
                                                        Padding="6,6,6,4"
                                                        ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Button
                                                            Grid.Column="0"
                                                            Click="OnInspectorInfoCardHeaderButtonClick"
                                                            Style="{StaticResource InspectorInfoCardHeaderButtonStyle}">
                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <FontIcon
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    FontSize="12"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />

                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    Spacing="2">
                                                                    <TextBlock
                                                                        Style="{StaticResource InspectorInfoCardTitleTextStyle}"
                                                                        Text="{x:Bind Title, Mode=OneWay}" />
                                                                    <TextBlock
                                                                        Style="{StaticResource InspectorInfoCardSummaryTextStyle}"
                                                                        Text="{x:Bind SummaryText, Mode=OneWay}"
                                                                        Visibility="{x:Bind SummaryVisibility, Mode=OneWay}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>

                                                        <Button
                                                            Grid.Column="1"
                                                            Click="OnInspectorInfoCardCopyButtonClick"
                                                            Style="{StaticResource InspectorInfoCardCopyButtonStyle}"
                                                            ToolTipService.ToolTip="{x:Bind CopyToolTipText, Mode=OneWay}">
                                                            <FontIcon
                                                                FontFamily="Segoe Fluent Icons"
                                                                Glyph="&#xE8C8;" />
                                                        </Button>
                                                    </Grid>

                                                    <Border
                                                        Grid.Row="1"
                                                        Margin="12,0,12,0"
                                                        Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        Height="1"
                                                        Visibility="{x:Bind ContentVisibility, Mode=OneWay}" />

                                                    <ItemsControl
                                                        Grid.Row="2"
                                                        Margin="12,6,12,12"
                                                        ItemsSource="{x:Bind Rows, Mode=OneWay}"
                                                        Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:InspectorInfoRowViewModel">
                                                                <Grid
                                                                    Margin="0,0,0,8"
                                                                    ColumnSpacing="0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock
                                                                        Style="{StaticResource InspectorInfoRowLabelTextStyle}"
                                                                        Text="{x:Bind Label, Mode=OneTime}"
                                                                        Visibility="{x:Bind LabelVisibility, Mode=OneTime}" />

                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Style="{StaticResource InspectorInfoRowValueTextStyle}"
                                                                        Text="{x:Bind Value, Mode=OneTime}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        MinHeight="0"
                        Visibility="{x:Bind ViewModel.DependenciesSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="8">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.AssetDependenciesVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="AssetDependenciesTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.AssetDependencies, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AssetDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button
                                                                    AutomationProperties.Name="{x:Bind OpenButtonText, Mode=OneTime}"
                                                                    Click="OnResolvedAssetOpenButtonClick"
                                                                    Style="{StaticResource InspectorResolvedAssetTagButtonStyle}"
                                                                    Tag="{x:Bind Target, Mode=OneTime}"
                                                                    ToolTipService.ToolTip="{x:Bind OpenButtonToolTipText, Mode=OneTime}"
                                                                    Visibility="{x:Bind OpenButtonVisibility, Mode=OneTime}">
                                                                    <FontIcon
                                                                        FontFamily="Segoe Fluent Icons"
                                                                        FontSize="14"
                                                                        Glyph="&#xE8B7;" />
                                                                </Button>
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    Spacing="4">
                                                                    <TextBlock
                                                                        FontWeight="SemiBold"
                                                                        Text="{x:Bind Name, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind BundleName, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind MetadataText, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                        Text="{x:Bind SupplementaryText, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords"
                                                                        Visibility="{x:Bind SupplementaryVisibility, Mode=OneTime}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.ReferencedByDependenciesVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="ReferencedByTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.ReferencedByDependencies, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AssetDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button
                                                                    AutomationProperties.Name="{x:Bind OpenButtonText, Mode=OneTime}"
                                                                    Click="OnResolvedAssetOpenButtonClick"
                                                                    Style="{StaticResource InspectorResolvedAssetTagButtonStyle}"
                                                                    Tag="{x:Bind Target, Mode=OneTime}"
                                                                    ToolTipService.ToolTip="{x:Bind OpenButtonToolTipText, Mode=OneTime}"
                                                                    Visibility="{x:Bind OpenButtonVisibility, Mode=OneTime}">
                                                                    <FontIcon
                                                                        FontFamily="Segoe Fluent Icons"
                                                                        FontSize="14"
                                                                        Glyph="&#xE8B7;" />
                                                                </Button>
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    Spacing="4">
                                                                    <TextBlock
                                                                        FontWeight="SemiBold"
                                                                        Text="{x:Bind Name, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind BundleName, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind MetadataText, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                        Text="{x:Bind SupplementaryText, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords"
                                                                        Visibility="{x:Bind SupplementaryVisibility, Mode=OneTime}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.DependencyClosureVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="DependencyClosureTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.DependencyClosureItems, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AssetDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button
                                                                    AutomationProperties.Name="{x:Bind OpenButtonText, Mode=OneTime}"
                                                                    Click="OnResolvedAssetOpenButtonClick"
                                                                    Style="{StaticResource InspectorResolvedAssetTagButtonStyle}"
                                                                    Tag="{x:Bind Target, Mode=OneTime}"
                                                                    ToolTipService.ToolTip="{x:Bind OpenButtonToolTipText, Mode=OneTime}"
                                                                    Visibility="{x:Bind OpenButtonVisibility, Mode=OneTime}">
                                                                    <FontIcon
                                                                        FontFamily="Segoe Fluent Icons"
                                                                        FontSize="14"
                                                                        Glyph="&#xE8B7;" />
                                                                </Button>
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    Spacing="4">
                                                                    <TextBlock
                                                                        FontWeight="SemiBold"
                                                                        Text="{x:Bind Name, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind BundleName, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind MetadataText, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                        Text="{x:Bind SupplementaryText, Mode=OneTime}"
                                                                        TextWrapping="WrapWholeWords"
                                                                        Visibility="{x:Bind SupplementaryVisibility, Mode=OneTime}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.BundleExternalDependenciesVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="BundleExternalDependenciesTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.BundleExternalDependencies, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:BundleExternalDependencyViewModel">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind DisplayName, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind KindText, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    FontFamily="Cascadia Mono"
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{x:Bind ReferencePath, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.DependenciesEmptyStateVisibility, Mode=OneWay}">
                                        <TextBlock
                                            x:Name="DependenciesEmptyStateText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="WrapWholeWords" />
                                    </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        MinHeight="0"
                        Visibility="{x:Bind ViewModel.ReplacementSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="8">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="ReplacementTargetTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.AssetName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.BundleDisplayName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.AssetTypeText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="ReplacementSourceTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.ReplacementSourceText, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <Button
                                                x:Name="SelectFileReplacementButton"
                                                HorizontalAlignment="Left"
                                                Click="OnSelectFileReplacementButtonClick"
                                                IsEnabled="{x:Bind ViewModel.CanSelectFileReplacementSource, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Name="ReplacementCompatibilityTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ExtractCapabilityLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ExtractCapabilityText, Mode=OneWay}" />
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="FileReplacementCapabilityLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FileReplacementCapabilityText, Mode=OneWay}" />
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="WorkspaceReplacementCapabilityLabelText" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WorkspaceReplacementCapabilityText, Mode=OneWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.ReplacementStatusText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        MinHeight="0"
                        Visibility="{x:Bind ViewModel.ChangesSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="8">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="ChangeSummaryTitleText"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.AssetName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.BundleDisplayName, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.ChangeSummaryText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                    </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border
                    Grid.Row="2"
                    Margin="8,0,8,8"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ExtractButton"
                                Click="OnExtractButtonClick"
                                IsEnabled="{x:Bind ViewModel.CanExtract, Mode=OneWay}" />
                            <Button
                                x:Name="SelectReplacementButton"
                                Click="OnSelectReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.CanSelectReplacementSource, Mode=OneWay}" />
                            <Button
                                x:Name="ApplyReplacementButton"
                                Click="OnApplyReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.CanApplyReplacement, Mode=OneWay}" />
                            <Button
                                x:Name="UndoReplacementButton"
                                Click="OnUndoReplacementButtonClick"
                                IsEnabled="{x:Bind ViewModel.CanUndoReplacement, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

