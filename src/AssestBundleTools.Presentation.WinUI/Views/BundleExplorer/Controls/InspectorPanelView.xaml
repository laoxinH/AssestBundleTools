<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.InspectorPanelView"
    x:Name="InspectorPanelRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="InspectorEmptyStateCardStyle"
            TargetType="Border">
            <Setter
                Property="MaxWidth"
                Value="390" />
            <Setter
                Property="Padding"
                Value="24,22" />
            <Setter
                Property="HorizontalAlignment"
                Value="Center" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter
                Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="CornerRadius"
                Value="8" />
        </Style>

        <Style
            x:Key="InspectorEmptyStateTitleTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="15" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter
                Property="HorizontalAlignment"
                Value="Center" />
            <Setter
                Property="TextAlignment"
                Value="Center" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="InspectorEmptyStateBodyTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter
                Property="HorizontalAlignment"
                Value="Center" />
            <Setter
                Property="MaxWidth"
                Value="320" />
            <Setter
                Property="TextAlignment"
                Value="Center" />
            <Setter
                Property="TextWrapping"
                Value="WrapWholeWords" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Border
            x:Name="InspectorEmptyStateCard"
            Style="{StaticResource InspectorEmptyStateCardStyle}"
            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="12">
                <Border
                    Width="52"
                    Height="52"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="23"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE6E9;" />
                </Border>
                <TextBlock
                    x:Name="EmptyStateTitleText"
                    Style="{StaticResource InspectorEmptyStateTitleTextStyle}" />
                <TextBlock
                    Style="{StaticResource InspectorEmptyStateBodyTextStyle}"
                    Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Grid
            MinHeight="0"
            Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    x:Name="SectionSelectorScrollViewer"
                    Grid.Row="0"
                    Margin="8,0,8,0"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    ViewChanged="OnSectionSelectorScrollViewerViewChanged"
                    ZoomMode="Disabled">
                    <Border
                        Padding="3"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <RadioButton
                                x:Name="DetailsSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="0"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsDetailsSectionSelected, Mode=OneWay}" />
                            <RadioButton
                                x:Name="DependenciesSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="1"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsDependenciesSectionSelected, Mode=OneWay}" />
                            <RadioButton
                                x:Name="ReplacementSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="2"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsReplacementSectionSelected, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ReplacementSectionTabVisibility, Mode=OneWay}" />
                            <RadioButton
                                x:Name="ChangesSectionButton"
                                GroupName="InspectorSectionGroup"
                                Tag="3"
                                Checked="OnSectionRadioButtonChecked"
                                Style="{StaticResource CompactSegmentRadioButtonStyle}"
                                IsChecked="{x:Bind ViewModel.IsChangesSectionSelected, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <Grid
                    Grid.Row="1"
                    MinHeight="0">
                    <ScrollViewer
                        x:Name="DetailsSectionScrollViewer"
                        MinHeight="0"
                        Tag="0"
                        ViewChanged="OnSectionScrollViewerViewChanged"
                        Visibility="{x:Bind ViewModel.DetailsSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="8">
                            <controls:InspectorPreviewSurfaceView
                                FixedPreviewSurfaceHeight="320"
                                IsPreviewActive="{x:Bind ShowDetailsPreview, Mode=OneWay}"
                                ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                LoadMoreTextRequested="OnPreviewSurfaceLoadMoreTextRequested"
                                OpenPreviewLocationRequested="OnPreviewSurfaceOpenPreviewLocationRequested"
                                SpriteTextureReplacementRequested="OnPreviewSurfaceSpriteTextureReplacementRequested"
                                ResolvedAssetOpenRequested="OnPreviewSurfaceResolvedAssetOpenRequested"
                                Visibility="{x:Bind DetailsPreviewVisibility, Mode=OneWay}" />

                            <controls:SpineAtlasPageSelectorView
                                ViewModel="{x:Bind ViewModel.SpineAtlasPageSelector, Mode=OneWay}"
                                SelectionRequested="OnSpineAtlasPageSelectorSelectionRequested" />

                            <StackPanel Spacing="6">
                                <TextBlock
                                    x:Name="InformationSectionTitleText"
                                    Style="{StaticResource WorkspacePaneTitleTextStyle}" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.InformationCards, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:InspectorInfoCardViewModel">
                                            <controls:InspectorInfoCardView
                                                Card="{Binding}"
                                                Margin="0,0,0,8"
                                                HorizontalAlignment="Stretch"
                                                ResolvedAssetOpenRequested="OnInfoCardResolvedAssetOpenRequested" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <controls:InspectorDependenciesView
                        x:Name="DependenciesView"
                        ResolvedAssetOpenRequested="OnPreviewSurfaceResolvedAssetOpenRequested"
                        SectionViewChanged="OnSectionScrollViewerViewChanged"
                        ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.DependenciesSectionVisibility, Mode=OneWay}" />

                    <ScrollViewer
                        x:Name="ReplacementSectionScrollViewer"
                        MinHeight="0"
                        Tag="2"
                        ViewChanged="OnSectionScrollViewerViewChanged"
                        Visibility="{x:Bind ViewModel.ReplacementSectionVisibility, Mode=OneWay}">
                        <StackPanel Padding="8" Spacing="10">
                            <controls:SpineEditPartsPanelView
                                Visibility="{x:Bind SpineEditPanelVisibility, Mode=OneWay}"
                                ViewModel="{x:Bind SpineEditDraft, Mode=OneWay}"
                                BatchMatchRequested="OnSpineEditBatchMatchRequested"
                                PartFileSelectionRequested="OnSpineEditPartFileSelectionRequested" />

                            <StackPanel
                                Spacing="8"
                                Visibility="{x:Bind StandardReplacementContentVisibility, Mode=OneWay}">
                                <Border
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            x:Name="ReplacementTargetTitleText"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.AssetName, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.BundleDisplayName, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.AssetTypeText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            x:Name="ReplacementSourceTitleText"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.ReplacementSourceText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="SelectFileReplacementButton"
                                                Click="OnSelectFileReplacementButtonClick"
                                                IsEnabled="{x:Bind ViewModel.CanSelectFileReplacementSource, Mode=OneWay}" />
                                            <Button
                                                x:Name="ApplySelectedReplacementButton"
                                                Click="OnApplySelectedReplacementButtonClick"
                                                IsEnabled="{x:Bind ViewModel.CanApplyReplacement, Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            x:Name="ReplacementCompatibilityTitleText"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ExtractCapabilityLabelText" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ExtractCapabilityText, Mode=OneWay}" />
                                        </Grid>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FileReplacementCapabilityLabelText" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FileReplacementCapabilityText, Mode=OneWay}" />
                                        </Grid>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="WorkspaceReplacementCapabilityLabelText" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WorkspaceReplacementCapabilityText, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.ReplacementStatusText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <controls:InspectorChangesView
                        x:Name="ChangesView"
                        DeleteRecordRequested="OnChangesDeleteRecordRequested"
                        RedoReplacementRequested="OnChangesRedoReplacementRequested"
                        SectionViewChanged="OnSectionScrollViewerViewChanged"
                        UndoReplacementRequested="OnChangesUndoReplacementRequested"
                        ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ChangesSectionVisibility, Mode=OneWay}" />
                </Grid>

                <Border
                    Grid.Row="2"
                    Margin="8,0,8,6"
                    Padding="0,2"
                    Background="Transparent"
                    Visibility="{x:Bind ActionBarVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Button
                            x:Name="ExtractButton"
                            Click="OnExtractButtonClick"
                            IsEnabled="{x:Bind ViewModel.CanExtract, Mode=OneWay}"
                            Style="{StaticResource WorkspaceOperationButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    FontFamily="{StaticResource AppIconFontFamily}"
                                    FontSize="12"
                                    Glyph="&#xE0DD;" />
                                <TextBlock x:Name="ExtractButtonText" />
                            </StackPanel>
                        </Button>

                        <Border
                            Width="1"
                            Height="16"
                            Margin="7,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                        <Button
                            x:Name="ModifyButton"
                            AutomationProperties.Name="{x:Bind ViewModel.ModifyButtonText, Mode=OneWay}"
                            Click="OnModifyButtonClick"
                            IsEnabled="{x:Bind ViewModel.CanModify, Mode=OneWay}"
                            Style="{StaticResource WorkspaceOperationButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ModifyButtonText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    FontFamily="{StaticResource AppIconFontFamily}"
                                    FontSize="12"
                                    Glyph="{x:Bind ViewModel.ModifyButtonIconGlyph, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="ModifyButtonText"
                                    Text="{x:Bind ViewModel.ModifyButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <Border
                            Width="1"
                            Height="16"
                            Margin="7,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                            Visibility="{x:Bind ViewModel.EditButtonVisibility, Mode=OneWay}" />

                        <Button
                            x:Name="EditButton"
                            AutomationProperties.Name="{x:Bind ViewModel.EditButtonText, Mode=OneWay}"
                            Click="OnEditButtonClick"
                            IsEnabled="{x:Bind ViewModel.CanEditText, Mode=OneWay}"
                            Style="{StaticResource WorkspaceOperationButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.EditButtonText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.EditButtonVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    FontFamily="{StaticResource AppIconFontFamily}"
                                    FontSize="12"
                                    Glyph="{x:Bind ViewModel.EditButtonIconGlyph, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.EditButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

