<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.WorkspaceBatchExtractionDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ThemeShadow x:Key="BatchExtractionCardShadow" />
        <Style
            x:Key="DialogSectionTitleTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style
            x:Key="DialogSecondaryTextStyle"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style
            x:Key="BatchExtractionPanelCardStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,28" />
            <Setter Property="Shadow" Value="{StaticResource BatchExtractionCardShadow}" />
        </Style>
        <Style
            x:Key="BatchExtractionCompactButtonStyle"
            TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        MinHeight="0"
        ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="1.35*"
                MinWidth="540" />
            <ColumnDefinition
                Width="*"
                MinWidth="420" />
        </Grid.ColumnDefinitions>

        <Border
            Style="{StaticResource BatchExtractionPanelCardStyle}"
            Translation="0,0,8">
            <Grid
                MinHeight="0"
                RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="BundleSectionTitleText"
                            Style="{StaticResource DialogSectionTitleTextStyle}" />
                        <TextBlock
                            x:Name="BundleSectionHintText"
                            Style="{StaticResource DialogSecondaryTextStyle}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="SelectAllBundlesButton"
                            Click="OnSelectAllBundlesButtonClick"
                            Style="{StaticResource BatchExtractionCompactButtonStyle}" />
                        <Button
                            x:Name="ClearBundleSelectionButton"
                            Click="OnClearBundleSelectionButtonClick"
                            Style="{StaticResource BatchExtractionCompactButtonStyle}" />
                    </StackPanel>
                </Grid>

                <AutoSuggestBox
                    x:Name="BundleSearchTextBox"
                    Grid.Row="1"
                    Height="38"
                    FontSize="14"
                    QueryIcon="Find"
                    TextChanged="OnBundleSearchTextChanged" />

                <Grid
                    Grid.Row="2"
                    MinHeight="0">
                    <ListView
                        x:Name="BundleListView"
                        ItemsSource="{Binding VisibleBundles}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="66" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid
                                        Padding="10,6"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid VerticalAlignment="Center">
                                            <CheckBox
                                                Width="28"
                                                MinWidth="0"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </Grid>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                FontSize="12"
                                                Text="{Binding LogicalPath}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="13"
                                            Text="{Binding AssetCountText}" />
                                    </Grid>
                                    <Rectangle
                                        Height="1"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Bottom"
                                        Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="BundleEmptyStateText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource DialogSecondaryTextStyle}"
                        Visibility="{Binding BundleEmptyStateVisibility}" />
                </Grid>

                <TextBlock
                    x:Name="SelectedBundleSummaryText"
                    Grid.Row="3"
                    Style="{StaticResource DialogSecondaryTextStyle}"
                    Text="{Binding SelectedBundleSummaryText}" />
            </Grid>
        </Border>

        <Grid
            Grid.Column="1"
            MinHeight="0"
            RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Style="{StaticResource BatchExtractionPanelCardStyle}"
                Translation="0,0,8">
                <Grid
                    MinHeight="0"
                    RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="CategorySectionTitleText"
                            Style="{StaticResource DialogSectionTitleTextStyle}" />
                        <TextBlock
                            x:Name="CategorySectionHintText"
                            Style="{StaticResource DialogSecondaryTextStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CategoryOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid
                                            MinHeight="46"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid VerticalAlignment="Center">
                                                <CheckBox
                                                    Width="28"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            </Grid>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                FontSize="13"
                                                Text="{Binding CandidateCountText}" />
                                        </Grid>
                                        <Rectangle
                                            Height="1"
                                            VerticalAlignment="Bottom"
                                            Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Visibility="{Binding AllCategoryDividerVisibility}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
