<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.WorkspaceBatchReplacementDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ThemeShadow x:Key="BatchReplacementCardShadow" />
        <Style
            x:Key="DialogSectionTitleTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style
            x:Key="DialogSecondaryTextStyle"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style
            x:Key="BatchReplacementPanelCardStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Shadow" Value="{StaticResource BatchReplacementCardShadow}" />
        </Style>
        <Style
            x:Key="BatchReplacementCompactButtonStyle"
            TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        MinHeight="0"
        RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Style="{StaticResource BatchReplacementPanelCardStyle}"
            Translation="0,0,8">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="SourceSectionTitleText"
                            Style="{StaticResource DialogSectionTitleTextStyle}" />
                        <TextBlock
                            x:Name="SourceSectionHintText"
                            Style="{StaticResource DialogSecondaryTextStyle}" />
                    </StackPanel>
                    <Button
                        x:Name="ChooseSourceDirectoryButton"
                        Grid.Column="1"
                        Click="OnChooseSourceDirectoryButtonClick"
                        Style="{StaticResource BatchReplacementCompactButtonStyle}" />
                    <Button
                        x:Name="RefreshPlanButton"
                        Grid.Column="2"
                        Click="OnRefreshPlanButtonClick"
                        IsEnabled="{Binding HasSourceDirectory}"
                        Style="{StaticResource BatchReplacementCompactButtonStyle}" />
                </Grid>

                <Grid
                    Grid.Row="1"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <TextBlock
                            x:Name="SourceModeText"
                            FontSize="12"
                            FontWeight="SemiBold" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Text="{Binding SourceSummaryText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords" />
                </Grid>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            MinHeight="0"
            ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="360"
                    MinWidth="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Style="{StaticResource BatchReplacementPanelCardStyle}"
                Translation="0,0,8">
                <Grid
                    MinHeight="0"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="BundleSectionTitleText"
                            Style="{StaticResource DialogSectionTitleTextStyle}" />
                        <TextBlock
                            x:Name="BundleSectionHintText"
                            Style="{StaticResource DialogSecondaryTextStyle}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="SelectAllBundlesButton"
                            Click="OnSelectAllBundlesButtonClick"
                            Style="{StaticResource BatchReplacementCompactButtonStyle}" />
                        <Button
                            x:Name="ClearBundleSelectionButton"
                            Click="OnClearBundleSelectionButtonClick"
                            Style="{StaticResource BatchReplacementCompactButtonStyle}" />
                    </StackPanel>

                    <ListView
                        Grid.Row="2"
                        ItemsSource="{Binding Bundles}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="62" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid
                                        Padding="6"
                                        ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            Width="28"
                                            MinWidth="0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="3">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                FontSize="12"
                                                Text="{Binding LogicalPath}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="{Binding CountText}" />
                                    </Grid>
                                    <Rectangle
                                        Height="1"
                                        VerticalAlignment="Bottom"
                                        Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Style="{StaticResource BatchReplacementPanelCardStyle}"
                Translation="0,0,8">
                <Grid
                    MinHeight="0"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="CandidateSectionTitleText"
                            Style="{StaticResource DialogSectionTitleTextStyle}" />
                        <TextBlock
                            x:Name="CandidateSectionHintText"
                            Style="{StaticResource DialogSecondaryTextStyle}" />
                    </StackPanel>

                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox
                            x:Name="CandidateSearchBox"
                            Height="36"
                            IsEnabled="{Binding HasCandidates}"
                            Text="{Binding CandidateSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            QueryIcon="Find" />
                        <ComboBox
                            x:Name="StatusFilterComboBox"
                            Grid.Column="1"
                            Width="132"
                            IsEnabled="{Binding HasCandidates}"
                            ItemsSource="{Binding StatusFilters}"
                            SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox
                            x:Name="TypeFilterComboBox"
                            Grid.Column="2"
                            Width="132"
                            IsEnabled="{Binding HasCandidates}"
                            ItemsSource="{Binding TypeFilters}"
                            SelectedItem="{Binding SelectedTypeFilter, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid
                        Grid.Row="2"
                        MinHeight="0">
                        <ListView
                            ItemsSource="{Binding FilteredCandidates}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="78" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid
                                            Padding="8,8"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                Width="28"
                                                MinWidth="0"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                IsEnabled="{Binding CanSelect}" />
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding AssetName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    FontSize="12"
                                                    Text="{Binding SubtitleText}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    FontSize="12"
                                                    Text="{Binding RelativePath}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="2"
                                                Padding="8,3"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <TextBlock
                                                    FontSize="12"
                                                    Text="{Binding StatusText}" />
                                            </Border>
                                        </Grid>
                                        <Rectangle
                                            Height="1"
                                            VerticalAlignment="Bottom"
                                            Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            x:Name="SourceEmptyStateText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource DialogSecondaryTextStyle}"
                            Visibility="{Binding SourceEmptyVisibility}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
