<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.InspectorGameObjectPreviewSurfaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    xmlns:controls="using:AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="GameObjectPreviewSecondaryTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="GameObjectPreviewSummaryCardStyle"
            TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="10">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="42"
                Height="42"
                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                CornerRadius="13">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="18"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Glyph="&#xE8A9;" />
            </Border>

            <StackPanel
                Grid.Column="1"
                Spacing="2">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    MaxLines="2"
                    Text="{x:Bind ViewModel.AssetNameText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    MaxLines="2"
                    Style="{StaticResource GameObjectPreviewSecondaryTextStyle}"
                    Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Border
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="6">
                <TextBlock
                    FontWeight="SemiBold"
                    MaxLines="2"
                    Text="{x:Bind ViewModel.ComponentSummaryText, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    MaxLines="2"
                    Style="{StaticResource GameObjectPreviewSecondaryTextStyle}"
                    Text="{x:Bind ViewModel.TransformSummaryText, Mode=OneWay}" />
                <TextBlock
                    MaxLines="1"
                    Style="{StaticResource GameObjectPreviewSecondaryTextStyle}"
                    Text="{x:Bind ViewModel.HierarchySummaryText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HierarchySummaryVisibility, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <ItemsControl
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind ViewModel.SummaryCards, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.SummaryCardsVisibility, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:TwoColumnSummaryCardPanel
                        ColumnSpacing="6"
                        MinItemWidth="132"
                        RowSpacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="bindings:GameObjectPreviewSummaryCardViewModel">
                    <Border Style="{StaticResource GameObjectPreviewSummaryCardStyle}">
                        <StackPanel Spacing="1">
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind TitleText, Mode=OneTime}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{x:Bind ValueText, Mode=OneTime}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind DetailText, Mode=OneTime}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind DetailVisibility, Mode=OneTime}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
