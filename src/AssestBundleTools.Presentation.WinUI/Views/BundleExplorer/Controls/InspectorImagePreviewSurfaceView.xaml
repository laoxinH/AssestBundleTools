<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls.InspectorImagePreviewSurfaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AssestBundleTools.Presentation.WinUI.Views.BundleExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AssestBundleTools.Presentation.WinUI.ViewModels.BundleExplorer.Bindings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="InspectorPreviewOverlayBadgeBorderStyle"
            TargetType="Border">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#78111115" />
            <Setter
                Property="BorderBrush"
                Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style
            x:Key="InspectorPreviewOverlayBadgeTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style
            x:Key="InspectorSpriteEditMeasurementBorderStyle"
            TargetType="Border">
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>

        <Style
            x:Key="InspectorSpriteEditMeasurementTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style
            x:Key="InspectorPreviewRegionOverlayItemContainerStyle"
            TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
        </Style>

        <DataTemplate
            x:Key="InspectorPreviewRegionOverlayItemTemplate"
            x:DataType="viewModels:PreviewImageRegionOverlayItemViewModel">
            <Grid
                Width="{x:Bind Width}"
                Height="{x:Bind Height}"
                ToolTipService.ToolTip="{x:Bind LabelText}">
                <Rectangle
                    RadiusX="3"
                    RadiusY="3"
                    Fill="Transparent"
                    Stroke="#CC101418"
                    StrokeThickness="1.5" />
                <Rectangle
                    RadiusX="3"
                    RadiusY="3"
                    Fill="Transparent"
                    Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                    StrokeThickness="0.75" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        x:Name="PreviewImageViewportHost"
        Background="Transparent"
        PointerCanceled="OnPreviewImagePointerReleased"
        PointerCaptureLost="OnPreviewImagePointerReleased"
        PointerMoved="OnPreviewImagePointerMoved"
        PointerPressed="OnPreviewImagePointerPressed"
        PointerReleased="OnPreviewImagePointerReleased"
        PointerWheelChanged="OnPreviewImagePointerWheelChanged"
        SizeChanged="OnPreviewImageViewportHostSizeChanged">
        <controls:CheckerboardBackground
            CellSize="12"
            Visibility="{x:Bind ViewModel.DisplayOptions.CheckerboardBackgroundVisibility, Mode=OneWay}" />
        <Border
            Background="White"
            Visibility="{x:Bind ViewModel.DisplayOptions.SolidBackgroundVisibility, Mode=OneWay}" />

        <Grid Visibility="{x:Bind ViewModel.DisplayOptions.FullImagePreviewVisibility, Mode=OneWay}">
            <Canvas>
                <Image
                    Canvas.Left="{x:Bind ViewModel.FullImageX, Mode=OneWay}"
                    Canvas.Top="{x:Bind ViewModel.FullImageY, Mode=OneWay}"
                    Width="{x:Bind ViewModel.FullImageWidth, Mode=OneWay}"
                    Height="{x:Bind ViewModel.FullImageHeight, Mode=OneWay}"
                    Source="{x:Bind ViewModel.ImageSource, Mode=OneWay}"
                    Stretch="Fill" />
            </Canvas>

            <Canvas
                IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.RegionOverlayVisibility, Mode=OneWay}">
                <ItemsControl
                    ItemContainerStyle="{StaticResource InspectorPreviewRegionOverlayItemContainerStyle}"
                    ItemTemplate="{StaticResource InspectorPreviewRegionOverlayItemTemplate}"
                    ItemsSource="{x:Bind ViewModel.RegionOverlays, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Canvas>

            <Canvas
                IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.OverlayVisibility, Mode=OneWay}">
                <Rectangle
                    Canvas.Left="{x:Bind ViewModel.OverlayX, Mode=OneWay}"
                    Canvas.Top="{x:Bind ViewModel.OverlayY, Mode=OneWay}"
                    Width="{x:Bind ViewModel.OverlayWidth, Mode=OneWay}"
                    Height="{x:Bind ViewModel.OverlayHeight, Mode=OneWay}"
                    RadiusX="6"
                    RadiusY="6"
                    Fill="Transparent"
                    Stroke="#CC101418"
                    StrokeThickness="1.5" />

                <Rectangle
                    Canvas.Left="{x:Bind ViewModel.OverlayX, Mode=OneWay}"
                    Canvas.Top="{x:Bind ViewModel.OverlayY, Mode=OneWay}"
                    Width="{x:Bind ViewModel.OverlayWidth, Mode=OneWay}"
                    Height="{x:Bind ViewModel.OverlayHeight, Mode=OneWay}"
                    RadiusX="6"
                    RadiusY="6"
                    Fill="Transparent"
                    Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                    StrokeThickness="0.75" />

                <Line
                    X1="{x:Bind ViewModel.BorderLeftX, Mode=OneWay}"
                    X2="{x:Bind ViewModel.BorderLeftX, Mode=OneWay}"
                    Y1="{x:Bind ViewModel.BorderVerticalTop, Mode=OneWay}"
                    Y2="{x:Bind ViewModel.BorderVerticalBottom, Mode=OneWay}"
                    Stroke="{ThemeResource AccentFillColorSecondaryBrush}"
                    StrokeThickness="0.75"
                    Visibility="{x:Bind ViewModel.BorderVisibility, Mode=OneWay}" />
                <Line
                    X1="{x:Bind ViewModel.BorderRightX, Mode=OneWay}"
                    X2="{x:Bind ViewModel.BorderRightX, Mode=OneWay}"
                    Y1="{x:Bind ViewModel.BorderVerticalTop, Mode=OneWay}"
                    Y2="{x:Bind ViewModel.BorderVerticalBottom, Mode=OneWay}"
                    Stroke="{ThemeResource AccentFillColorSecondaryBrush}"
                    StrokeThickness="0.75"
                    Visibility="{x:Bind ViewModel.BorderVisibility, Mode=OneWay}" />
                <Line
                    X1="{x:Bind ViewModel.BorderHorizontalLeft, Mode=OneWay}"
                    X2="{x:Bind ViewModel.BorderHorizontalRight, Mode=OneWay}"
                    Y1="{x:Bind ViewModel.BorderTopY, Mode=OneWay}"
                    Y2="{x:Bind ViewModel.BorderTopY, Mode=OneWay}"
                    Stroke="{ThemeResource AccentFillColorSecondaryBrush}"
                    StrokeThickness="0.75"
                    Visibility="{x:Bind ViewModel.BorderVisibility, Mode=OneWay}" />
                <Line
                    X1="{x:Bind ViewModel.BorderHorizontalLeft, Mode=OneWay}"
                    X2="{x:Bind ViewModel.BorderHorizontalRight, Mode=OneWay}"
                    Y1="{x:Bind ViewModel.BorderBottomY, Mode=OneWay}"
                    Y2="{x:Bind ViewModel.BorderBottomY, Mode=OneWay}"
                    Stroke="{ThemeResource AccentFillColorSecondaryBrush}"
                    StrokeThickness="0.75"
                    Visibility="{x:Bind ViewModel.BorderVisibility, Mode=OneWay}" />

                <Canvas
                    IsHitTestVisible="False"
                    Visibility="{x:Bind ViewModel.SpriteEditMeasurementVisibility, Mode=OneWay}">
                    <Line
                        X1="{x:Bind ViewModel.SpriteEditAxisOriginX, Mode=OneWay}"
                        X2="{x:Bind ViewModel.SpriteEditAxisXEndX, Mode=OneWay}"
                        Y1="{x:Bind ViewModel.SpriteEditAxisOriginY, Mode=OneWay}"
                        Y2="{x:Bind ViewModel.SpriteEditAxisOriginY, Mode=OneWay}"
                        Opacity="0.62"
                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                        StrokeThickness="1" />
                    <Line
                        X1="{x:Bind ViewModel.SpriteEditAxisOriginX, Mode=OneWay}"
                        X2="{x:Bind ViewModel.SpriteEditAxisOriginX, Mode=OneWay}"
                        Y1="{x:Bind ViewModel.SpriteEditAxisOriginY, Mode=OneWay}"
                        Y2="{x:Bind ViewModel.SpriteEditAxisYEndY, Mode=OneWay}"
                        Opacity="0.62"
                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                        StrokeThickness="1" />
                    <Ellipse
                        Width="5"
                        Height="5"
                        Canvas.Left="{x:Bind ViewModel.SpriteEditAxisOriginX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SpriteEditAxisOriginY, Mode=OneWay}"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                        Opacity="0.72">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-2.5" Y="-2.5" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>

                <Ellipse
                    Width="10"
                    Height="10"
                    Canvas.Left="{x:Bind ViewModel.PivotX, Mode=OneWay}"
                    Canvas.Top="{x:Bind ViewModel.PivotY, Mode=OneWay}"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                    Stroke="#EE101418"
                    StrokeThickness="1"
                    Visibility="{x:Bind ViewModel.PivotVisibility, Mode=OneWay}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="-5" Y="-5" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse
                    Width="10"
                    Height="10"
                    Canvas.Left="{x:Bind ViewModel.OverlayX, Mode=OneWay}"
                    Canvas.Top="{x:Bind ViewModel.OverlayY, Mode=OneWay}"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                    StrokeThickness="1"
                    Visibility="{x:Bind ViewModel.SpriteEditHandleVisibility, Mode=OneWay}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="-5" Y="-5" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse
                    Width="10"
                    Height="10"
                    Canvas.Left="{x:Bind ViewModel.OverlayRightX, Mode=OneWay}"
                    Canvas.Top="{x:Bind ViewModel.OverlayY, Mode=OneWay}"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                    StrokeThickness="1"
                    Visibility="{x:Bind ViewModel.SpriteEditHandleVisibility, Mode=OneWay}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="-5" Y="-5" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse
                    Width="10"
                    Height="10"
                    Canvas.Left="{x:Bind ViewModel.OverlayX, Mode=OneWay}"
                    Canvas.Top="{x:Bind ViewModel.OverlayBottomY, Mode=OneWay}"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                    StrokeThickness="1"
                    Visibility="{x:Bind ViewModel.SpriteEditHandleVisibility, Mode=OneWay}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="-5" Y="-5" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse
                    Width="10"
                    Height="10"
                    Canvas.Left="{x:Bind ViewModel.OverlayRightX, Mode=OneWay}"
                    Canvas.Top="{x:Bind ViewModel.OverlayBottomY, Mode=OneWay}"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                    StrokeThickness="1"
                    Visibility="{x:Bind ViewModel.SpriteEditHandleVisibility, Mode=OneWay}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform X="-5" Y="-5" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Canvas
                    IsHitTestVisible="False"
                    Visibility="{x:Bind ViewModel.SpriteEditMeasurementVisibility, Mode=OneWay}">
                    <Border
                        Width="82"
                        Canvas.Left="{x:Bind ViewModel.SpriteEditTopLeftCoordinateLabelX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SpriteEditTopLeftCoordinateLabelY, Mode=OneWay}"
                        Style="{StaticResource InspectorSpriteEditMeasurementBorderStyle}">
                        <TextBlock
                            Style="{StaticResource InspectorSpriteEditMeasurementTextStyle}"
                            Text="{x:Bind ViewModel.SpriteEditTopLeftCoordinateText, Mode=OneWay}" />
                    </Border>
                    <Border
                        Width="82"
                        Canvas.Left="{x:Bind ViewModel.SpriteEditTopRightCoordinateLabelX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SpriteEditTopRightCoordinateLabelY, Mode=OneWay}"
                        Style="{StaticResource InspectorSpriteEditMeasurementBorderStyle}">
                        <TextBlock
                            Style="{StaticResource InspectorSpriteEditMeasurementTextStyle}"
                            Text="{x:Bind ViewModel.SpriteEditTopRightCoordinateText, Mode=OneWay}" />
                    </Border>
                    <Border
                        Width="82"
                        Canvas.Left="{x:Bind ViewModel.SpriteEditBottomLeftCoordinateLabelX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SpriteEditBottomLeftCoordinateLabelY, Mode=OneWay}"
                        Style="{StaticResource InspectorSpriteEditMeasurementBorderStyle}">
                        <TextBlock
                            Style="{StaticResource InspectorSpriteEditMeasurementTextStyle}"
                            Text="{x:Bind ViewModel.SpriteEditBottomLeftCoordinateText, Mode=OneWay}" />
                    </Border>
                    <Border
                        Width="82"
                        Canvas.Left="{x:Bind ViewModel.SpriteEditBottomRightCoordinateLabelX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SpriteEditBottomRightCoordinateLabelY, Mode=OneWay}"
                        Style="{StaticResource InspectorSpriteEditMeasurementBorderStyle}">
                        <TextBlock
                            Style="{StaticResource InspectorSpriteEditMeasurementTextStyle}"
                            Text="{x:Bind ViewModel.SpriteEditBottomRightCoordinateText, Mode=OneWay}" />
                    </Border>
                    <Border
                        Width="56"
                        Canvas.Left="{x:Bind ViewModel.SpriteEditTopLengthLabelX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SpriteEditTopLengthLabelY, Mode=OneWay}"
                        Style="{StaticResource InspectorSpriteEditMeasurementBorderStyle}">
                        <TextBlock
                            Style="{StaticResource InspectorSpriteEditMeasurementTextStyle}"
                            Text="{x:Bind ViewModel.SpriteEditTopLengthText, Mode=OneWay}" />
                    </Border>
                    <Border
                        Width="56"
                        Canvas.Left="{x:Bind ViewModel.SpriteEditBottomLengthLabelX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SpriteEditBottomLengthLabelY, Mode=OneWay}"
                        Style="{StaticResource InspectorSpriteEditMeasurementBorderStyle}">
                        <TextBlock
                            Style="{StaticResource InspectorSpriteEditMeasurementTextStyle}"
                            Text="{x:Bind ViewModel.SpriteEditBottomLengthText, Mode=OneWay}" />
                    </Border>
                    <Border
                        Width="56"
                        Canvas.Left="{x:Bind ViewModel.SpriteEditLeftLengthLabelX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SpriteEditLeftLengthLabelY, Mode=OneWay}"
                        Style="{StaticResource InspectorSpriteEditMeasurementBorderStyle}">
                        <TextBlock
                            Style="{StaticResource InspectorSpriteEditMeasurementTextStyle}"
                            Text="{x:Bind ViewModel.SpriteEditLeftLengthText, Mode=OneWay}" />
                    </Border>
                    <Border
                        Width="56"
                        Canvas.Left="{x:Bind ViewModel.SpriteEditRightLengthLabelX, Mode=OneWay}"
                        Canvas.Top="{x:Bind ViewModel.SpriteEditRightLengthLabelY, Mode=OneWay}"
                        Style="{StaticResource InspectorSpriteEditMeasurementBorderStyle}">
                        <TextBlock
                            Style="{StaticResource InspectorSpriteEditMeasurementTextStyle}"
                            Text="{x:Bind ViewModel.SpriteEditRightLengthText, Mode=OneWay}" />
                    </Border>
                </Canvas>
            </Canvas>

            <Border
                Margin="8"
                MaxWidth="210"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Style="{StaticResource InspectorPreviewOverlayBadgeBorderStyle}"
                Visibility="{x:Bind ViewModel.OverlayBadgeVisibility, Mode=OneWay}">
                <TextBlock
                    Style="{StaticResource InspectorPreviewOverlayBadgeTextStyle}"
                    Text="{x:Bind ViewModel.OverlayLabelText, Mode=OneWay}" />
            </Border>

            <Border
                Margin="8"
                MaxWidth="260"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Style="{StaticResource InspectorPreviewOverlayBadgeBorderStyle}"
                Visibility="{x:Bind ViewModel.RegionOverlayBadgeVisibility, Mode=OneWay}">
                <TextBlock
                    Style="{StaticResource InspectorPreviewOverlayBadgeTextStyle}"
                    Text="{x:Bind ViewModel.RegionOverlayBadgeText, Mode=OneWay}" />
            </Border>

            <Border
                Margin="8"
                MaxWidth="260"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource InspectorPreviewOverlayBadgeBorderStyle}"
                Visibility="{x:Bind ViewModel.InfoBadgeVisibility, Mode=OneWay}">
                <StackPanel Spacing="2">
                    <TextBlock
                        Style="{StaticResource InspectorPreviewOverlayBadgeTextStyle}"
                        Text="{x:Bind ViewModel.InfoBadgePrimaryText, Mode=OneWay}" />
                    <TextBlock
                        Opacity="0.86"
                        Style="{StaticResource InspectorPreviewOverlayBadgeTextStyle}"
                        Text="{x:Bind ViewModel.InfoBadgeSecondaryText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.InfoBadgeSecondaryVisibility, Mode=OneWay}" />
                    <TextBlock
                        Opacity="0.72"
                        Style="{StaticResource InspectorPreviewOverlayBadgeTextStyle}"
                        Text="{x:Bind ViewModel.InfoBadgeDetailText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.InfoBadgeDetailVisibility, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{x:Bind ViewModel.DisplayOptions.SpriteCropResultVisibility, Mode=OneWay}">
            <Canvas>
                <Image
                    Canvas.Left="{x:Bind ViewModel.SpriteFocusImageX, Mode=OneWay}"
                    Canvas.Top="{x:Bind ViewModel.SpriteFocusImageY, Mode=OneWay}"
                    Width="{x:Bind ViewModel.SpriteFocusImageWidth, Mode=OneWay}"
                    Height="{x:Bind ViewModel.SpriteFocusImageHeight, Mode=OneWay}"
                    Source="{x:Bind ViewModel.SpriteFocusImageSource, Mode=OneWay}"
                    Stretch="Fill" />
            </Canvas>

            <Border
                Margin="8"
                MaxWidth="210"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Style="{StaticResource InspectorPreviewOverlayBadgeBorderStyle}">
                <StackPanel Spacing="2">
                    <TextBlock
                        Style="{StaticResource InspectorPreviewOverlayBadgeTextStyle}"
                        Text="{x:Bind ViewModel.SpriteFocusPreviewTitleText, Mode=OneWay}" />
                    <TextBlock
                        Opacity="0.86"
                        Style="{StaticResource InspectorPreviewOverlayBadgeTextStyle}"
                        Text="{x:Bind ViewModel.SpriteFocusPreviewSizeText, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
