<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AssestBundleTools.Presentation.WinUI.Views.Home.HomePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:home="using:AssestBundleTools.Presentation.WinUI.ViewModels.Home"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="HomePanelCardStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style
            x:Key="HomePanelTitleTextStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style
            x:Key="HomeSecondaryTextStyle"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="HomeIconBadgeStyle"
            TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style
            x:Key="HomeListActionButtonStyle"
            TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Page.Resources>

    <Grid
        Padding="24,18,20,20"
        RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="PageTitleText"
            FontSize="34"
            FontWeight="SemiBold"
            TextWrapping="NoWrap"
            TextTrimming="CharacterEllipsis" />

        <Grid
            Grid.Row="1"
            MinHeight="0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                MinHeight="0"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="18,16"
                    Style="{StaticResource HomePanelCardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="QuickActionsTitleText"
                                Style="{StaticResource HomePanelTitleTextStyle}" />
                            <TextBlock
                                x:Name="QuickActionHintText"
                                MaxLines="2"
                                Style="{StaticResource HomeSecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            Spacing="2">
                            <Button
                                x:Name="NewWorkspaceButton"
                                Click="OnNewWorkspaceButtonClick"
                                Style="{StaticResource SettingsRowButtonStyle}">
                                <Grid
                                    Padding="12,9"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource HomeIconBadgeStyle}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="15"
                                            Glyph="&#xE710;" />
                                    </Border>

                                    <TextBlock
                                        x:Name="NewWorkspaceButtonText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <FontIcon
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        Glyph="&#xE76C;" />
                                </Grid>
                            </Button>

                            <Border
                                Height="1"
                                Margin="12,0"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Button
                                x:Name="OpenWorkspaceButton"
                                Click="OnOpenWorkspaceButtonClick"
                                Style="{StaticResource SettingsRowButtonStyle}">
                                <Grid
                                    Padding="12,9"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource HomeIconBadgeStyle}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="15"
                                            Glyph="&#xE8B7;" />
                                    </Border>

                                    <TextBlock
                                        x:Name="OpenWorkspaceButtonText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <FontIcon
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        Glyph="&#xE76C;" />
                                </Grid>
                            </Button>

                            <Border
                                Height="1"
                                Margin="12,0"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Button
                                x:Name="OpenLatestWorkspaceButton"
                                Click="OnOpenLatestWorkspaceButtonClick"
                                IsEnabled="{x:Bind ViewModel.CanOpenLatestRecentWorkspace, Mode=OneWay}"
                                Style="{StaticResource SettingsRowButtonStyle}">
                                <Grid
                                    Padding="12,9"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource HomeIconBadgeStyle}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="15"
                                            Glyph="&#xE823;" />
                                    </Border>

                                    <TextBlock
                                        x:Name="OpenLatestWorkspaceButtonText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <FontIcon
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        Glyph="&#xE76C;" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    MinHeight="0"
                    Padding="18,16"
                    Style="{StaticResource HomePanelCardStyle}">
                    <Grid
                        MinHeight="0"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="RecentActivityTitleText"
                            Style="{StaticResource HomePanelTitleTextStyle}" />

                        <Grid
                            Grid.Row="1"
                            MinHeight="0">
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Auto">
                                <ItemsControl
                                    ItemsSource="{x:Bind ViewModel.RecentActivityItems, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.RecentActivityListVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="home:HomeRecentActivityItemViewModel">
                                            <Grid
                                                MinHeight="54"
                                                Padding="0,8"
                                                ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="30"
                                                    Height="30"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="12"
                                                        Glyph="&#xE823;" />
                                                </Border>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="2">
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Time}" />
                                                    <TextBlock
                                                        MaxLines="2"
                                                        Text="{x:Bind Summary}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="280"
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.RecentActivityEmptyStateVisibility, Mode=OneWay}">
                                <Border Style="{StaticResource HomeIconBadgeStyle}">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="15"
                                        Glyph="&#xE9D9;" />
                                </Border>
                                <TextBlock
                                    x:Name="RecentActivityEmptyText"
                                    Style="{StaticResource HomeSecondaryTextStyle}"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Column="1"
                MinHeight="0"
                Padding="18,16"
                Style="{StaticResource HomePanelCardStyle}">
                <Grid
                    MinHeight="0"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="RecentOpenedTitleText"
                        Style="{StaticResource HomePanelTitleTextStyle}" />

                    <AutoSuggestBox
                        x:Name="WorkspaceSearchBox"
                        Grid.Row="1"
                        Height="36"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.WorkspaceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid
                        Grid.Row="2"
                        MinHeight="0">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Auto">
                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.RecentWorkspaceItems, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.RecentWorkspaceListVisibility, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="home:HomeRecentWorkspaceItemViewModel">
                                        <Grid
                                            MinHeight="78"
                                            ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>

                                            <Button
                                                Padding="0"
                                                Click="OnRecentWorkspaceButtonClick"
                                                IsEnabled="{x:Bind CanOpen}"
                                                Style="{StaticResource SettingsRowButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind WorkspaceDataRootSummary}">
                                                <Grid
                                                    Padding="12,9"
                                                    ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Style="{StaticResource HomeIconBadgeStyle}">
                                                        <FontIcon
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="15"
                                                            Glyph="&#xE8B7;" />
                                                    </Border>

                                                    <Grid
                                                        Grid.Column="1"
                                                        MinWidth="0"
                                                        RowSpacing="3">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Text="{x:Bind DisplayName}"
                                                                TextTrimming="CharacterEllipsis" />

                                                            <StackPanel
                                                                Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="5">
                                                                <Border
                                                                    Padding="8,3"
                                                                    Style="{StaticResource ExplorerTreeBadgeStyle}">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind PrimaryBadgeText}" />
                                                                </Border>

                                                                <Border
                                                                    Padding="8,3"
                                                                    Style="{StaticResource ExplorerTreeBadgeStyle}"
                                                                    Visibility="{x:Bind SecondaryBadgeVisibility}">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind SecondaryBadgeText}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            MaxLines="1"
                                                            Text="{x:Bind SourceSummary}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{x:Bind SourceSummary}" />

                                                        <TextBlock
                                                            Grid.Row="2"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            MaxLines="1"
                                                            Text="{x:Bind LastActivatedSummary}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>

                                                    <FontIcon
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        FontFamily="Segoe Fluent Icons"
                                                        Glyph="&#xE76C;" />
                                                </Grid>
                                            </Button>

                                            <StackPanel
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                                <Button
                                                    Click="OnRecentWorkspacePinButtonClick"
                                                    Style="{StaticResource HomeListActionButtonStyle}"
                                                    ToolTipService.ToolTip="{x:Bind PinButtonToolTipText}">
                                                    <SymbolIcon Symbol="{x:Bind PinButtonSymbol}" />
                                                </Button>

                                                <Button
                                                    Click="OnRecentWorkspaceDeleteButtonClick"
                                                    Style="{StaticResource HomeListActionButtonStyle}"
                                                    ToolTipService.ToolTip="{Binding RecentWorkspaceDeleteToolTipText, ElementName=RootPage}">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="12"
                                                        Glyph="&#xE74D;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="360"
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.RecentWorkspaceEmptyStateVisibility, Mode=OneWay}">
                            <Border Style="{StaticResource HomeIconBadgeStyle}">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="15"
                                    Glyph="&#xE838;" />
                            </Border>
                            <TextBlock
                                x:Name="RecentWorkspaceEmptyText"
                                Style="{StaticResource HomeSecondaryTextStyle}"
                                TextAlignment="Center" />
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="360"
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.RecentWorkspaceNoMatchesStateVisibility, Mode=OneWay}">
                            <Border Style="{StaticResource HomeIconBadgeStyle}">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="15"
                                    Glyph="&#xE721;" />
                            </Border>
                            <TextBlock
                                x:Name="RecentWorkspaceNoMatchesText"
                                Style="{StaticResource HomeSecondaryTextStyle}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
