<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AssestBundleTools.Presentation.WinUI.Views.Home.HomePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:home="using:AssestBundleTools.Presentation.WinUI.ViewModels.Home"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid
        Padding="24,18,16,20"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="PageTitleText"
            FontSize="46"
            FontWeight="SemiBold"
            TextWrapping="WrapWholeWords" />

        <Border
            Grid.Row="1"
            Style="{StaticResource SettingsSectionCardStyle}"
            Padding="24,22">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="QuickActionsTitleText"
                        Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="QuickActionHintText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel Spacing="2">
                    <Button
                        x:Name="NewWorkspaceButton"
                        Style="{StaticResource SettingsRowButtonStyle}"
                        Click="OnNewWorkspaceButtonClick">
                        <Grid
                            Padding="18,14"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="NewWorkspaceButtonText"
                                VerticalAlignment="Center" />
                            <FontIcon
                                Grid.Column="1"
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE76C;"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border
                        Height="1"
                        Margin="16,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Button
                        x:Name="OpenWorkspaceButton"
                        Style="{StaticResource SettingsRowButtonStyle}"
                        Click="OnOpenWorkspaceButtonClick">
                        <Grid
                            Padding="18,14"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="OpenWorkspaceButtonText"
                                VerticalAlignment="Center" />
                            <FontIcon
                                Grid.Column="1"
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE76C;"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border
                        Height="1"
                        Margin="16,0"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Button
                        x:Name="OpenLatestWorkspaceButton"
                        Style="{StaticResource SettingsRowButtonStyle}"
                        Click="OnOpenLatestWorkspaceButtonClick"
                        IsEnabled="{x:Bind ViewModel.CanOpenLatestRecentWorkspace, Mode=OneWay}">
                        <Grid
                            Padding="18,14"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="OpenLatestWorkspaceButtonText"
                                VerticalAlignment="Center" />
                            <FontIcon
                                Grid.Column="1"
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE76C;"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid
            Grid.Row="2"
            MinHeight="0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                MinHeight="0"
                Style="{StaticResource SettingsSectionCardStyle}"
                Padding="22,20">
                <Grid
                    MinHeight="0"
                    RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="RecentOpenedTitleText"
                        Style="{ThemeResource TitleTextBlockStyle}" />

                    <ScrollViewer
                        Grid.Row="1"
                        MinHeight="0"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Auto">
                        <StackPanel Spacing="14">
                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.RecentWorkspaceItems, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.RecentWorkspaceListVisibility, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="home:HomeRecentWorkspaceItemViewModel">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button
                                                Padding="0"
                                                Click="OnRecentWorkspaceButtonClick"
                                                IsEnabled="{x:Bind CanOpen}"
                                                Style="{StaticResource SettingsRowButtonStyle}">
                                                <Grid
                                                    Padding="14,12"
                                                    RowSpacing="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind DisplayName}"
                                                            TextTrimming="CharacterEllipsis" />

                                                        <StackPanel
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            Spacing="6">
                                                            <Border
                                                                Style="{StaticResource ExplorerTreeBadgeStyle}"
                                                                Padding="8,3"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind PrimaryBadgeText}" />
                                                            </Border>

                                                            <Border
                                                                Style="{StaticResource ExplorerTreeBadgeStyle}"
                                                                Padding="8,3"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind SecondaryBadgeVisibility}">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind SecondaryBadgeText}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel
                                                        Grid.Row="1"
                                                        Spacing="4">
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind SourceSummary}"
                                                            TextWrapping="WrapWholeWords" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind WorkspaceDataRootSummary}"
                                                            TextWrapping="WrapWholeWords" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind LastActivatedSummary}"
                                                            TextWrapping="WrapWholeWords" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind AvailabilitySummary}"
                                                            TextWrapping="WrapWholeWords"
                                                            Visibility="{x:Bind AvailabilitySummaryVisibility}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <StackPanel
                                                Grid.Column="1"
                                                Spacing="8"
                                                VerticalAlignment="Top">
                                                <Button
                                                    Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnRecentWorkspacePinButtonClick"
                                                    ToolTipService.ToolTip="{x:Bind PinButtonToolTipText}">
                                                    <SymbolIcon Symbol="{x:Bind PinButtonSymbol}" />
                                                </Button>

                                                <Button
                                                    Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnRecentWorkspaceDeleteButtonClick"
                                                    ToolTipService.ToolTip="{Binding RecentWorkspaceDeleteToolTipText, ElementName=RootPage}">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="12"
                                                        Glyph="&#xE74D;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                x:Name="RecentWorkspaceEmptyText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.RecentWorkspaceEmptyStateVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                MinHeight="0"
                Style="{StaticResource SettingsSectionCardStyle}"
                Padding="22,20">
                <Grid
                    MinHeight="0"
                    RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="RecentActivityTitleText"
                        Style="{ThemeResource TitleTextBlockStyle}" />

                    <ScrollViewer
                        Grid.Row="1"
                        MinHeight="0"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Auto">
                        <StackPanel Spacing="14">
                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.RecentActivityItems, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.RecentActivityListVisibility, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="home:HomeRecentActivityItemViewModel">
                                        <Grid
                                            Padding="8,10"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                VerticalAlignment="Top"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Time}" />

                                            <StackPanel
                                                Grid.Column="1"
                                                Spacing="4">
                                                <TextBlock
                                                    Text="{x:Bind Summary}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                x:Name="RecentActivityEmptyText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.RecentActivityEmptyStateVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
